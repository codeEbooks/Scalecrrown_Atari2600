# The sources stay as they are, with LF line ends on every system, so
# that SHA256SUMS.txt and verify.py agree after a checkout; the
# cartridges and the pictures are bytes.
* -text
*.asm text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.lst text eol=lf
*.sym text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
