------- FILE scalecrown.asm
------- FILE knight.asm LEVEL 2 PASS 2
      0  737a					      include	"knight.asm"
      1  737a							; knight.asm - bank 7: Sir Roderick
      2  737a							;
      3  737a							; the button starts a thrust of the sword, during which he
      4  737a							; stands still; otherwise the joystick moves him, first
      5  737a							; left or right, then up or down, each direction tried on
      6  737a							; its own against the walls (so he slides along a wall
      7  737a							; when pushed diagonally into it). Past the edge of the
      8  737a							; screen he goes into the next room: east and west
      9  737a							; through the openings, down and up by the stairs.
     10  737a							; The speeds are in bank7.asm, one table for each
     11  737a							; television (rules.py).
     12  737a
     13  737a				  -	      IF	V_INT != 0
     14  737a				  -	      ERR		; one step at most per frame
     15  737a					      ENDIF
