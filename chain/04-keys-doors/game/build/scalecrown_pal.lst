      0  751f					      include	"hud.asm"
      1  751f							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  751f							;
      3  751f							; Entered right after the WSYNC that ends the VBLANK, at
      4  751f							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  751f							; lines (PAL only), then the HUD:
      6  751f							;   lines 1-9	  the six digits of the score
      7  751f							;   lines 12-15  the energy bar
      8  751f							;   lines 17-25  LEVEL n
      9  751f							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  751f							;		  (player 1: the thing of the room)
     11  751f							; and goes on to bank 0 (room_kernel.asm) in line 28.
     12  751f							;
     13  751f							; Cycle counts in the comments: the cycle at which a store
     14  751f							; writes, counted from 0 at the start of the line.
     15  751f
     16  751f				   hud
     17  751f		       a9 00		      lda	#0
     18  7521		       85 01		      sta	VBLANK	; the picture starts
     19  7523					      IF	TOP_BLANK
