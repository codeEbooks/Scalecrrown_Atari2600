------- FILE things.asm LEVEL 2 PASS 2
      0  4100					      include	"things.asm"
      1  4100							; things.asm - bank 4: the things of the rooms
      2  4100							;
      3  4100							; Called once a frame in the overscan of a game, from bank 7
      4  4100							; through the trampoline TO_THINGS: what
      5  4100							; Sir Roderick's move of this frame did, after the picture
      6  4100							; that showed it.
      7  4100							; - The spikes: the time of the plates. setup_room
      8  4100							;   (main.asm) starts them down when he comes into a room;
      9  4100							;   when they turn, their version of the two courses goes
     10  4100							;   into the Superchip RAM, where the kernel draws the room
     11  4100							;   from.
     12  4100							; - The thing of the room: a chest he touches opens and
     13  4100							;   gives him the key of the level; a door he stands in
     14  4100							;   front of with that key opens (the key is used up), and
     15  4100							;   the open version of the grate goes into the Superchip
     16  4100							;   RAM. Points for both.
     17  4100							; What player 1 shows, the collision map and the key in the
     18  4100							; HUD follow in the next frame (room_state, p1_bands in
     19  4100							; main.asm).
     20  4100							;
     21  4100							; The tables (bank4.asm, from dungeon.py and rules.py): for
     22  4100							; each room its lists of versions, the bit of its thing in
     23  4100							; `opened`, where he touches it, where the plates are.
     24  4100
     25  4100				  -	      IF	CHEST_BCD == 0 || SPK_UP == 0
     26  4100				  -	      ERR		; (the branches below)
     27  4100					      ENDIF
     28  4100
     29  4100				   things
     30  4100				   th_go
     31  4100							; --- the plates: down for the time of the level, up
     32  4100							; for SPK_UP frames
     33  4100		       c6 9e		      dec	spk
     34  4102		       d0 24		      bne	th_hurt
     35  4104		       a4 85		      ldy	room
     36  4106		       a5 9f		      lda	spup	; they turn
     37  4108		       49 01		      eor	#1
     38  410a		       85 9f		      sta	spup
     39  410c		       f0 0b		      beq	th_down
     40  410e		       a9 32		      lda	#SPK_UP
     41  4110		       85 9e		      sta	spk
     42  4112		       be 1c 92 	      ldx	SPU4,y	; the raised version
     43  4115		       d0 0e		      bne	th_turn	; (an empty list is entry 0:
     44  4117		       f0 0f		      beq	th_hurt	; nothing to write)
     45  4119				   th_down
     46  4119		       98		      tya
     47  411a		       4a		      lsr
     48  411b		       4a		      lsr
     49  411c		       aa		      tax		; level - 1
     50  411d		       bd cc 92 	      lda	TH_DOWN,x
     51  4120		       85 9e		      sta	spk
     52  4122		       be 0c 92 	      ldx	SPD4,y	; the lowered version
     53  4125				   th_turn
     54  4125		       20 89 91 	      jsr	put
     55  4128				   th_hurt
     56  4128							; --- the thing of the room, if he touches it
     57  4128				   th_thing
     58  4128		       a6 85		      ldx	room
     59  412a		       bd 3c 92 	      lda	TBIT,x
     60  412d		       f0 4b		      beq	th_done	; nothing here
     61  412f		       25 9d		      and	opened
     62  4131		       d0 47		      bne	th_done	; open already
     63  4133		       a5 8a		      lda	kx
     64  4135		       dd 4c 92 	      cmp	TX0,x
     65  4138		       90 40		      bcc	th_done
     66  413a		       dd 5c 92 	      cmp	TX1,x
     67  413d		       b0 3b		      bcs	th_done
     68  413f		       a5 8b		      lda	ky
     69  4141		       dd 6c 92 	      cmp	TY0,x
     70  4144		       90 34		      bcc	th_done
     71  4146		       dd 7c 92 	      cmp	TY1,x
     72  4149		       b0 2f		      bcs	th_done
     73  414b		       a5 85		      lda	room	; he touches it
     74  414d		       4a		      lsr
     75  414e		       4a		      lsr
     76  414f		       a8		      tay
     77  4150		       c8		      iny		; Y: the level, 1-4
     78  4151		       bd 3c 92 	      lda	TBIT,x
     79  4154		       c9 10		      cmp	#$10
     80  4156		       b0 0a		      bcs	th_door
     81  4158		       05 9d		      ora	opened	; a chest: it opens, he has
     82  415a		       85 9d		      sta	opened	; the key of the level
     83  415c		       84 9c		      sty	key
     84  415e		       a9 05		      lda	#CHEST_BCD
     85  4160		       d0 15		      bne	th_points
     86  4162				   th_door
     87  4162		       c4 9c		      cpy	key	; a door: only with the key
     88  4164		       d0 14		      bne	th_done	; of its level
     89  4166		       05 9d		      ora	opened
     90  4168		       85 9d		      sta	opened
     91  416a		       a9 00		      lda	#0
     92  416c		       85 9c		      sta	key	; the key is used up
     93  416e		       bd 2c 92 	      lda	DOP4,x	; the grate opens (the gate:
     94  4171		       aa		      tax		; an empty list)
     95  4172		       20 89 91 	      jsr	put
     96  4175		       a9 10		      lda	#DOOR_BCD
     97  4177				   th_points
     98  4177		       20 7b 91 	      jsr	points
     99  417a				   th_done
    100  417a		       60	   th_end     rts
    101  417b
    102  417b							; points: A (BCD, hundreds) added to the score. The score
    103  417b							; is BCD; the points go to its middle byte, the carry to
    104  417b							; the first.
    105  417b		       f8	   points     sed
    106  417c		       18		      clc
    107  417d		       65 87		      adc	score+1
    108  417f		       85 87		      sta	score+1
    109  4181		       a5 86		      lda	score
    110  4183		       69 00		      adc	#0
    111  4185		       85 86		      sta	score
    112  4187		       d8		      cld
    113  4188		       60		      rts
    114  4189
    115  4189							; put: a version into the Superchip RAM: the entries of the
    116  4189							; lists VI4 (index) and VV4 (value) from entry X up to the
    117  4189							; index $FF
    118  4189		       bc 98 91    put	      ldy	VI4,x
    119  418c		       30 09		      bmi	pu_done
    120  418e		       bd d2 91 	      lda	VV4,x
    121  4191		       99 00 10 	      sta	SCW,y
    122  4194		       e8		      inx
    123  4195		       d0 f2		      bne	put
    124  4197				   pu_done
    125  4197		       60		      rts
