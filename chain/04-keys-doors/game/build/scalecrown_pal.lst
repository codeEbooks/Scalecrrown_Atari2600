     21  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     22  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     23  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     24  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     25  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     26  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     27  0100				  -	      .byte	$00,$00,$00,$E7,$66,$66,$66,$7E,$3C,$3C,$3E
     28  0100				  -	      .byte	$1E,$9E,$9F,$DE,$7E,$3C,$18,$3C,$7E,$72,$7E
     29  0100				  -	      .byte	$7C,$38,$60,$38,$18,$00,$00,$00,$00,$00,$00
     30  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     31  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     32  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     33  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     34  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     35  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     36  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     37  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     38  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     39  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     40  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     41  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$E1,$C1,$C3
     42  0100				  -	      .byte	$C3,$7E,$3C,$3C,$3E,$1E,$9E,$9F,$DE,$7E,$3C
