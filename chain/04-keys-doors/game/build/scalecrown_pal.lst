     14  0100				  -KFG
     15  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     16  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     17  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     18  0100				  -	      .byte	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
