------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 4 of the chain of the book: keys and doors
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four
      7  8000 ????						; levels (dungeon.py).
      8  8000 ????						; The joystick moves him, the walls stop him, the button
      9  8000 ????						; thrusts the sword; RESET starts again.
     10  8000 ????						; The openings east and west lead to the rooms beside, the
     11  8000 ????						; stairs to the level below and back; the ball closes the
     12  8000 ????						; outer side of the rooms at the ends of a level. The HUD:
     13  8000 ????						; the score, the energy, the name of the level.
     14  8000 ????						; The things: a chest in each level gives the key of the
     15  8000 ????						; level's door (a grate on the stair down; the golden gate
     16  8000 ????						; before the throne room); spikes go up and down in eight
     17  8000 ????						; rooms; points for chests and doors.
     18  8000 ????						;
     19  8000 ????						; Banks (the address of each one for the 6507):
     20  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     21  8000 ????						;   1 ($3000) the title: only its tail before step 8
     22  8000 ????						;   2 ($5000) the throne room: only its tail before
     23  8000 ????						;	       step 6
     24  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     25  8000 ????						;   4 ($9000) the things: chests, doors, spikes
     26  8000 ????						;	       the serpents, the Serpent King
     27  8000 ????						;   5 ($B000) sound: only its tail before step 7
     28  8000 ????						;   6 ($D000) the end screens: only its tail before
     29  8000 ????						;	       step 8
     30  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     31  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     32  8000 ????						; window and ends with the same tail (trampolines, reset).
     33  8000 ????						;
     34  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     35  8000 ????						;	  [-DPAL=1]
     36  8000 ????
     37  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 11	   RESP1      =	$11	; any write: player 1 starts here
     24  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     25  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here
     26  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     27  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1
     28  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     29  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on
     30  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     31  8000 ????	       00 21	   HMP1       =	$21	; fine move of player 1
     32  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     33  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball
     34  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed
     35  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed
     36  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     37  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     38  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves
     39  8000 ????
     40  8000 ????						; TIA, read side
     41  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     42  8000 ????
     43  8000 ????						; RIOT
     44  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     45  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     46  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     47  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     39  8000 ????
     40  8000 ????			  -	      IFNCONST	PAL
     41  8000 ????			  -PAL	      =	0
     42  8000 ????				      ENDIF
     43  8000 ????
     44  8000 ????				      IF	PAL
     45  8000 ????	       00 12	   TOP_BLANK  =	18	; black lines above the HUD
     46  8000 ????	       00 12	   BOT_BLANK  =	18	; and below the room
     47  8000 ????	       00 36	   VBLANK_TIM =	54
     48  8000 ????	       00 2b	   OVER_TIM   =	43
     49  8000 ????			  -	      ELSE
     50  8000 ????			  -TOP_BLANK  =	0
     51  8000 ????			  -BOT_BLANK  =	0
     52  8000 ????			  -VBLANK_TIM =	44
     53  8000 ????			  -OVER_TIM   =	35
     54  8000 ????				      ENDIF
     55  8000 ????
     56  8000 ????						; F4: an access to $1FF4 + n selects bank n
     57  8000 ????	       1f f4	   F4B0       =	$1FF4
     58  8000 ????	       1f f5	   F4B1       =	$1FF5
     59  8000 ????	       1f f6	   F4B2       =	$1FF6
     60  8000 ????	       1f f7	   F4B3       =	$1FF7
     61  8000 ????	       1f f8	   F4B4       =	$1FF8
     62  8000 ????	       1f f9	   F4B5       =	$1FF9
     63  8000 ????	       1f fa	   F4B6       =	$1FFA
     64  8000 ????	       1f fb	   F4B7       =	$1FFB
     65  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     66  8000 ????	       10 00	   SCW	      =	$1000
     67  8000 ????	       10 80	   SCR	      =	$1080
     68  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     69  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     70  8000 ????	       00 28	   SC_PF2     =	40
     71  8000 ????
     72  8000 ????						; trampolines, the same addresses in every bank
     73  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
     74  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
     75  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
     76  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
     77  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
     78  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
     79  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
     80  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
     81  8000 ????
     82  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD
     83  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
     84  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
     85  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
     86  8000 ????	       00 18	   KNIGHT_H   =	24
     87  8000 ????
     88  8000 ????						; ---------------------------------------------------------
     89  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
     90  8000 ????						;
     91  8000 ????						; Every variable has one owner, the part of the program
     92  8000 ????						; that writes it (the others read it); the groups below say
     93  8000 ????						; which.
     94  8000 ????
     95 U00d8 ????				      SEG.U	ram
     96 U0080					      ORG	$80
     97 U0080							; == state (main.asm): frame, screens, buttons, the game
     98 U0080							; == (knight.asm changes room and screen on the way out)
     99 U0080		       00	   frames     ds	1	; frame counter
    100 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
    101 U0082		       00	   shown      ds	1	; the screen set up in the SC
    102 U0083		       00	   held       ds	1	; buttons down a frame ago
    103 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
    104 U0085							; RESET $01
    105 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    106 U0086		       00 00 00    score      ds	3	; BCD, six digits (things.asm
    107 U0089							; adds the points)
    108 U0089		       00	   energy     ds	1	; 0-12: the bar of the HUD
    109 U008a							; == Sir Roderick (knight.asm)
    110 U008a		       00	   kx	      ds	1	; column, 0-149
    111 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    112 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    113 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    114 U008e		       00	   kdist      ds	1	; units walked: pose of the walk
    115 U008f		       00	   hacc       ds	1	; fraction of a step: sideways,
    116 U0090		       00	   vacc       ds	1	; up and down
    117 U0091		       00	   thrust     ds	1	; frames of the thrust still to go
    118 U0092		       00	   moved      ds	1	; he moved in this frame
    119 U0093		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    120 U0094		       00	   swnus      ds	1
    121 U0095		       00	   swres      ds	1
    122 U0096							; == player 1, the plug (main.asm: setup_room,
    123 U0096							; == p1_bands: the thing of band A)
    124 U0096		       00	   ox	      ds	1	; column
    125 U0097		       00	   oy	      ds	1	; top line (odd)
    126 U0098		       00	   odir       ds	1	; 0 right, 8 left (REFP1)
    127 U0099		       00	   okind      ds	1	; first frame in the OG tables
    128 U009a		       00	   onus       ds	1	; NUSIZ1 in the room
    129 U009b		       00	   plug       ds	1	; ENABL in the room: 2 the ball
    130 U009c							; == the things (things.asm; new_game and setup_room
    131 U009c							; == start them)
    132 U009c		       00	   key	      ds	1	; the key he has: its level, 0 none
    133 U009d		       00	   opened     ds	1	; open: chests bits 0-3, doors 4-7
    134 U009e		       00	   spk	      ds	1	; frames left before the plates turn
    135 U009f		       00	   spup       ds	1	; the plates: 0 down, 1 up
    136 U00a0							; == the collision test (knight.asm: box_free, wall)
    137 U00a0		       00 00	   cmap       ds	2	; collision map of the room
    138 U00a2							; (main.asm: room_state)
    139 U00a2		       00	   nx	      ds	1	; the box tried: column, top line
    140 U00a3		       00	   ny	      ds	1
    141 U00a4		       00	   bc0	      ds	1	; its block columns, left, right
    142 U00a5		       00	   bc1	      ds	1
    143 U00a6		       00	   br	      ds	1	; 3 x the block row tested (its
    144 U00a7							; first byte in the map)
    145 U00a7							; == the kernels (main.asm prepares; room_kernel.asm)
    146 U00a7		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    147 U00a9		       00 00	   kcol       ds	2
    148 U00ab		       00 00	   sgfx       ds	2	; player 1: graphics, colours
    149 U00ad		       00 00	   scol       ds	2
    150 U00af		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    151 U00b1		       00 00	   cpf	      ds	2
    152 U00b3		       00	   zbk	      ds	1	; COLUBK of the next line A
    153 U00b4		       00	   zt	      ds	1	; colour for Y at the end of a line
    154 U00b5		       00	   zc1	      ds	1	; COLUP1 of the next line B
    155 U00b6		       00	   idx	      ds	1	; index of the line being prepared
    156 U00b7		       00	   trow       ds	1	; Superchip index of the next course
    157 U00b8		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    158 U00b9		       00	   znpf1      ds	1
    159 U00ba		       00	   znpf2      ds	1
    160 U00bb							; == the HUD (main.asm prepares; hud.asm)
    161 U00bb		       00 00 00 00*dig	      ds	12	; the six columns of digits
    162 U00c7		       00 00 00 00*txp	      ds	12	; and of the name of the level
    163 U00d3		       00	   zt2	      ds	1
    164 U00d4		       00	   bar1       ds	1	; energy bar: PF1, PF2
    165 U00d5		       00	   bar2       ds	1
    166 U00d6							; == scratch (anyone; never kept across a call)
    167 U00d6		       00 00	   tmp	      ds	2
    168 U00d8				   ram_end
    169 U00d8
    170 U00d8							; ---------------------------------------------------------
    171 U00d8							; the banks
    172 U00d8
    173 U00d8					      MAC	bank
    174 U00d8					      SEG	bank{1}
    175 U00d8					      ORG	{1}*$1000
    176 U00d8					      RORG	$1000+{1}*$2000
    177 U00d8					      ds	256, 0	; the Superchip window
    178 U00d8					      ENDM		; {1}: bank number
    179 U00d8
    180 U00d8					      MAC	tail
    181 U00d8					      ORG	{1}*$1000+$FAA
    182 U00d8					      RORG	$1FAA+{1}*$2000
    183 U00d8					      sta	F4B6	; $FAA: to the end screens
    184 U00d8					      jmp	ends_kernel
    185 U00d8					      sta	F4B2	; $FB0: to the throne kernel
    186 U00d8					      jmp	throne_kernel
    187 U00d8					      sta	F4B4	; $FB6: (jsr here) bank 4
    188 U00d8					      jsr	things	; $FB9: in bank 4
    189 U00d8					      sta	F4B7	; $FBC: bank 7 again
    190 U00d8					      rts		; $FBF: in bank 7
    191 U00d8					      sta	F4B0	; $FC0: to the room kernel
    192 U00d8					      jmp	room_kernel
    193 U00d8					      sta	F4B1	; $FC6: to the title kernel
    194 U00d8					      jmp	title_kernel
    195 U00d8					      sta	F4B7	; $FCC: back to the frame
    196 U00d8					      jmp	kernel_done
    197 U00d8					      sta	F4B5	; $FD2: (jsr here) bank 5
    198 U00d8					      jsr	sound	; $FD5: in bank 5
    199 U00d8					      sta	F4B7	; $FD8: bank 7 again
    200 U00d8					      rts		; $FDB: in bank 7
    201 U00d8					      ORG	{1}*$1000+$FE0
    202 U00d8					      RORG	$1FE0+{1}*$2000
    203 U00d8					      sta	F4B7	; $FE0: reset, in any bank
    204 U00d8					      jmp	start
    205 U00d8					      sta	F4B3	; $FE6: (jsr here) bank 3
    206 U00d8					      jsr	room_copy	; $FE9: in bank 3
    207 U00d8					      sta	F4B7	; $FEC: bank 7 again
    208 U00d8					      rts		; $FEF: in bank 7
    209 U00d8					      ORG	{1}*$1000+$FFC
    210 U00d8					      RORG	$1FFC+{1}*$2000
    211 U00d8					      .word	$1FE0+{1}*$2000
    212 U00d8					      .word	$1FE0+{1}*$2000
    213 U00d8					      ENDM		; {1}: bank number
    214 U00d8
    215 U00d8							; A bank whose code comes in a later step has only its
    216 U00d8							; tail, and the routine its trampoline goes to is a stub:
    217 U00d8							; never called before that step.
    218 U00d8
    219 U00d8							; --- bank 0: the room -------------------------------------
      0 U00d8					      BANK	0
      1  1000 ????				      SEG	bank0
      2  0000					      ORG	0*$1000
      3  0000					      RORG	$1000+0*$2000
      4  0000		       00 00 00 00*	      ds	256, 0
------- FILE kfig0.asm LEVEL 2 PASS 2
      0  0100					      include	"kfig0.asm"
      1  0100							; generated by build_assets.py - Sir Roderick for bank 0
