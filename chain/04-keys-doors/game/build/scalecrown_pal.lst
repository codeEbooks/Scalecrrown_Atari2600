     29  7532		       20 b5 f5 	      jsr	hud_digits	; lines 1-9: the six digits
     30  7535		       85 02		      sta	WSYNC	; line 10
     31  7537		       a9 00		      lda	#0
     32  7539		       85 1b		      sta	GRP0
     33  753b		       85 1c		      sta	GRP1
     34  753d		       85 1b		      sta	GRP0	; empty the delayed copies
     35  753f		       a0 03		      ldy	#3
     36  7541		       85 02		      sta	WSYNC	; line 11
     37  7543		       85 02		      sta	WSYNC	; line 12
