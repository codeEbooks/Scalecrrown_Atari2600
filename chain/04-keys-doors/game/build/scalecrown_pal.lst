    102  75b5							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    103  75b5							; columns read through six pointers: {1} ... {1}+10 (dig:
    104  75b5							; the digits of the score; txp: the name of the level, in
    105  75b5							; this bank). Called on the line before the first one.
    106  75b5							; Both players are delayed (VDELP0, VDELP1) and have three
    107  75b5							; copies 16 pixels apart:
    108  75b5							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    109  75b5							; A delayed player shows the value written before the last
    110  75b5							; write to the other player, so the four writes at the end
    111  75b5							; change the copies on the right while the beam is between
    112  75b5							; them.
    113  75b5					      MAC	hud48
    114  75b5					      ldy	#7
    115  75b5					      sty	zt2
    116  75b5				   .loop      lda	({1}),y
    117  75b5					      sta	GRP0	; column 1 (waits)
    118  75b5					      sta	WSYNC
    119  75b5					      lda	({1}+2),y
    120  75b5					      sta	GRP1	;  7 col 2; col 1 shows
    121  75b5					      lda	({1}+4),y
    122  75b5					      sta	GRP0	; 15 col 3; col 2 shows
    123  75b5					      lda	({1}+10),y
    124  75b5					      sta	zt
    125  75b5					      lda	({1}+8),y
    126  75b5					      tax
    127  75b5					      lda	({1}+6),y
    128  75b5					      ldy	zt
    129  75b5					      nop
    130  75b5					      sta	GRP1	; 43 col 4; col 3 shows
    131  75b5					      stx	GRP0	; 46 col 5; col 4 shows
    132  75b5					      sty	GRP1	; 49 col 6; col 5 shows
    133  75b5					      sta	GRP0	; 52 col 6 shows
    134  75b5					      ldy	zt2
    135  75b5					      dey
    136  75b5					      sty	zt2
    137  75b5					      bpl	.loop
    138  75b5					      rts
    139  75b5					      ENDM
    140  75b5
    141  75b5							; each routine in one page (as the blocks of the title: see
    142  75b5							; title_kernel.asm); the padding comes after a jmp or an rts
    143  75b5		       00 32	   HUD48_BYTES =	50
    144  75b5
    145  75b5				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    146  75b5				  -	      ALIGN	256
    147  75b5					      ENDIF
