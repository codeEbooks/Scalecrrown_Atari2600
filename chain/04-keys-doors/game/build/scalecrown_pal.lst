      0  7100					      include	"main.asm"
      1  7100							; main.asm - bank 7: start, the frame, and what is done
      2  7100							; in it besides the kernels:
      3  7100							; - the buttons: RESET starts again;
      4  7100							; - setting a room up: its playfield comes from bank 3
      5  7100							;   into the Superchip RAM;
      6  7100							; - what the kernels need: Sir Roderick, the colours of
      7  7100							;   the room, the HUD, player 1.
      8  7100							; In the overscan the things of the room (bank 4).
      9  7100
     10  7100				   start
     11  7100		       78		      sei
     12  7101		       d8		      cld
     13  7102		       a2 00		      ldx	#0
     14  7104		       8a		      txa
     15  7105		       95 00	   clear      sta	0,x	; TIA and RAM
     16  7107		       ca		      dex
     17  7108		       d0 fb		      bne	clear
     18  710a		       ca		      dex
     19  710b		       9a		      txs		; stack at $FF
     20  710c		       a9 ff		      lda	#$FF
     21  710e		       85 82		      sta	shown	; no room set up yet
     22  7110		       20 7b f1 	      jsr	new_game	; the game at once
     23  7113		       4c 21 f1 	      jmp	main
     24  7116
     25  7116				   kernel_done		; back from a kernel (the
