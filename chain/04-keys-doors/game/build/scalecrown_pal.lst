------- FILE scalecrown.asm
------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  04ba					      include	"room_kernel.asm"
      1  04ba							; room_kernel.asm - bank 0: the room
      2  04ba							;
      3  04ba							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  04ba							; when the players have their columns for the room. Lines
      5  04ba							; 29-31 of the HUD (black) switch the ball on if the room
      6  04ba							; has a plug (it closes the outer opening of the rooms at
      7  04ba							; the ends of a level; the ball has the colour of the
      8  04ba							; playfield, the wall's) and read what the first line of
      9  04ba							; the room needs; then the 160 lines of the room,
     10  04ba							; BOT_BLANK
     11  04ba							; black lines (PAL only); then the overscan starts and the
     12  04ba							; program goes back to bank 7.
     13  04ba							;
     14  04ba							; Cycle counts in the comments: the cycle at which a store
     15  04ba							; writes, counted from 0 at the start of the line; a "+" is
     16  04ba							; a load that can take one cycle more when its address
     17  04ba							; crosses a page.
     18  04ba
     19  04ba				   room_kernel
     20  04ba		       85 02		      sta	WSYNC	; HUD line 29
     21  04bc		       a5 9b		      lda	plug	; the ball: black on black
     22  04be		       85 1f		      sta	ENABL	; until the room starts
     23  04c0		       a0 9f		      ldy	#159	; what line A0 of course 0
     24  04c2		       84 b6		      sty	idx	; needs
     25  04c4		       a9 13		      lda	#19
     26  04c6		       85 b7		      sta	trow
     27  04c8		       b1 af		      lda	(cbk),y	; +
     28  04ca		       85 b3		      sta	zbk	; COLUBK of pair 0
     29  04cc		       b1 b1		      lda	(cpf),y	; +
     30  04ce		       85 b4		      sta	zt	; COLUPF of pair 0
     31  04d0		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     32  04d3		       85 b8		      sta	znpf0
     33  04d5		       ad a7 10 	      lda	SCR+SC_PF1+19
     34  04d8		       85 b9		      sta	znpf1
     35  04da		       ad bb 10 	      lda	SCR+SC_PF2+19
     36  04dd		       85 0f		      sta	PF2	; unseen: COLUPF is 0
     37  04df		       85 02		      sta	WSYNC	; line 30
     38  04e1		       b1 a7		      lda	(kgfx),y	; +
     39  04e3		       aa		      tax
     40  04e4		       b1 ab		      lda	(sgfx),y	; +
     41  04e6		       a4 b4		      ldy	zt
     42  04e8		       85 02		      sta	WSYNC	; line 31 stays empty
     43  04ea		       4c ed 14 	      jmp	k_top
     44  04ed
     45  04ed							; ---------------------------------------------------------
     46  04ed							; The room: 20 courses of 8 lines, each four pairs of lines
     47  04ed							; A and B. Lines A write the playfield colours, lines B the
     48  04ed							; colours of the figures; both write the two figures.
     49  04ed							;
     50  04ed							; At the start of each line (after WSYNC) the registers hold
     51  04ed							; what the line writes first:
     52  04ed							;   line A: A = GRP1, X = GRP0, Y = COLUPF
     53  04ed							;   line B: A = GRP1, X = GRP0, Y = COLUP0
     54  04ed							; The rest of the line prepares the next one; idx is the
     55  04ed							; index (159 at the top) of the line being prepared.
     56  04ed							; The playfield changes once a course: A1, A2, A3 read the
     57  04ed							; next course from the Superchip RAM, A0 writes PF0 and
     58  04ed							; PF1, the end of B3 writes PF2 (after the right half is
     59  04ed							; drawn).
     60  04ed							; Lines B also write the colour of Sir Roderick to ENAM0:
     61  04ed							; bit 1 of it turns the blade (missile 0) on or off. Only in
     62  04ed							; the thrust can it show: otherwise RESMP0 keeps it hidden,
     63  04ed							; and in the thrust the colours are zero outside the figure
     64  04ed							; and have bit 1 only on the pair of the blade (art.py).
     65  04ed
     66  04ed					      MAC	line_a_rest
     67  04ed					      ldy	idx
     68  04ed					      dey
     69  04ed					      sty	idx
     70  04ed					      lda	(kcol),y	; +
     71  04ed					      sta	zt
     72  04ed					      lda	(scol),y	; +
     73  04ed					      sta	zc1
     74  04ed					      lda	(kgfx),y	; +
     75  04ed					      tax
     76  04ed					      lda	(sgfx),y	; +
     77  04ed					      ldy	zt
     78  04ed					      ENDM		; prepares line B
     79  04ed
     80  04ed					      MAC	line_b_first
     81  04ed					      sta	GRP1	;  2
     82  04ed					      stx	GRP0	;  5
     83  04ed					      sty	COLUP0	;  8
     84  04ed					      sty	ENAM0	; 11 the blade: bit 1
     85  04ed					      lda	zc1
     86  04ed					      sta	COLUP1	; 17
     87  04ed					      ldy	idx
     88  04ed					      dey
     89  04ed					      sty	idx
     90  04ed					      ENDM
     91  04ed
     92  04ed					      MAC	line_b_rest
     93  04ed					      lda	(cbk),y	; +
     94  04ed					      sta	zbk
     95  04ed					      lda	(cpf),y	; +
     96  04ed					      sta	zt
     97  04ed					      lda	(kgfx),y	; +
     98  04ed					      tax
     99  04ed					      lda	(sgfx),y	; +
    100  04ed					      ldy	zt
    101  04ed					      ENDM		; prepares line A
    102  04ed
    103  04ed					      MAC	line_a_first
    104  04ed					      sta	GRP1	;  2
