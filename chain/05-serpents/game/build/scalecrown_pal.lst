------- FILE scalecrown.asm
------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  04d2					      include	"room_kernel.asm"
      1  04d2							; room_kernel.asm - bank 0: the room
      2  04d2							;
      3  04d2							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  04d2							; when the players have their columns for the room. Lines
      5  04d2							; 29-31 of the HUD (black) switch the ball on if the room
      6  04d2							; has a plug (it closes the outer opening of the rooms at
      7  04d2							; the ends of a level; the ball has the colour of the
      8  04d2							; playfield, the wall's) and read what the first line of
      9  04d2							; the room needs; then the 160 lines of the room,
     10  04d2							; BOT_BLANK
     11  04d2							; black lines (PAL only); then the overscan starts and the
     12  04d2							; program goes back to bank 7.
     13  04d2							;
     14  04d2							; Cycle counts in the comments: the cycle at which a store
     15  04d2							; writes, counted from 0 at the start of the line; a "+" is
     16  04d2							; a load that can take one cycle more when its address
     17  04d2							; crosses a page.
     18  04d2
     19  04d2				   room_kernel
     20  04d2		       85 02		      sta	WSYNC	; HUD line 29
     21  04d4		       a5 9b		      lda	plug	; the ball: black on black
     22  04d6		       85 1f		      sta	ENABL	; until the room starts
     23  04d8		       a0 9f		      ldy	#159	; what line A0 of course 0
     24  04da		       84 bf		      sty	idx	; needs
     25  04dc		       a9 13		      lda	#19
     26  04de		       85 c0		      sta	trow
     27  04e0		       b1 b8		      lda	(cbk),y	; +
     28  04e2		       85 bc		      sta	zbk	; COLUBK of pair 0
     29  04e4		       b1 ba		      lda	(cpf),y	; +
     30  04e6		       85 bd		      sta	zt	; COLUPF of pair 0
     31  04e8		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     32  04eb		       85 c1		      sta	znpf0
     33  04ed		       ad a7 10 	      lda	SCR+SC_PF1+19
     34  04f0		       85 c2		      sta	znpf1
     35  04f2		       ad bb 10 	      lda	SCR+SC_PF2+19
     36  04f5		       85 0f		      sta	PF2	; unseen: COLUPF is 0
     37  04f7		       85 02		      sta	WSYNC	; line 30
     38  04f9		       b1 b0		      lda	(kgfx),y	; +
     39  04fb		       aa		      tax
     40  04fc		       b1 b4		      lda	(sgfx),y	; +
     41  04fe		       a4 bd		      ldy	zt
     42  0500		       85 02		      sta	WSYNC	; line 31 stays empty
     43  0502		       4c 05 15 	      jmp	k_top
     44  0505
     45  0505							; ---------------------------------------------------------
     46  0505							; The room: 20 courses of 8 lines, each four pairs of lines
     47  0505							; A and B. Lines A write the playfield colours, lines B the
     48  0505							; colours of the figures; both write the two figures.
     49  0505							;
     50  0505							; At the start of each line (after WSYNC) the registers hold
     51  0505							; what the line writes first:
     52  0505							;   line A: A = GRP1, X = GRP0, Y = COLUPF
     53  0505							;   line B: A = GRP1, X = GRP0, Y = COLUP0
     54  0505							; The rest of the line prepares the next one; idx is the
     55  0505							; index (159 at the top) of the line being prepared.
     56  0505							; The playfield changes once a course: A1, A2, A3 read the
     57  0505							; next course from the Superchip RAM, A0 writes PF0 and
     58  0505							; PF1, the end of B3 writes PF2 (after the right half is
     59  0505							; drawn).
     60  0505							; Lines B also write the colour of Sir Roderick to ENAM0:
     61  0505							; bit 1 of it turns the blade (missile 0) on or off. Only in
     62  0505							; the thrust can it show: otherwise RESMP0 keeps it hidden,
     63  0505							; and in the thrust the colours are zero outside the figure
     64  0505							; and have bit 1 only on the pair of the blade (art.py).
     65  0505
     66  0505					      MAC	line_a_rest
     67  0505					      ldy	idx
     68  0505					      dey
     69  0505					      sty	idx
     70  0505					      lda	(kcol),y	; +
     71  0505					      sta	zt
     72  0505					      lda	(scol),y	; +
     73  0505					      sta	zc1
     74  0505					      lda	(kgfx),y	; +
     75  0505					      tax
     76  0505					      lda	(sgfx),y	; +
     77  0505					      ldy	zt
     78  0505					      ENDM		; prepares line B
     79  0505
     80  0505					      MAC	line_b_first
     81  0505					      sta	GRP1	;  2
     82  0505					      stx	GRP0	;  5
     83  0505					      sty	COLUP0	;  8
     84  0505					      sty	ENAM0	; 11 the blade: bit 1
     85  0505					      lda	zc1
     86  0505					      sta	COLUP1	; 17
     87  0505					      ldy	idx
     88  0505					      dey
     89  0505					      sty	idx
     90  0505					      ENDM
     91  0505
