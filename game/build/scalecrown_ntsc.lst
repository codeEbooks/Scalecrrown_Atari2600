    114  517d		       ca		      dex
    115  517e		       10 f4		      bpl	mu_next
    116  5180				   mu_frame
    117  5180		       c6 ae		      dec	mclock	; 0: a step's last frame
    118  5182		       a2 01		      ldx	#1
    119  5184		       a9 00	   mu_vol     lda	#0
    120  5186		       b4 b8		      ldy	vnote,x
    121  5188		       f0 20		      beq	mu_set	; a rest
    122  518a		       b4 b2		      ldy	vleft,x
    123  518c		       d0 04		      bne	mu_on
    124  518e		       a4 ae		      ldy	mclock
    125  5190		       f0 18		      beq	mu_set	; the last frame of the note
    126  5192		       b4 b6	   mu_on      ldy	vins,x
    127  5194		       b5 b4		      lda	venv,x
    128  5196		       d9 01 b4 	      cmp	ENV_LAST,y	; the envelope goes on until
    129  5199		       b0 04		      bcs	mu_hold	; its last value
    130  519b		       f6 b4		      inc	venv,x
    131  519d		       90 03		      bcc	mu_read	; (inc leaves C clear)
    132  519f				   mu_hold
    133  519f		       b9 01 b4 	      lda	ENV_LAST,y
    134  51a2				   mu_read
