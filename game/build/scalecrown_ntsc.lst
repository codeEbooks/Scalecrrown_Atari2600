------- FILE things.asm LEVEL 2 PASS 2
      0  4100					      include	"things.asm"	; {4}
      1  4100							; things.asm - bank 4: the things of the rooms, the guards {5}
      2  4100							; and the Serpent King {6}
      3  4100							;|; and the serpents {5-5}
      4  4100							;|; things.asm - bank 4: the things of the rooms {4-4}
      5  4100							;
      6  4100							; Called once a frame in the overscan of a game, from bank 7
      7  4100							; through the trampoline TO_THINGS, before the sound: what {7}
      8  4100							;|; through the trampoline TO_THINGS: what {4-6}
      9  4100							; Sir Roderick's move of this frame did, after the picture
     10  4100							; that showed it.
     11  4100							; - The spikes: the time of the plates. setup_room
     12  4100							;   (main.asm) starts them down when he comes into a room;
     13  4100							;   when they turn, their version of the two courses goes
     14  4100							;   into the Superchip RAM, where the kernel draws the room
     15  4100							;   from.
     16  4100							; - The hurt: on a raised plate he loses SPIKE_DAMAGE units {5}
     17  4100							;   of energy, again every HURT_FRAMES while he stays on {5}
     18  4100							;   it. While the count of a wound goes down (after the {5}
     19  4100							;   spikes or a bite) nothing hurts him, and he flashes. {5}
     20  4100							; - The guards, each one alive: the blade of a thrust {5}
     21  4100							;   wounds a serpent it touches: the first blow pushes it {9}
     22  4100							;   back and stuns it, the second kills it (SERPENT_BCD {9}
     23  4100							;   points); {9}
     24  4100							;|;   kills a serpent it touches (SERPENT_BCD points); {5-8}
     25  4100							;   a serpent whose box touches his bites (BITE_DAMAGE, {5}
     26  4100							;   then BITE_FRAMES without wounds); then they crawl {5}
     27  4100							;   along their paths, turning at the ends, at the speed of {5}
     28  4100							;   the room (a fraction of a pixel a frame), or chase him {9}
     29  4100							;   with a sprint. A dead one comes back after {9}
     30  4100							;   RESPAWN_FRAMES. {9}
     31  4100							;|;   the room (a fraction of a pixel a frame). {5-8}
     32  4100							;   The column of the first guard, for the seam of the {5}
     33  4100							;   next frame (zcoarse, SC_HM). {5}
     34  4100							; - The thing of the room: a chest he touches opens and
     35  4100							;   gives him the key of the level; a door he stands in
     36  4100							;   front of with that key opens (the key is used up), and
     37  4100							;   the open version of the grate goes into the Superchip
     38  4100							;   RAM. Points for both, and their sound in the SOUND FX {7}
     39  4100							;   mode. {7}
     40  4100							;|;   RAM. Points for both. {4-6}
     41  4100							; - The throne room, in place of the guards: the Serpent {6}
     42  4100							;   King (throne, below) or the crown. {6}
     43  4100							;|; - The throne room has nothing (the King: step 6). {5-5}
     44  4100							; - GAME OVER: energy 0. From then on nothing here; nor {6}
     45  4100							;   after VICTORY. {6}
     46  4100							;|; - GAME OVER: energy 0. From then on nothing here. {5-5}
     47  4100							; What player 1 shows, the collision map and the key in the
     48  4100							; HUD follow in the next frame (room_state, p1_bands in
     49  4100							; main.asm).
     50  4100							;
     51  4100							; The tables (bank4.asm, from dungeon.py and rules.py): for
     52  4100							; each room its lists of versions, the bit of its thing in
     53  4100							; `opened`, where he touches it, where the plates are; {5}
     54  4100							; its guards (32 entries: r the first, 16 + r the second). {5}
     55  4100							;|; `opened`, where he touches it, where the plates are. {4-4}
     56  4100
     57  4100				  -	      IF	CHEST_BCD == 0 || SPK_UP == 0
     58  4100				  -	      ERR		; (the branches below)
     59  4100					      ENDIF
