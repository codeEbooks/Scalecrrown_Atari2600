      0  5100					      include	"sound.asm"	; {7}
      1  5100							; sound.asm - bank 5: the sound player
      2  5100							;
      3  5100							; Called once a frame in the overscan, from bank 7 through
      4  5100							; the trampoline TO_SOUND (in the tail of every bank).
      5  5100							; Three modes, chosen with SELECT on the title (main.asm): {8}
      6  5100							;|; Three modes, chosen with SELECT (main.asm): {7-7}
      7  5100							;   0 MUSIC	 the theme on both voices (voice 0 the bass,
      8  5100							;		 voice 1 the melody), no effects
      9  5100							;   1 SOUND FX  the effects on voice 0, voice 1 silent
     10  5100							;   2 SILENT	 nothing
     11  5100							; When the mode changes both voices are silenced, any effect
     12  5100							; stops and the music starts again from its first step.
     13  5100							;
     14  5100							; The songs: the theme (the title and the game), the {8}
     15  5100							; lament of GAME OVER and the fanfare of VICTORY; song is {8}
     16  5100							; 2 x the one playing. To start a song the game writes it {8}
     17  5100							; in song and $FF in smode: the player sees a new mode and {8}
     18  5100							; does as above (the silence after an end and after a {8}
     19  5100							; restart: no note of what was playing goes on). The two {8}
     20  5100							; songs of the end play once: each voice ends with a rest {8}
     21  5100							; that loops on itself. {8}
     22  5100							;|; The song: the theme; song is 2 x the one playing. To {7-7}
     23  5100							;|; start it the game writes it in song and $FF in smode {7-7}
     24  5100							;|; (RESET): the player sees a new mode and does as above. {7-7}
     25  5100							;
     26  5100							; The music (music.py makes the tables from score.py): each
     27  5100							; voice reads a stream of bytes: $FE n chooses instrument
     28  5100							; n; a note (index in NOTE_C / NOTE_F, 0 is a rest) and its
     29  5100							; length in steps; $FF goes back to the voice's loop point.
     30  5100							; A step is a sixteenth note: STEPLEN frames (NTSC 9; PAL 8
     31  5100							; and 7 in turn). The volume of a note follows its
     32  5100							; instrument's envelope, one value a frame (the last holds);
     33  5100							; the last frame of every note is silent.
     34  5100							;
     35  5100							; The effects (sfx.py): AUDC, AUDF, AUDV of each frame in
     36  5100							; three tables, an AUDC of $FF at the end. The game
     37  5100							; asks for one with sfxreq; sfxi is the frame playing.
     38  5100
     39  5100				   sound
     40  5100		       a5 a9		      lda	mode
     41  5102		       c5 aa		      cmp	smode
     42  5104		       f0 16		      beq	so_mode
     43  5106		       85 aa		      sta	smode	; a new mode: silence, the
     44  5108		       a2 00		      ldx	#0	; music from the start, no
     45  510a		       86 19		      stx	AUDV0	; effect
     46  510c		       86 1a		      stx	AUDV1
     47  510e		       86 ad		      stx	sfxi
     48  5110		       86 ae		      stx	mclock
     49  5112		       86 af		      stx	mstep
     50  5114		       86 b0		      stx	vpos
     51  5116		       86 b1		      stx	vpos+1
     52  5118		       86 b2		      stx	vleft
     53  511a		       86 b3		      stx	vleft+1
     54  511c				   so_mode
     55  511c		       a5 a9		      lda	mode
     56  511e		       f0 3a		      beq	music
     57  5120		       c9 01		      cmp	#1
     58  5122		       f0 09		      beq	effects
     59  5124		       a9 00		      lda	#0	; SILENT
     60  5126		       85 19		      sta	AUDV0
     61  5128		       85 1a		      sta	AUDV1
     62  512a		       85 ac		      sta	sfxreq
     63  512c		       60		      rts
     64  512d
     65  512d							; --- SOUND FX ---------------------------------------------
     66  512d
     67  512d				   effects
     68  512d		       a9 00		      lda	#0
     69  512f		       85 1a		      sta	AUDV1	; voice 1 rests
     70  5131		       a6 ac		      ldx	sfxreq
     71  5133		       f0 07		      beq	ef_play
     72  5135		       85 ac		      sta	sfxreq	; (A is 0)
     73  5137		       bd 10 b4 	      lda	SFX_START-1,x	; a new effect, at its start
     74  513a		       85 ad		      sta	sfxi
     75  513c				   ef_play
     76  513c		       a4 ad		      ldy	sfxi
     77  513e		       b9 1e b4 	      lda	SFX_C,y	; AUDC, or $FF at the end
     78  5141		       30 10		      bmi	ef_end
     79  5143		       85 15		      sta	AUDC0
     80  5145		       b9 0a b5 	      lda	SFX_F,y
     81  5148		       85 17		      sta	AUDF0
     82  514a		       b9 f6 b5 	      lda	SFX_V,y
     83  514d		       85 19		      sta	AUDV0
     84  514f		       c8		      iny
     85  5150		       84 ad		      sty	sfxi
     86  5152		       60		      rts
     87  5153		       a9 00	   ef_end     lda	#0
     88  5155		       85 19		      sta	AUDV0
     89  5157		       85 ad		      sta	sfxi	; frame 0: the empty effect
     90  5159		       60		      rts
     91  515a
     92  515a							; --- MUSIC ------------------------------------------------
     93  515a
     94  515a				   music
     95  515a		       a9 00		      lda	#0
     96  515c		       85 ac		      sta	sfxreq	; no effects in this mode
     97  515e		       a5 ae		      lda	mclock
     98  5160		       d0 1e		      bne	mu_frame
     99  5162		       a6 af		      ldx	mstep	; a new step
    100  5164		       bd fe b3 	      lda	STEPLEN,x
    101  5167		       85 ae		      sta	mclock
    102  5169		       e8		      inx
    103  516a		       e0 01		      cpx	#STEPS_N
    104  516c		       90 02		      bcc	mu_step
    105  516e		       a2 00		      ldx	#0
    106  5170				   mu_step
    107  5170		       86 af		      stx	mstep
    108  5172		       a2 01		      ldx	#1
    109  5174				   mu_next
    110  5174		       b5 b2		      lda	vleft,x	; voice X: its note over,
    111  5176		       d0 03		      bne	mu_dec	; the next one
    112  5178		       20 b0 b1 	      jsr	fetch
