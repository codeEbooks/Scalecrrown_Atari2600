    296 U00f4							; the banks
    297 U00f4
    298 U00f4					      MAC	bank
    299 U00f4					      SEG	bank{1}
    300 U00f4					      ORG	{1}*$1000
    301 U00f4					      RORG	$1000+{1}*$2000
    302 U00f4					      ds	256, 0	; the Superchip window
    303 U00f4					      ENDM		; {1}: bank number
    304 U00f4
    305 U00f4					      MAC	tail
    306 U00f4					      ORG	{1}*$1000+$FAA
    307 U00f4					      RORG	$1FAA+{1}*$2000
    308 U00f4					      sta	F4B6	; $FAA: to the end screens
    309 U00f4					      jmp	ends_kernel
    310 U00f4					      sta	F4B2	; $FB0: to the throne kernel
    311 U00f4					      jmp	throne_kernel
    312 U00f4					      sta	F4B4	; $FB6: (jsr here) bank 4
    313 U00f4					      jsr	things	; $FB9: in bank 4
    314 U00f4					      sta	F4B7	; $FBC: bank 7 again
    315 U00f4					      rts		; $FBF: in bank 7
    316 U00f4					      sta	F4B0	; $FC0: to the room kernel
    317 U00f4					      jmp	room_kernel
    318 U00f4					      sta	F4B1	; $FC6: to the title kernel
    319 U00f4					      jmp	title_kernel
    320 U00f4					      sta	F4B7	; $FCC: back to the frame
    321 U00f4					      jmp	kernel_done
    322 U00f4					      sta	F4B5	; $FD2: (jsr here) bank 5
    323 U00f4					      jsr	sound	; $FD5: in bank 5
    324 U00f4					      sta	F4B7	; $FD8: bank 7 again
    325 U00f4					      rts		; $FDB: in bank 7
    326 U00f4					      ORG	{1}*$1000+$FE0
    327 U00f4					      RORG	$1FE0+{1}*$2000
    328 U00f4					      sta	F4B7	; $FE0: reset, in any bank
    329 U00f4					      jmp	start
    330 U00f4					      sta	F4B3	; $FE6: (jsr here) bank 3
    331 U00f4					      jsr	room_copy	; $FE9: in bank 3
    332 U00f4					      sta	F4B7	; $FEC: bank 7 again
    333 U00f4					      rts		; $FEF: in bank 7
    334 U00f4					      ORG	{1}*$1000+$FFC
    335 U00f4					      RORG	$1FFC+{1}*$2000
    336 U00f4					      .word	$1FE0+{1}*$2000
    337 U00f4					      .word	$1FE0+{1}*$2000
    338 U00f4					      ENDM		; {1}: bank number
    339 U00f4
    340 U00f4							;|; A bank whose code comes in a later step has only its {1-7}
    341 U00f4							;|; tail, and the routine its trampoline goes to is a stub: {1-7}
    342 U00f4							;|; never called before that step. {1-7}
    343 U00f4
