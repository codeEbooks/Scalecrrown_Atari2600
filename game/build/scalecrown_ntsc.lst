------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  0589					      include	"room_kernel.asm"
      1  0589							; room_kernel.asm - bank 0: the room
      2  0589							;
      3  0589							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  0589							; when the players have their columns for the room. Lines {4}
      5  0589							;|; when Sir Roderick has his column for the room. Lines {1-3}
      6  0589							; 29-31 of the HUD (black) switch the ball on if the room {3}
      7  0589							; has a plug (it closes the outer opening of the rooms at {3}
      8  0589							; the ends of a level; the ball has the colour of the {3}
      9  0589							; playfield, the wall's) and read what the first line of {3}
     10  0589							; the room needs; then the 160 lines of the room, {3}
     11  0589							; BOT_BLANK {3}
     12  0589							;|; 29-31 of the HUD (black) read what the first line of the {1-2}
     13  0589							;|; room needs; then the 160 lines of the room, BOT_BLANK {1-2}
     14  0589							; black lines (PAL only); then the overscan starts and the
     15  0589							; program goes back to bank 7.
     16  0589							;
     17  0589							; Cycle counts in the comments: the cycle at which a store
     18  0589							; writes, counted from 0 at the start of the line; a "+" is
     19  0589							; a load that can take one cycle more when its address
     20  0589							; crosses a page.
     21  0589
     22  0589				   room_kernel
     23  0589		       85 02		      sta	WSYNC	; HUD line 29
     24  058b		       a5 9c		      lda	plug	; the ball: black on black {3}
     25  058d		       85 1f		      sta	ENABL	; until the room starts {3}
     26  058f		       a0 9f		      ldy	#159	; what line A0 of course 0
     27  0591		       84 d2		      sty	idx	; needs
     28  0593		       a9 13		      lda	#19
     29  0595		       85 d3		      sta	trow
     30  0597		       b1 cb		      lda	(cbk),y	; +
     31  0599		       85 cf		      sta	zbk	; COLUBK of pair 0
     32  059b		       b1 cd		      lda	(cpf),y	; +
     33  059d		       85 d0		      sta	zt	; COLUPF of pair 0
     34  059f		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     35  05a2		       85 d4		      sta	znpf0
     36  05a4		       ad a7 10 	      lda	SCR+SC_PF1+19
     37  05a7		       85 d5		      sta	znpf1
     38  05a9		       ad bb 10 	      lda	SCR+SC_PF2+19
     39  05ac		       85 0f		      sta	PF2	; unseen: COLUPF is 0 {4}
     40  05ae							;|	   sta	   znpf2	   ; for line A0 {1-3}
     41  05ae		       85 02		      sta	WSYNC	; line 30
     42  05b0		       b1 c3		      lda	(kgfx),y	; +
     43  05b2		       aa		      tax
     44  05b3		       b1 c7		      lda	(sgfx),y	; + {4}
     45  05b5		       a4 d0		      ldy	zt
     46  05b7		       85 02		      sta	WSYNC	; line 31 stays empty
     47  05b9		       4c bc 15 	      jmp	k_top
     48  05bc
     49  05bc							; ---------------------------------------------------------
     50  05bc							; The room: 20 courses of 8 lines, each four pairs of lines
     51  05bc							; A and B. Lines A write the playfield colours, lines B the
     52  05bc							; colours of the figures; both write the two figures. {4}
     53  05bc							;|; colour of Sir Roderick; both write his figure. {1-3}
     54  05bc							;
     55  05bc							; At the start of each line (after WSYNC) the registers hold
     56  05bc							; what the line writes first:
     57  05bc							;   line A: A = GRP1, X = GRP0, Y = COLUPF {4}
     58  05bc							;   line B: A = GRP1, X = GRP0, Y = COLUP0 {4}
     59  05bc							;|;   line A: X = GRP0, Y = COLUPF {1-3}
     60  05bc							;|;   line B: X = GRP0, Y = COLUP0 {1-3}
     61  05bc							; The rest of the line prepares the next one; idx is the
     62  05bc							; index (159 at the top) of the line being prepared.
     63  05bc							; The playfield changes once a course: A1, A2, A3 read the
     64  05bc							; next course from the Superchip RAM, A0 writes PF0 and {4}
     65  05bc							; PF1, the end of B3 writes PF2 (after the right half is {4}
     66  05bc							; drawn). {4}
     67  05bc							;|; next course from the Superchip RAM, A0 writes PF0, PF1 {1-3}
     68  05bc							;|; and PF2. {1-3}
     69  05bc							; Lines B also write the colour of Sir Roderick to ENAM0: {2}
     70  05bc							; bit 1 of it turns the blade (missile 0) on or off. Only in {2}
     71  05bc							; the thrust can it show: otherwise RESMP0 keeps it hidden, {2}
     72  05bc							; and in the thrust the colours are zero outside the figure {2}
     73  05bc							; and have bit 1 only on the pair of the blade (art.py). {2}
     74  05bc
     75  05bc					      MAC	line_a_rest
     76  05bc					      ldy	idx
     77  05bc					      dey
     78  05bc					      sty	idx
     79  05bc					      lda	(kcol),y	; +
     80  05bc					      sta	zt
     81  05bc					      lda	(scol),y	; + {4}
     82  05bc					      sta	zc1	; {4}
     83  05bc					      lda	(kgfx),y	; +
     84  05bc					      tax
     85  05bc					      lda	(sgfx),y	; + {4}
     86  05bc					      ldy	zt
     87  05bc					      ENDM		; prepares line B
     88  05bc
     89  05bc					      MAC	line_b_first
     90  05bc					      sta	GRP1	;  2 {4}
     91  05bc					      stx	GRP0	;  5 {4}
     92  05bc							;|	   stx	   GRP0 	   ;  2 {1-3}
     93  05bc					      sty	COLUP0	;  8 {4}
     94  05bc							;|	   sty	   COLUP0	   ;  5 {1-3}
     95  05bc					      sty	ENAM0	; 11 the blade: bit 1 {4}
     96  05bc							;|	   sty	   ENAM0	   ;  8 the blade: bit 1 {2-3}
     97  05bc					      lda	zc1	; {4}
     98  05bc					      sta	COLUP1	; 17 {4}
     99  05bc					      ldy	idx
    100  05bc					      dey
    101  05bc					      sty	idx
    102  05bc					      ENDM
    103  05bc
    104  05bc					      MAC	line_b_rest
    105  05bc					      lda	(cbk),y	; +
    106  05bc					      sta	zbk
    107  05bc					      lda	(cpf),y	; +
    108  05bc					      sta	zt
    109  05bc					      lda	(kgfx),y	; +
    110  05bc					      tax
    111  05bc					      lda	(sgfx),y	; + {4}
    112  05bc					      ldy	zt
    113  05bc					      ENDM		; prepares line A
    114  05bc
    115  05bc					      MAC	line_a_first
    116  05bc					      sta	GRP1	;  2 {4}
    117  05bc					      stx	GRP0	;  5 {4}
    118  05bc							;|	   stx	   GRP0 	   ;  2 {1-3}
    119  05bc					      sty	COLUPF	;  8 {4}
    120  05bc							;|	   sty	   COLUPF	   ;  5 {1-3}
    121  05bc					      lda	zbk
    122  05bc					      sta	COLUBK	; 14 {4}
    123  05bc							;|	   sta	   COLUBK	   ; 11 {1-3}
    124  05bc					      ldx	trow
    125  05bc					      lda	SCR+{1},x
    126  05bc					      ENDM		; A1-A3: {1} = SC table
    127  05bc
    128  05bc		       85 02	   k_top      sta	WSYNC
    129  05be		       85 1c	   k_a0       sta	GRP1	;  2 {4}
    130  05c0							;|k_a0:   stx	   GRP0 	   ;  2 {1-3}
    131  05c0		       86 1b		      stx	GRP0	;  5 {4}
    132  05c2		       84 08		      sty	COLUPF	;  8 {4}
    133  05c4							;|	   sty	   COLUPF	   ;  5 {1-3}
    134  05c4		       a5 cf		      lda	zbk
    135  05c6		       85 09		      sta	COLUBK	; 14 {4}
    136  05c8							;|	   sta	   COLUBK	   ; 11 {1-3}
    137  05c8		       a5 d4		      lda	znpf0
    138  05ca		       85 0d		      sta	PF0	; 20 {4}
    139  05cc							;|	   sta	   PF0		   ; 17 {1-3}
    140  05cc		       a5 d5		      lda	znpf1
    141  05ce		       85 0e		      sta	PF1	; 26 {4}
    142  05d0							;|	   sta	   PF1		   ; 23 {1-3}
    143  05d0							;|	   lda	   znpf2 {1-3}
    144  05d0							;|	   sta	   PF2		   ; 29 {1-3}
