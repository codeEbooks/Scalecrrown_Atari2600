    110  8000 ????	       00 23	   OVER_TIM   =	35
    111  8000 ????				      ENDIF
    112  8000 ????
    113  8000 ????						; F4: an access to $1FF4 + n selects bank n
    114  8000 ????	       1f f4	   F4B0       =	$1FF4
    115  8000 ????	       1f f5	   F4B1       =	$1FF5
    116  8000 ????	       1f f6	   F4B2       =	$1FF6
    117  8000 ????	       1f f7	   F4B3       =	$1FF7
    118  8000 ????	       1f f8	   F4B4       =	$1FF8
    119  8000 ????	       1f f9	   F4B5       =	$1FF9
    120  8000 ????	       1f fa	   F4B6       =	$1FFA
    121  8000 ????	       1f fb	   F4B7       =	$1FFB
    122  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
    123  8000 ????	       10 00	   SCW	      =	$1000
    124  8000 ????	       10 80	   SCR	      =	$1080
    125  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
    126  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
    127  8000 ????	       00 28	   SC_PF2     =	40
    128  8000 ????	       00 3c	   SC_SX      =	60	; the guards: columns (two), {5}
    129  8000 ????	       00 3e	   SC_SD      =	62	; facing: 0 right, 8 left (two), {5}
    130  8000 ????	       00 40	   SC_LIVE    =	64	; alive: bit 0 the first, bit 1 the {5}
    131  8000 ????						; second; {5}
    132  8000 ????	       00 41	   SC_ACC     =	65	; the fraction of their crawl (the {5}
    133  8000 ????						; King's steps); {5}
    134  8000 ????	       00 42	   SC_HM      =	66	; HMP1 for the seam (the fine move) {5}
    135  8000 ????	       00 43	   SC_KT      =	67	; the Serpent King: top line, {6}
    136  8000 ????	       00 44	   SC_KH      =	68	; blows he has had, {6}
    137  8000 ????	       00 45	   SC_KF      =	69	; frames of his flash after a blow, {6}
    138  8000 ????	       00 46	   SC_KS      =	70	; frames before he spits; {6}
    139  8000 ????	       00 47	   SC_VP      =	71	; the venom: its first pixel, {6}
    140  8000 ????	       00 48	   SC_VD      =	72	; 0 none, 1 flying right, 2 left, {6}
    141  8000 ????	       00 49	   SC_VA      =	73	; the fraction of its flight; {6}
    142  8000 ????	       00 4a	   SC_CROWN   =	74	; 0 the King, 1 the crown, 2 broken {6}
    143  8000 ????						; (new_game: 0; it stays when he {6}
    144  8000 ????						; leaves the throne room) {6}
    145  8000 ????	       00 4b	   SC_GT      =	75	; the guards: frames of the stun {9}
    146  8000 ????						; after the first blow, or before {9}
    147  8000 ????						; a dead one returns (two); {9}
    148  8000 ????	       00 4d	   SC_SPR     =	77	; the fraction of the sprint {9}
    149  8000 ????
    150  8000 ????						; trampolines, the same addresses in every bank
    151  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
    152  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
    153  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
    154  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
    155  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
    156  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
    157  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
    158  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
    159  8000 ????
    160  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD {3}
    161  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3 {2}
    162  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2 {2}
    163  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24 {2}
    164  8000 ????	       00 18	   KNIGHT_H   =	24	; {2}
    165  8000 ????
    166  8000 ????						; ---------------------------------------------------------
    167  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
    168  8000 ????						;
    169  8000 ????						; Every variable has one owner, the part of the program
    170  8000 ????						; that writes it (the others read it); the groups below say
    171  8000 ????						; which.
    172  8000 ????
    173 U00f4 ????				      SEG.U	ram
    174 U0080					      ORG	$80
    175 U0080							; == state (main.asm): frame, screens, buttons, the game {2}
    176 U0080							;|; == state (main.asm): frame, screens, the game {1-1}
    177 U0080							; == (knight.asm changes room and screen on the way out) {3}
    178 U0080		       00	   frames     ds	1	; frame counter
    179 U0081		       00	   screen     ds	1	; 0 title, 1-16 a room (room + 1) {8}
    180 U0082							;|screen  ds 1 	   ; 1-16: a room (room + 1) {1-7}
    181 U0082		       00	   shown      ds	1	; the screen set up in the SC
    182 U0083		       00	   held       ds	1	; buttons down a frame ago {2}
    183 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02, {2}
    184 U0085							; RESET $01 {2}
    185 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    186 U0086		       00 00 00    score      ds	3	; BCD, six digits (things.asm {4}
    187 U0089							; adds the points) {4}
    188 U0089							;|score   ds 3 	   ; BCD, six digits {3-3}
    189 U0089		       00	   energy     ds	1	; 0-12 (things.asm: the wounds) {5}
    190 U008a							;|energy  ds 1 	   ; 0-12: the bar of the HUD {3-4}
    191 U008a							; == Sir Roderick (knight.asm) {2}
    192 U008a							;|; == Sir Roderick (main.asm: new_game) {1-1}
    193 U008a		       00	   kx	      ds	1	; column, 0-149
    194 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    195 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    196 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust {2}
    197 U008e							;|kpose   ds 1 	   ; 0: he stands {1-1}
    198 U008e		       00	   kdist      ds	1	; units walked: pose of the walk {2}
    199 U008f		       00	   hacc       ds	1	; fraction of a step: sideways, {2}
    200 U0090		       00	   vacc       ds	1	; up and down {2}
    201 U0091		       00	   thrust     ds	1	; frames of the thrust still to go {2}
    202 U0092		       00	   parry      ds	1	; frames of the parry still to {6}
    203 U0093							; go (things.asm starts it) {6}
    204 U0093		       00	   moved      ds	1	; he moved in this frame {2}
    205 U0094		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0 {2}
    206 U0095		       00	   swnus      ds	1	; {2}
    207 U0096		       00	   swres      ds	1	; {2}
    208 U0097							; == player 1, the plug (main.asm: setup_room, {4}
    209 U0097							; == p1_bands: the thing of band A) {4}
    210 U0097							;|; == the plug (main.asm: setup_room) {3-3}
    211 U0097		       00	   ox	      ds	1	; column {4}
    212 U0098		       00	   oy	      ds	1	; top line (odd) {4}
    213 U0099		       00	   odir       ds	1	; 0 right, 8 left (REFP1) {4}
    214 U009a		       00	   okind      ds	1	; first frame in the OG tables {4}
    215 U009b		       00	   onus       ds	1	; NUSIZ1 in the room {4}
    216 U009c		       00	   plug       ds	1	; ENABL in the room: 2 the ball {3}
    217 U009d							; == the things (things.asm; new_game and setup_room {4}
    218 U009d							; == start them) {4}
    219 U009d		       00	   key	      ds	1	; the key he has: its level, 0 none {4}
    220 U009e		       00	   opened     ds	1	; open: chests bits 0-3, doors 4-7 {4}
    221 U009f		       00	   spk	      ds	1	; frames left before the plates turn {4}
    222 U00a0		       00	   spup       ds	1	; the plates: 0 down, 1 up {4}
    223 U00a1		       00	   hurt       ds	1	; frames before a wound can come {5}
    224 U00a2							; again (the spikes, a bite) {5}
    225 U00a2							; == the collision test (knight.asm: box_free, wall) {2}
    226 U00a2		       00 00	   cmap       ds	2	; collision map of the room {2}
    227 U00a4							; (main.asm: room_state) {2}
    228 U00a4		       00	   nx	      ds	1	; the box tried: column, top line {2}
    229 U00a5		       00	   ny	      ds	1	; {2}
    230 U00a6		       00	   bc0	      ds	1	; its block columns, left, right {2}
    231 U00a7		       00	   bc1	      ds	1	; {2}
    232 U00a8		       00	   br	      ds	1	; 3 x the block row tested (its {2}
    233 U00a9							; first byte in the map) {2}
    234 U00a9							; == sound (sound.asm; mode: main.asm, SELECT on the title; {8}
    235 U00a9							;|; == sound (sound.asm; mode: main.asm, SELECT; {7-7}
    236 U00a9							; == sfxreq: knight.asm asks, sound.asm clears; song: {7}
    237 U00a9							; == main.asm and things.asm) {7}
    238 U00a9		       00	   mode       ds	1	; 0 MUSIC, 1 SOUND FX, 2 SILENT {7}
    239 U00aa		       00	   smode      ds	1	; the mode the player last saw ($FF: {7}
    240 U00ab							; a song to start) {7}
    241 U00ab		       00	   song       ds	1	; 2 x the song (main.asm, {7}
    242 U00ac							; things.asm choose it) {7}
    243 U00ac		       00	   sfxreq     ds	1	; effect asked for (0: none) {7}
    244 U00ad		       00	   sfxi       ds	1	; effect playing: its frame, 0 none {7}
