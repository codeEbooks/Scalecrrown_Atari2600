------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						;|; Step 1 of the chain of the book: the first room {1-1}
      3  8000 ????						;|; Step 2 of the chain of the book: Sir Roderick {2-2}
      4  8000 ????						;|; Step 3 of the chain of the book: the dungeon {3-3}
      5  8000 ????						;|; Step 4 of the chain of the book: keys and doors {4-4}
      6  8000 ????						;|; Step 5 of the chain of the book: the serpents {5-5}
      7  8000 ????						;|; Step 6 of the chain of the book: the Serpent King {6-6}
      8  8000 ????						;|; Step 7 of the chain of the book: the sound {7-7}
      9  8000 ????						;|; Step 8 of the chain of the book: the title and the {8-8}
     10  8000 ????						;|; end screens {8-8}
     11  8000 ????						; Step 9 of the chain of the book, the last: the hunt; the {9}
     12  8000 ????						; complete game {9}
     13  8000 ????						;
     14  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
     15  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
     16  8000 ????						; The title (bank 1) with three modes of sound: SELECT {8}
     17  8000 ????						; chooses MUSIC, SOUND FX or SILENT; the button or RESET {8}
     18  8000 ????						; starts a game. {8}
     19  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four {3}
     20  8000 ????						; levels (dungeon.py). {3}
     21  8000 ????						;|; Sir Roderick in the room where he comes into the {1-2}
     22  8000 ????						;|; Crypt of Scales, The Broken Gate (dungeon.py). {1-2}
     23  8000 ????						;|; He stands where he comes in. {1-1}
     24  8000 ????						; The joystick moves him, the walls stop him, the button {2}
     25  8000 ????						; thrusts the sword; RESET starts again. {2}
     26  8000 ????						;|; The edges of the screen stop him too. {2-2}
     27  8000 ????						; The openings east and west lead to the rooms beside, the {3}
     28  8000 ????						; stairs to the level below and back; the ball closes the {3}
     29  8000 ????						; outer side of the rooms at the ends of a level. The HUD: {3}
     30  8000 ????						; the score, the energy, the name of the level. {3}
     31  8000 ????						;|; The doors are open. {3-3}
     32  8000 ????						; The things: a chest in each level gives the key of the {4}
     33  8000 ????						; level's door (a grate on the stair down; the golden gate {4}
     34  8000 ????						; before the throne room); spikes go up and down in eight {4}
     35  8000 ????						; rooms; points for chests and doors. {4}
     36  8000 ????						; The serpents: one or two in a room, crawling to and fro, {5}
     37  8000 ????						; faster in the lower levels; a bite takes energy, and so {5}
     38  8000 ????						; do the spikes; a wound makes him flash; energy 0: GAME {5}
     39  8000 ????						; OVER. {5}
     40  8000 ????						;|; A thrust of the sword kills a serpent (they are back {5-8}
     41  8000 ????						;|; when he comes in again). {5-8}
     42  8000 ????						; Player 1 shows two things: the kernel moves it in the {5}
     43  8000 ????						; middle of the room (the seam) to the serpent of the band {5}
     44  8000 ????						; below; two things in the same lines take turns. {5}
     45  8000 ????						; The Serpent King: in the throne room, drawn by its own {6}
     46  8000 ????						; kernel (bank 2), he goes up and down to meet Sir {6}
     47  8000 ????						; Roderick and spits venom (missile 1) at him; the oak {6}
     48  8000 ????						; shield parries what comes from the side Sir Roderick {6}
     49  8000 ????						; faces. Ten blows beat the King; the crown appears on the {6}
     50  8000 ????						; throne; struck, it breaks: VICTORY. {6}
     51  8000 ????						;|; After GAME OVER or VICTORY the game stops; RESET {5-7}
     52  8000 ????						;|; starts again. {5-7}
     53  8000 ????						; The sound (bank 5): the theme, and the effects of the {7}
     54  8000 ????						; sword, the stairs, the things, the bites and the blows. {7}
     55  8000 ????						;|; SELECT, in the game, chooses MUSIC, SOUND FX or SILENT. {7-7}
     56  8000 ????						; After GAME OVER or VICTORY the end screen (bank 6) with {8}
     57  8000 ????						; the score; the button goes back to the title, RESET {8}
     58  8000 ????						; starts a game. A lament for GAME OVER and a fanfare for {8}
     59  8000 ????						; VICTORY play once (MUSIC); a new song, as a new mode, {8}
     60  8000 ????						; first silences what played. {8}
     61  8000 ????						; The hunt: a serpent on Sir Roderick's lines chases him {9}
     62  8000 ????						; along its path, sprinting; it takes two blows (the first {9}
     63  8000 ????						; pushes it back and stuns it) and comes back a while after {9}
     64  8000 ????						; it dies. The King is struck only on his head. {9}
     65  8000 ????						;
     66  8000 ????						; Banks (the address of each one for the 6507):
     67  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     68  8000 ????						;   1 ($3000) the title: kernel, letters {8}
     69  8000 ????						;|;   1 ($3000) the title: only its tail before step 8 {1-7}
     70  8000 ????						;   2 ($5000) the throne room: its kernel, the King, the {6}
     71  8000 ????						;	       crown, its colours {6}
     72  8000 ????						;|;   2 ($5000) the throne room: only its tail before {1-5}
     73  8000 ????						;|;		 step 6 {1-5}
     74  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     75  8000 ????						;   4 ($9000) the things: chests, doors, spikes {4}
     76  8000 ????						;	       the serpents, the Serpent King {4}
     77  8000 ????						;|;   4 ($9000) the things: only its tail before step 4 {1-3}
     78  8000 ????						;   5 ($B000) sound: player, music, effects {7}
     79  8000 ????						;|;   5 ($B000) sound: only its tail before step 7 {1-6}
     80  8000 ????						;   6 ($D000) the end screens: their kernel, the crown {8}
     81  8000 ????						;	       whole and broken, the words, scenes {8}
     82  8000 ????						;|;   6 ($D000) the end screens: only its tail before {1-7}
     83  8000 ????						;|;		 step 8 {1-7}
     84  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     85  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     86  8000 ????						; window and ends with the same tail (trampolines, reset).
     87  8000 ????						; Banks 0 and 2 then start with the same bytes: Sir {6}
     88  8000 ????						; Roderick's figures and colours (kfig0.asm, kfig2.asm), so {6}
     89  8000 ????						; that the pointers to them work in both kernels. {6}
     90  8000 ????						;
     91  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     92  8000 ????						;	  [-DPAL=1]
     93  8000 ????
     94  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0 {2}
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1 {3}
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1 {3}
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored {3}
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 11	   RESP1      =	$11	; any write: player 1 starts here {4}
     24  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here {2}
     25  8000 ????	       00 13	   RESM1      =	$13	; any write: missile 1 starts here {6}
     26  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here {3}
     27  8000 ????	       00 15	   AUDC0      =	$15	; sound, voice 0: waveform (0-15) {7}
     28  8000 ????	       00 16	   AUDC1      =	$16	; voice 1 {7}
     29  8000 ????	       00 17	   AUDF0      =	$17	; voice 0: frequency divider (0-31) {7}
     30  8000 ????	       00 18	   AUDF1      =	$18	; voice 1 {7}
     31  8000 ????	       00 19	   AUDV0      =	$19	; voice 0: volume (0-15) {7}
     32  8000 ????	       00 1a	   AUDV1      =	$1A	; voice 1 {7}
     33  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     34  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1 {3}
     35  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on {2}
     36  8000 ????	       00 1e	   ENAM1      =	$1E	; bit 1: missile 1 on {6}
     37  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on {3}
     38  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     39  8000 ????	       00 21	   HMP1       =	$21	; fine move of player 1 {4}
     40  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0 {2}
     41  8000 ????	       00 23	   HMM1       =	$23	; fine move of missile 1 {6}
     42  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball {3}
     43  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed {3}
     44  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed {3}
     45  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0 {2}
     46  8000 ????	       00 29	   RESMP1     =	$29	; bit 1: missile 1 off, on player 1 {6}
     47  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     48  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves {3}
     49  8000 ????
     50  8000 ????						; TIA, read side {2}
     51  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down {2}
     52  8000 ????
     53  8000 ????						; RIOT
     54  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed {2}
     55  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed {2}
     56  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     57  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
