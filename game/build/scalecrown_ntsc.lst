    168  76db		       a9 ff		      lda	#$FF	; no up or down this frame {3}
    169  76dd		       85 f3		      sta	tmp+1	; {3}
    170  76df		       d0 8c		      bne	kn_walked	; {3}
    171  76e1
    172  76e1							; By a stair: he can be at the top or the bottom of the {3}
    173  76e1							; screen only in a gap of the top or bottom wall. Down from {3}
    174  76e1							; a south gap there is always the room below (a stair); up {3}
    175  76e1							; from a north gap the room above, except in the first {3}
    176  76e1							; level, where the north gap of room 1 is the broken gate of {3}
    177  76e1							; Oakhaven: nothing is above it. He comes in at the other {3}
    178  76e1							; end of the screen, in the same column; the move is a step. {3}
    179  76e1				   kn_downst		; {3}
    180  76e1		       a5 85		      lda	room	; {3}
    181  76e3		       69 03		      adc	#GRID-1	; + GRID (carry is set) {3}
    182  76e5		       a2 01		      ldx	#TOP_MIN	; in at the top {3}
    183  76e7		       d0 0a		      bne	kn_stair	; {3}
    184  76e9				   kn_up		; {3}
    185  76e9		       a5 85		      lda	room	; {3}
    186  76eb		       c9 04		      cmp	#GRID	; {3}
    187  76ed		       90 c7		      bcc	kn_pose	; the first level: he stays {3}
    188  76ef		       e9 04		      sbc	#GRID	; (carry is set) {3}
    189  76f1		       a2 87		      ldx	#TOP_MAX	; in at the bottom {3}
    190  76f3				   kn_stair		; {3}
    191  76f3		       86 8b		      stx	ky	; {3}
    192  76f5		       85 85		      sta	room	; {3}
    193  76f7		       aa		      tax		; {3}
    194  76f8		       e8		      inx		; {3}
    195  76f9		       86 81		      stx	screen	; setup_room sees the change {3}
    196  76fb		       e6 8e		      inc	kdist	; {3}
    197  76fd		       a9 01		      lda	#1	; {3}
    198  76ff		       85 93		      sta	moved	; {3}
    199  7701		       a9 0d		      lda	#SFX_STAIR	; the steps (in the SOUND FX {7}
    200  7703		       85 ac		      sta	sfxreq	; mode) {7}
    201  7705		       d0 af		      bne	kn_pose	; {3}
    202  7707
    203  7707							; ---------------------------------------------------------
    204  7707							; box_free: carry clear if Sir Roderick fits at column nx,
    205  7707							; top line ny: no block under his 8 x 24 box is stone. The
    206  7707							; box touches block columns (nx + 3) / 8 and (nx + 10) / 8,
    207  7707							; block rows ny / 16, (ny + 12) / 16 and (ny + 23) / 16
    208  7707							; (24 lines can touch three rows of 16, never four).
    209  7707
    210  7707				   box_free
    211  7707		       a5 a4		      lda	nx
    212  7709		       18		      clc
    213  770a		       69 03		      adc	#FIRST_PIXEL
    214  770c		       4a		      lsr
    215  770d		       4a		      lsr
    216  770e		       4a		      lsr
    217  770f		       85 a6		      sta	bc0	; left edge
    218  7711		       a5 a4		      lda	nx
    219  7713		       18		      clc
    220  7714		       69 0a		      adc	#FIRST_PIXEL+KNIGHT_W-1
    221  7716		       4a		      lsr
    222  7717		       4a		      lsr
    223  7718		       4a		      lsr
    224  7719		       85 a7		      sta	bc1	; right edge
    225  771b		       a5 a5		      lda	ny
    226  771d		       20 31 f7 	      jsr	bf_row	; top line
    227  7720		       b0 2b		      bcs	bf_done
    228  7722		       a5 a5		      lda	ny
    229  7724		       18		      clc
    230  7725		       69 0c		      adc	#KNIGHT_H/2
    231  7727		       20 31 f7 	      jsr	bf_row	; middle
    232  772a		       b0 21		      bcs	bf_done
    233  772c		       a5 a5		      lda	ny
    234  772e		       18		      clc
    235  772f		       69 17		      adc	#KNIGHT_H-1	; bottom line, and back
    236  7731		       4a	   bf_row     lsr		; A: a line of the box
    237  7732		       4a		      lsr
    238  7733		       4a		      lsr
    239  7734		       4a		      lsr		; its block row (0-9)
    240  7735		       85 a8		      sta	br
    241  7737		       0a		      asl		; (clears the carry)
    242  7738		       65 a8		      adc	br
    243  773a		       85 a8		      sta	br	; 3 x the row: its byte 0
    244  773c		       a5 a6		      lda	bc0
    245  773e		       20 4e f7 	      jsr	wall
    246  7741		       d0 09		      bne	bf_stone
    247  7743		       a5 a7		      lda	bc1
    248  7745		       20 4e f7 	      jsr	wall
    249  7748		       d0 02		      bne	bf_stone
    250  774a		       18		      clc		; free
    251  774b		       60		      rts
    252  774c				   bf_stone
    253  774c		       38		      sec
    254  774d				   bf_done
    255  774d		       60		      rts
    256  774e
    257  774e							; wall: Z clear (bne) if block column A (0-19) is stone in
    258  774e							; the block row whose first byte is br. The collision map
    259  774e							; has three bytes a row, the whole width (the plug closes
    260  774e							; one side only): columns 0-7 in the first byte, 8-15 in
    261  774e							; the second, 16-19 in the third, the first column in
    262  774e							; bit 7.
    263  774e		       aa	   wall       tax		; the column
    264  774f		       4a		      lsr
    265  7750		       4a		      lsr
    266  7751		       4a		      lsr		; its byte in the row, 0-2
    267  7752		       18		      clc
    268  7753		       65 a8		      adc	br
    269  7755		       a8		      tay
    270  7756		       8a		      txa
    271  7757		       29 07		      and	#7	; its bit
    272  7759		       aa		      tax
    273  775a		       b1 a2		      lda	(cmap),y
    274  775c		       3d 60 f7 	      and	BITS,x
    275  775f		       60		      rts
    276  7760
    277  7760		       80 40 20 10*BITS       .byte.b	$80, $40, $20, $10, $08, $04, $02, $01
    278  7768
    279  7768							; ---------------------------------------------------------
    280  7768							; blade: where missile 0 goes. In the thrust it is 8 pixels
    281  7768							; beside the hand: right of the figure facing right, left
    282  7768							; of it facing left; near the edge of the screen 4, 2 or 1
    283  7768							; (NUSIZ0 bits 4-5). Otherwise it is hidden: RESMP0 = 2
    284  7768							; keeps it on player 0, switched off.
    285  7768
    286  7768				   blade
    287  7768		       a9 02		      lda	#2
    288  776a		       85 96		      sta	swres	; hidden
    289  776c		       a5 8d		      lda	kpose
    290  776e		       c9 03		      cmp	#THRUST_POSE
    291  7770		       d0 41		      bne	bl_done
    292  7772		       a2 03		      ldx	#3	; width: 8 pixels
    293  7774		       a5 8c		      lda	kdir
    294  7776		       d0 1a		      bne	bl_left
    295  7778		       a5 8a		      lda	kx	; first pixel right of him
    296  777a		       18		      clc
    297  777b		       69 0b		      adc	#FIRST_PIXEL+KNIGHT_W
    298  777d		       c9 a0		      cmp	#160
    299  777f		       b0 32		      bcs	bl_done	; no room at all: hidden
    300  7781		       c9 99		      cmp	#160-7
    301  7783		       90 1c		      bcc	bl_set	; 8 pixels
    302  7785		       ca		      dex
    303  7786		       c9 9d		      cmp	#160-3
    304  7788		       90 17		      bcc	bl_set	; 4
    305  778a		       ca		      dex
    306  778b		       c9 9f		      cmp	#160-1
    307  778d		       90 12		      bcc	bl_set	; 2
    308  778f		       ca		      dex		; 1
    309  7790		       b0 0f		      bcs	bl_set
    310  7792				   bl_left		; it ends at pixel kx + 2
    311  7792		       a5 8a		      lda	kx
    312  7794		       38		      sec
    313  7795		       e9 05		      sbc	#KNIGHT_W-FIRST_PIXEL
    314  7797		       b0 08		      bcs	bl_set	; 8 pixels from kx - 5
    315  7799		       ca		      dex
    316  779a		       69 04		      adc	#4	; kx - 1 (carry clear)
    317  779c		       b0 03		      bcs	bl_set	; 4 pixels, if kx >= 1
    318  779e		       ca		      dex
    319  779f		       a9 01		      lda	#1	; kx = 0: 2 pixels, 1 and 2
    320  77a1				   bl_set		; A: first pixel, X: width
    321  77a1		       38		      sec
    322  77a2		       e9 02		      sbc	#M_OFFSET	; the column that puts it
    323  77a4		       b0 02		      bcs	bl_col	; there
    324  77a6		       69 a0		      adc	#160	; (round the screen)
    325  77a8		       85 94	   bl_col     sta	swx
    326  77aa		       bd b4 f7 	      lda	BLADE_NUS,x
    327  77ad		       85 95		      sta	swnus
    328  77af		       a9 00		      lda	#0
    329  77b1		       85 96		      sta	swres	; shown
    330  77b3				   bl_done
    331  77b3		       60		      rts
    332  77b4
    333  77b4		       00 10 20 30 BLADE_NUS  .byte.b	$00, $10, $20, $30	; 1, 2, 4, 8 pixels
------- FILE scalecrown.asm
------- FILE hud.asm LEVEL 2 PASS 2
      0  77b8					      include	"hud.asm"
      1  77b8							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  77b8							;
      3  77b8							; Entered right after the WSYNC that ends the VBLANK, at
      4  77b8							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  77b8							; lines (PAL only), then the HUD:
      6  77b8							;   lines 1-9	  the six digits of the score {3}
      7  77b8							;   lines 12-15  the energy bar {3}
      8  77b8							;   lines 17-25  LEVEL n {3}
      9  77b8							;|;   lines 0-25   black {1-2}
     10  77b8							;   lines 26-28  Sir Roderick and player 1 to their columns {4}
     11  77b8							;		  (player 1: the thing of band A; the fine {5}
     12  77b8							;		  move of the seam waits in HMP1) {5}
     13  77b8							;|;		    (player 1: the thing of the room) {4-4}
     14  77b8							;|;   lines 26-28  Sir Roderick to his column {1-3}
     15  77b8							; and goes on to bank 0 (room_kernel.asm) in line 28, or to {6}
     16  77b8							; bank 2 (throne_kernel.asm) in the throne room. {6}
     17  77b8							;|; and goes on to bank 0 (room_kernel.asm) in line 28. {1-5}
     18  77b8							;
     19  77b8							; Cycle counts in the comments: the cycle at which a store
     20  77b8							; writes, counted from 0 at the start of the line.
     21  77b8
     22  77b8				   hud
     23  77b8		       a9 00		      lda	#0
     24  77ba		       85 01		      sta	VBLANK	; the picture starts
     25  77bc				  -	      IF	TOP_BLANK
     26  77bc				  -	      ldy	#TOP_BLANK
     27  77bc				  -hu_top     sta	WSYNC
     28  77bc				  -	      dey
     29  77bc				  -	      bne	hu_top
     30  77bc					      ENDIF
     31  77bc							;|	   ldy	   #25		   ; lines 0-24: black {1-2}
     32  77bc							;|hu_black: {1-2}
     33  77bc							;|	   sta	   WSYNC {1-2}
     34  77bc							;|	   dey {1-2}
     35  77bc							;|	   bne	   hu_black {1-2}
     36  77bc		       a9 1e		      lda	#SCORE_COL	; HUD line 0 {3}
     37  77be		       85 06		      sta	COLUP0	; {3}
     38  77c0		       85 07		      sta	COLUP1	; {3}
     39  77c2		       85 02		      sta	WSYNC	; {3}
     40  77c4		       20 57 f8 	      jsr	hud_digits	; lines 1-9: the six digits {3}
     41  77c7		       85 02		      sta	WSYNC	; line 10 {3}
     42  77c9		       a9 00		      lda	#0	; {3}
     43  77cb		       85 1b		      sta	GRP0	; {3}
     44  77cd		       85 1c		      sta	GRP1	; {3}
     45  77cf		       85 1b		      sta	GRP0	; empty the delayed copies {3}
     46  77d1		       a0 03		      ldy	#3	; {3}
     47  77d3		       85 02		      sta	WSYNC	; line 11 {3}
     48  77d5		       85 02		      sta	WSYNC	; line 12 {3}
     49  77d7				   hu_bar		; lines 12-15: energy {3}
     50  77d7		       b9 f1 f9 	      lda	BAR_COL,y	; {3}
     51  77da		       85 08		      sta	COLUPF	;  6 {3}
     52  77dc		       a5 f0		      lda	bar1	; {3}
     53  77de		       85 0e		      sta	PF1	; 12 {3}
     54  77e0		       a5 f1		      lda	bar2	; {3}
     55  77e2		       85 0f		      sta	PF2	; 18 {3}
     56  77e4		       85 02		      sta	WSYNC	; {3}
     57  77e6		       88		      dey		; {3}
     58  77e7		       10 ee		      bpl	hu_bar	; {3}
     59  77e9		       a9 00		      lda	#0	; line 16 {3}
     60  77eb		       85 0e		      sta	PF1	; {3}
     61  77ed		       85 0f		      sta	PF2	; {3}
     62  77ef		       85 08		      sta	COLUPF	; the room's PF2 unseen {3}
     63  77f1		       a9 0a		      lda	#TEXT_COL	; {3}
     64  77f3		       85 06		      sta	COLUP0	; {3}
     65  77f5		       85 07		      sta	COLUP1	; {3}
     66  77f7		       85 02		      sta	WSYNC	; {3}
     67  77f9		       20 85 f8 	      jsr	hud_text	; lines 17-25: LEVEL n {3}
     68  77fc		       a5 8a		      lda	kx
     69  77fe		       85 02		      sta	WSYNC	; (the end of line 25)
     70  7800							; line 26: Sir Roderick to column kx, as place does
     71  7800							; it (the stores take 4 cycles, like sta HMP0,x)
     72  7800		       38		      sec
     73  7801		       e9 0f	   hu_p0      sbc	#15
     74  7803		       b0 fc		      bcs	hu_p0	; (hu_p0)
     75  7805		       49 07		      eor	#7
     76  7807		       0a		      asl
     77  7808		       0a		      asl
     78  7809		       0a		      asl
     79  780a		       0a		      asl
     80  780b		       8d 20 00 	      sta.w	HMP0
     81  780e		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     82  7811		       a5 97		      lda	ox	; {4}
     83  7813		       85 02		      sta	WSYNC	; 73 at most {4}
     84  7815							;|	   sta	   WSYNC	   ; 71 at most {1-3}
     85  7815							; line 27: player 1 to column ox {4}
     86  7815		       38		      sec		; {4}
     87  7816		       e9 0f	   hu_p1      sbc	#15	; {4}
     88  7818		       b0 fc		      bcs	hu_p1	; (hu_p1) {4}
     89  781a		       49 07		      eor	#7	; {4}
     90  781c		       0a		      asl		; {4}
     91  781d		       0a		      asl		; {4}
     92  781e		       0a		      asl		; {4}
     93  781f		       0a		      asl		; {4}
     94  7820		       8d 21 00 	      sta.w	HMP1	; {4}
     95  7823		       8d 11 00 	      sta.w	RESP1	; {4}
     96  7826							;|	   ; line 27: empty {1-3}
     97  7826		       85 02		      sta	WSYNC
     98  7828							; line 28: the fine moves, the room's settings
     99  7828		       85 2a		      sta	HMOVE	;  2
    100  782a		       a5 8c		      lda	kdir
    101  782c		       85 0b		      sta	REFP0
    102  782e		       a5 99		      lda	odir	; {4}
    103  7830		       85 0c		      sta	REFP1	; {4}
    104  7832		       a9 00		      lda	#0
    105  7834		       85 25		      sta	VDELP0	; {3}
    106  7836		       85 26		      sta	VDELP1	; {3}
    107  7838		       85 06		      sta	COLUP0
    108  783a		       85 07		      sta	COLUP1	; {4}
    109  783c							;|	   sta	   GRP1 	   ; (the HUD may leave it on) {3-3}
    110  783c		       a5 95		      lda	swnus	; {2}
    111  783e		       85 04		      sta	NUSIZ0	; the width of the blade {2}
    112  7840		       a5 9b		      lda	onus	; {4}
    113  7842		       85 05		      sta	NUSIZ1	; {4}
    114  7844		       85 2b		      sta	HMCLR	; 43: 41 cycles after HMOVE {5}
    115  7846		       ad c2 10 	      lda	SCR+SC_HM	; the fine move of the seam {5}
    116  7849		       85 21		      sta	HMP1	; (its HMOVE uses it) {5}
    117  784b		       a5 85		      lda	room	; the throne room has its {6}
    118  784d		       c9 0f		      cmp	#THRONE_ROOM	; own kernel {6}
    119  784f		       f0 03		      beq	hu_throne	; {6}
    120  7851		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
    121  7854				   hu_throne		; {6}
    122  7854		       4c b0 1f 	      jmp	TO_THRONE	; bank 2 {6}
    123  7857
    124  7857							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six {3}
    125  7857							; columns read through six pointers: {1} ... {1}+10 (dig: {3}
    126  7857							; the digits of the score; txp: the name of the level, in {3}
    127  7857							; this bank). Called on the line before the first one. {3}
    128  7857							; Both players are delayed (VDELP0, VDELP1) and have three {3}
    129  7857							; copies 16 pixels apart: {3}
    130  7857							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6. {3}
    131  7857							; A delayed player shows the value written before the last {3}
    132  7857							; write to the other player, so the four writes at the end {3}
    133  7857							; change the copies on the right while the beam is between {3}
    134  7857							; them. {3}
    135  7857					      MAC	hud48
    136  7857					      ldy	#7	; {3}
    137  7857					      sty	zt2	; {3}
    138  7857				   .loop      lda	({1}),y	; {3}
    139  7857					      sta	GRP0	; column 1 (waits) {3}
    140  7857					      sta	WSYNC	; {3}
    141  7857					      lda	({1}+2),y	; {3}
    142  7857					      sta	GRP1	;  7 col 2; col 1 shows {3}
    143  7857					      lda	({1}+4),y	; {3}
    144  7857					      sta	GRP0	; 15 col 3; col 2 shows {3}
    145  7857					      lda	({1}+10),y	; {3}
    146  7857					      sta	zt	; {3}
    147  7857					      lda	({1}+8),y	; {3}
    148  7857					      tax		; {3}
    149  7857					      lda	({1}+6),y	; {3}
    150  7857					      ldy	zt	; {3}
    151  7857					      nop		; {3}
    152  7857					      sta	GRP1	; 43 col 4; col 3 shows {3}
    153  7857					      stx	GRP0	; 46 col 5; col 4 shows {3}
    154  7857					      sty	GRP1	; 49 col 6; col 5 shows {3}
    155  7857					      sta	GRP0	; 52 col 6 shows {3}
    156  7857					      ldy	zt2	; {3}
    157  7857					      dey		; {3}
    158  7857					      sty	zt2	; {3}
    159  7857					      bpl	.loop	; {3}
    160  7857					      rts		; {3}
    161  7857					      ENDM		; {3}
    162  7857
    163  7857							; each routine in one page (as the blocks of the title: see {3}
    164  7857							; title_kernel.asm); the padding comes after a jmp or an rts {3}
    165  7857		       00 32	   HUD48_BYTES =	50	; {3}
    166  7857
    167  7857				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)	; {3}
    168  7857				  -	      ALIGN	256	; {3}
    169  7857					      ENDIF		; {3}
    170  7857				   hud_digits		; {3}
      0  7857					      HUD48	dig	; {3}
      1  7857		       a0 07		      ldy	#7
      2  7859		       84 ef		      sty	zt2
      3  785b		       b1 d7	   .loop      lda	(dig),y
      4  785d		       85 1b		      sta	GRP0
      5  785f		       85 02		      sta	WSYNC
      6  7861		       b1 d9		      lda	(dig+2),y
      7  7863		       85 1c		      sta	GRP1
      8  7865		       b1 db		      lda	(dig+4),y
      9  7867		       85 1b		      sta	GRP0
     10  7869		       b1 e1		      lda	(dig+10),y
     11  786b		       85 d0		      sta	zt
     12  786d		       b1 df		      lda	(dig+8),y
     13  786f		       aa		      tax
     14  7870		       b1 dd		      lda	(dig+6),y
     15  7872		       a4 d0		      ldy	zt
     16  7874		       ea		      nop
     17  7875		       85 1c		      sta	GRP1
     18  7877		       86 1b		      stx	GRP0
     19  7879		       84 1c		      sty	GRP1
     20  787b		       85 1b		      sta	GRP0
     21  787d		       a4 ef		      ldy	zt2
     22  787f		       88		      dey
     23  7880		       84 ef		      sty	zt2
     24  7882		       10 d7		      bpl	.loop
     25  7884		       60		      rts
    172  7885				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)	; {3}
    173  7885				  -	      ALIGN	256	; {3}
    174  7885					      ENDIF		; {3}
