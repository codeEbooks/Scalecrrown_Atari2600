------- FILE scalecrown.asm
------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  04ba					      include	"room_kernel.asm"
      1  04ba							; room_kernel.asm - bank 0: the room
      2  04ba							;
      3  04ba							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  04ba							; when Sir Roderick has his column for the room. Lines
      5  04ba							; 29-31 of the HUD (black) read what the first line of the
      6  04ba							; room needs; then the 160 lines of the room, BOT_BLANK
      7  04ba							; black lines (PAL only); then the overscan starts and the
      8  04ba							; program goes back to bank 7.
      9  04ba							;
     10  04ba							; Cycle counts in the comments: the cycle at which a store
     11  04ba							; writes, counted from 0 at the start of the line; a "+" is
     12  04ba							; a load that can take one cycle more when its address
     13  04ba							; crosses a page.
     14  04ba
     15  04ba				   room_kernel
     16  04ba		       85 02		      sta	WSYNC	; HUD line 29
     17  04bc		       a0 9f		      ldy	#159	; what line A0 of course 0
     18  04be		       84 a3		      sty	idx	; needs
     19  04c0		       a9 13		      lda	#19
     20  04c2		       85 a4		      sta	trow
     21  04c4		       b1 9d		      lda	(cbk),y	; +
     22  04c6		       85 a1		      sta	zbk	; COLUBK of pair 0
     23  04c8		       b1 9f		      lda	(cpf),y	; +
     24  04ca		       85 a2		      sta	zt	; COLUPF of pair 0
     25  04cc		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     26  04cf		       85 a5		      sta	znpf0
     27  04d1		       ad a7 10 	      lda	SCR+SC_PF1+19
     28  04d4		       85 a6		      sta	znpf1
     29  04d6		       ad bb 10 	      lda	SCR+SC_PF2+19
     30  04d9		       85 a7		      sta	znpf2	; for line A0
     31  04db		       85 02		      sta	WSYNC	; line 30
     32  04dd		       b1 99		      lda	(kgfx),y	; +
     33  04df		       aa		      tax
     34  04e0		       a4 a2		      ldy	zt
     35  04e2		       85 02		      sta	WSYNC	; line 31 stays empty
     36  04e4		       4c e7 14 	      jmp	k_top
     37  04e7
     38  04e7							; ---------------------------------------------------------
     39  04e7							; The room: 20 courses of 8 lines, each four pairs of lines
     40  04e7							; A and B. Lines A write the playfield colours, lines B the
     41  04e7							; colour of Sir Roderick; both write his figure.
     42  04e7							;
     43  04e7							; At the start of each line (after WSYNC) the registers hold
     44  04e7							; what the line writes first:
     45  04e7							;   line A: X = GRP0, Y = COLUPF
     46  04e7							;   line B: X = GRP0, Y = COLUP0
     47  04e7							; The rest of the line prepares the next one; idx is the
     48  04e7							; index (159 at the top) of the line being prepared.
     49  04e7							; The playfield changes once a course: A1, A2, A3 read the
     50  04e7							; next course from the Superchip RAM, A0 writes PF0, PF1
     51  04e7							; and PF2.
     52  04e7							; Lines B also write the colour of Sir Roderick to ENAM0:
     53  04e7							; bit 1 of it turns the blade (missile 0) on or off. Only in
     54  04e7							; the thrust can it show: otherwise RESMP0 keeps it hidden,
     55  04e7							; and in the thrust the colours are zero outside the figure
     56  04e7							; and have bit 1 only on the pair of the blade (art.py).
     57  04e7
     58  04e7					      MAC	line_a_rest
     59  04e7					      ldy	idx
     60  04e7					      dey
     61  04e7					      sty	idx
     62  04e7					      lda	(kcol),y	; +
     63  04e7					      sta	zt
     64  04e7					      lda	(kgfx),y	; +
     65  04e7					      tax
     66  04e7					      ldy	zt
     67  04e7					      ENDM		; prepares line B
     68  04e7
     69  04e7					      MAC	line_b_first
     70  04e7					      stx	GRP0	;  2
     71  04e7					      sty	COLUP0	;  5
     72  04e7					      sty	ENAM0	;  8 the blade: bit 1
     73  04e7					      ldy	idx
     74  04e7					      dey
     75  04e7					      sty	idx
     76  04e7					      ENDM
     77  04e7
     78  04e7					      MAC	line_b_rest
     79  04e7					      lda	(cbk),y	; +
     80  04e7					      sta	zbk
     81  04e7					      lda	(cpf),y	; +
     82  04e7					      sta	zt
     83  04e7					      lda	(kgfx),y	; +
     84  04e7					      tax
     85  04e7					      ldy	zt
     86  04e7					      ENDM		; prepares line A
     87  04e7
     88  04e7					      MAC	line_a_first
     89  04e7					      stx	GRP0	;  2
     90  04e7					      sty	COLUPF	;  5
     91  04e7					      lda	zbk
     92  04e7					      sta	COLUBK	; 11
     93  04e7					      ldx	trow
     94  04e7					      lda	SCR+{1},x
     95  04e7					      ENDM		; A1-A3: {1} = SC table
     96  04e7
     97  04e7		       85 02	   k_top      sta	WSYNC
     98  04e9		       86 1b	   k_a0       stx	GRP0	;  2
     99  04eb		       84 08		      sty	COLUPF	;  5
    100  04ed		       a5 a1		      lda	zbk
    101  04ef		       85 09		      sta	COLUBK	; 11
    102  04f1		       a5 a5		      lda	znpf0
    103  04f3		       85 0d		      sta	PF0	; 17
    104  04f5		       a5 a6		      lda	znpf1
    105  04f7		       85 0e		      sta	PF1	; 23
    106  04f9		       a5 a7		      lda	znpf2
    107  04fb		       85 0f		      sta	PF2	; 29
