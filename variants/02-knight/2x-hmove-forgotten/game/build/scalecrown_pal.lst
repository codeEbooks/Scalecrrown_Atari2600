    131  72cb							; ---------------------------------------------------------
    132  72cb							; box_free: carry clear if Sir Roderick fits at column nx,
    133  72cb							; top line ny: no block under his 8 x 24 box is stone. The
    134  72cb							; box touches block columns (nx + 3) / 8 and (nx + 10) / 8,
    135  72cb							; block rows ny / 16, (ny + 12) / 16 and (ny + 23) / 16
    136  72cb							; (24 lines can touch three rows of 16, never four).
    137  72cb
    138  72cb				   box_free
    139  72cb		       a5 94		      lda	nx
    140  72cd		       18		      clc
    141  72ce		       69 03		      adc	#FIRST_PIXEL
    142  72d0		       4a		      lsr
    143  72d1		       4a		      lsr
    144  72d2		       4a		      lsr
    145  72d3		       85 96		      sta	bc0	; left edge
    146  72d5		       a5 94		      lda	nx
    147  72d7		       18		      clc
    148  72d8		       69 0a		      adc	#FIRST_PIXEL+KNIGHT_W-1
    149  72da		       4a		      lsr
    150  72db		       4a		      lsr
    151  72dc		       4a		      lsr
    152  72dd		       85 97		      sta	bc1	; right edge
    153  72df		       a5 95		      lda	ny
    154  72e1		       20 f5 f2 	      jsr	bf_row	; top line
    155  72e4		       b0 2b		      bcs	bf_done
    156  72e6		       a5 95		      lda	ny
    157  72e8		       18		      clc
    158  72e9		       69 0c		      adc	#KNIGHT_H/2
    159  72eb		       20 f5 f2 	      jsr	bf_row	; middle
    160  72ee		       b0 21		      bcs	bf_done
    161  72f0		       a5 95		      lda	ny
    162  72f2		       18		      clc
    163  72f3		       69 17		      adc	#KNIGHT_H-1	; bottom line, and back
    164  72f5		       4a	   bf_row     lsr		; A: a line of the box
    165  72f6		       4a		      lsr
    166  72f7		       4a		      lsr
    167  72f8		       4a		      lsr		; its block row (0-9)
    168  72f9		       85 98		      sta	br
    169  72fb		       0a		      asl		; (clears the carry)
    170  72fc		       65 98		      adc	br
    171  72fe		       85 98		      sta	br	; 3 x the row: its byte 0
    172  7300		       a5 96		      lda	bc0
    173  7302		       20 12 f3 	      jsr	wall
    174  7305		       d0 09		      bne	bf_stone
    175  7307		       a5 97		      lda	bc1
    176  7309		       20 12 f3 	      jsr	wall
    177  730c		       d0 02		      bne	bf_stone
