     38  722b		       ad 80 02 	      lda	SWCHA	; right $80, left $40, down
     39  722e		       85 a9		      sta	tmp+1	; $20, up $10: 0 = pushed
     40  7230		       29 c0		      and	#$C0
     41  7232		       c9 c0		      cmp	#$C0
