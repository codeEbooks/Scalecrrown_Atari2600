------- FILE knight.asm LEVEL 2 PASS 2
      0  7212					      include	"knight.asm"
      1  7212							; knight.asm - bank 7: Sir Roderick
      2  7212							;
      3  7212							; the button starts a thrust of the sword, during which he
      4  7212							; stands still; otherwise the joystick moves him, first
      5  7212							; left or right, then up or down, each direction tried on
      6  7212							; its own against the walls (so he slides along a wall
      7  7212							; when pushed diagonally into it); the edges of the
      8  7212							; screen stop him as the walls do.
      9  7212							; The speeds are in bank7.asm, one table for each
     10  7212							; television (rules.py).
     11  7212
     12  7212				  -	      IF	V_INT != 0
     13  7212				  -	      ERR		; one step at most per frame
     14  7212					      ENDIF
     15  7212				  -	      IF	STRIDE != 8
     16  7212				  -	      ERR		; the walk divides by 8
     17  7212					      ENDIF
     18  7212
     19  7212				   knight
     20  7212				   kn_thrust
     21  7212		       a5 8d		      lda	thrust
     22  7214		       f0 04		      beq	kn_fire
