------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 2 of the chain of the book: Sir Roderick
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the room where he comes into the
      7  8000 ????						; Crypt of Scales, The Broken Gate (dungeon.py).
      8  8000 ????						; The joystick moves him, the walls stop him, the button
      9  8000 ????						; thrusts the sword; RESET starts again.
     10  8000 ????						; The edges of the screen stop him too.
     11  8000 ????						;
     12  8000 ????						; Banks (the address of each one for the 6507):
     13  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     14  8000 ????						;   1 ($3000) the title: only its tail before step 8
     15  8000 ????						;   2 ($5000) the throne room: only its tail before
     16  8000 ????						;	       step 6
     17  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     18  8000 ????						;   4 ($9000) the things: only its tail before step 4
     19  8000 ????						;   5 ($B000) sound: only its tail before step 7
     20  8000 ????						;   6 ($D000) the end screens: only its tail before
     21  8000 ????						;	       step 8
     22  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     23  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     24  8000 ????						; window and ends with the same tail (trampolines, reset).
     25  8000 ????						;
     26  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     27  8000 ????						;	  [-DPAL=1]
     28  8000 ????
     29  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     12  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     13  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     14  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     15  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     16  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     17  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     18  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     19  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     20  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     21  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     22  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     23  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     24  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     25  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     26  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     27  8000 ????
     28  8000 ????						; TIA, read side
     29  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     30  8000 ????
     31  8000 ????						; RIOT
     32  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     33  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     34  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     35  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     31  8000 ????
     32  8000 ????			  -	      IFNCONST	PAL
     33  8000 ????			  -PAL	      =	0
     34  8000 ????				      ENDIF
     35  8000 ????
     36  8000 ????				      IF	PAL
     37  8000 ????	       00 12	   TOP_BLANK  =	18	; black lines above the HUD
     38  8000 ????	       00 12	   BOT_BLANK  =	18	; and below the room
     39  8000 ????	       00 36	   VBLANK_TIM =	54
     40  8000 ????	       00 2b	   OVER_TIM   =	43
     41  8000 ????			  -	      ELSE
     42  8000 ????			  -TOP_BLANK  =	0
     43  8000 ????			  -BOT_BLANK  =	0
     44  8000 ????			  -VBLANK_TIM =	44
     45  8000 ????			  -OVER_TIM   =	35
     46  8000 ????				      ENDIF
     47  8000 ????
     48  8000 ????						; F4: an access to $1FF4 + n selects bank n
     49  8000 ????	       1f f4	   F4B0       =	$1FF4
     50  8000 ????	       1f f5	   F4B1       =	$1FF5
     51  8000 ????	       1f f6	   F4B2       =	$1FF6
     52  8000 ????	       1f f7	   F4B3       =	$1FF7
     53  8000 ????	       1f f8	   F4B4       =	$1FF8
     54  8000 ????	       1f f9	   F4B5       =	$1FF9
     55  8000 ????	       1f fa	   F4B6       =	$1FFA
     56  8000 ????	       1f fb	   F4B7       =	$1FFB
     57  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     58  8000 ????	       10 00	   SCW	      =	$1000
     59  8000 ????	       10 80	   SCR	      =	$1080
     60  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     61  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     62  8000 ????	       00 28	   SC_PF2     =	40
     63  8000 ????
     64  8000 ????						; trampolines, the same addresses in every bank
     65  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
     66  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
     67  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
     68  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
     69  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
     70  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
     71  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
     72  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
     73  8000 ????
     74  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
     75  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
     76  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
     77  8000 ????	       00 18	   KNIGHT_H   =	24
     78  8000 ????
     79  8000 ????						; ---------------------------------------------------------
     80  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
     81  8000 ????						;
     82  8000 ????						; Every variable has one owner, the part of the program
     83  8000 ????						; that writes it (the others read it); the groups below say
     84  8000 ????						; which.
     85  8000 ????
     86 U00aa ????				      SEG.U	ram
     87 U0080					      ORG	$80
     88 U0080							; == state (main.asm): frame, screens, buttons, the game
     89 U0080		       00	   frames     ds	1	; frame counter
     90 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
     91 U0082		       00	   shown      ds	1	; the screen set up in the SC
     92 U0083		       00	   held       ds	1	; buttons down a frame ago
     93 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
     94 U0085							; RESET $01
     95 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
     96 U0086							; == Sir Roderick (knight.asm)
     97 U0086		       00	   kx	      ds	1	; column, 0-149
     98 U0087		       00	   ky	      ds	1	; top line, odd, 1-135
     99 U0088		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    100 U0089		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    101 U008a		       00	   kdist      ds	1	; units walked: pose of the walk
    102 U008b		       00	   hacc       ds	1	; fraction of a step: sideways,
    103 U008c		       00	   vacc       ds	1	; up and down
    104 U008d		       00	   thrust     ds	1	; frames of the thrust still to go
    105 U008e		       00	   moved      ds	1	; he moved in this frame
    106 U008f		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    107 U0090		       00	   swnus      ds	1
    108 U0091		       00	   swres      ds	1
    109 U0092							; == the collision test (knight.asm: box_free, wall)
    110 U0092		       00 00	   cmap       ds	2	; collision map of the room
    111 U0094							; (main.asm: room_state)
    112 U0094		       00	   nx	      ds	1	; the box tried: column, top line
    113 U0095		       00	   ny	      ds	1
    114 U0096		       00	   bc0	      ds	1	; its block columns, left, right
    115 U0097		       00	   bc1	      ds	1
    116 U0098		       00	   br	      ds	1	; 3 x the block row tested (its
    117 U0099							; first byte in the map)
    118 U0099							; == the kernels (main.asm prepares; room_kernel.asm)
    119 U0099		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    120 U009b		       00 00	   kcol       ds	2
    121 U009d		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    122 U009f		       00 00	   cpf	      ds	2
    123 U00a1		       00	   zbk	      ds	1	; COLUBK of the next line A
    124 U00a2		       00	   zt	      ds	1	; colour for Y at the end of a line
    125 U00a3		       00	   idx	      ds	1	; index of the line being prepared
    126 U00a4		       00	   trow       ds	1	; Superchip index of the next course
    127 U00a5		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    128 U00a6		       00	   znpf1      ds	1
    129 U00a7		       00	   znpf2      ds	1
    130 U00a8							; == scratch (anyone; never kept across a call)
    131 U00a8		       00 00	   tmp	      ds	2
    132 U00aa				   ram_end
    133 U00aa
    134 U00aa							; ---------------------------------------------------------
    135 U00aa							; the banks
    136 U00aa
    137 U00aa					      MAC	bank
    138 U00aa					      SEG	bank{1}
    139 U00aa					      ORG	{1}*$1000
    140 U00aa					      RORG	$1000+{1}*$2000
    141 U00aa					      ds	256, 0	; the Superchip window
    142 U00aa					      ENDM		; {1}: bank number
    143 U00aa
    144 U00aa					      MAC	tail
    145 U00aa					      ORG	{1}*$1000+$FAA
    146 U00aa					      RORG	$1FAA+{1}*$2000
    147 U00aa					      sta	F4B6	; $FAA: to the end screens
    148 U00aa					      jmp	ends_kernel
    149 U00aa					      sta	F4B2	; $FB0: to the throne kernel
    150 U00aa					      jmp	throne_kernel
    151 U00aa					      sta	F4B4	; $FB6: (jsr here) bank 4
    152 U00aa					      jsr	things	; $FB9: in bank 4
    153 U00aa					      sta	F4B7	; $FBC: bank 7 again
    154 U00aa					      rts		; $FBF: in bank 7
    155 U00aa					      sta	F4B0	; $FC0: to the room kernel
    156 U00aa					      jmp	room_kernel
    157 U00aa					      sta	F4B1	; $FC6: to the title kernel
    158 U00aa					      jmp	title_kernel
    159 U00aa					      sta	F4B7	; $FCC: back to the frame
    160 U00aa					      jmp	kernel_done
    161 U00aa					      sta	F4B5	; $FD2: (jsr here) bank 5
    162 U00aa					      jsr	sound	; $FD5: in bank 5
    163 U00aa					      sta	F4B7	; $FD8: bank 7 again
    164 U00aa					      rts		; $FDB: in bank 7
    165 U00aa					      ORG	{1}*$1000+$FE0
    166 U00aa					      RORG	$1FE0+{1}*$2000
    167 U00aa					      sta	F4B7	; $FE0: reset, in any bank
    168 U00aa					      jmp	start
    169 U00aa					      sta	F4B3	; $FE6: (jsr here) bank 3
    170 U00aa					      jsr	room_copy	; $FE9: in bank 3
    171 U00aa					      sta	F4B7	; $FEC: bank 7 again
    172 U00aa					      rts		; $FEF: in bank 7
    173 U00aa					      ORG	{1}*$1000+$FFC
    174 U00aa					      RORG	$1FFC+{1}*$2000
    175 U00aa					      .word	$1FE0+{1}*$2000
    176 U00aa					      .word	$1FE0+{1}*$2000
    177 U00aa					      ENDM		; {1}: bank number
    178 U00aa
    179 U00aa							; A bank whose code comes in a later step has only its
    180 U00aa							; tail, and the routine its trampoline goes to is a stub:
    181 U00aa							; never called before that step.
    182 U00aa
    183 U00aa							; --- bank 0: the room -------------------------------------
      0 U00aa					      BANK	0
      1  1000 ????				      SEG	bank0
      2  0000					      ORG	0*$1000
      3  0000					      RORG	$1000+0*$2000
      4  0000		       00 00 00 00*	      ds	256, 0
