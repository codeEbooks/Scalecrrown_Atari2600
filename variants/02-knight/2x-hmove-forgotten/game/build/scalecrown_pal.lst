    179  730f		       60		      rts
    180  7310				   bf_stone
    181  7310		       38		      sec
    182  7311				   bf_done
    183  7311		       60		      rts
    184  7312
    185  7312							; wall: Z clear (bne) if block column A (0-19) is stone in
    186  7312							; the block row whose first byte is br. The collision map
    187  7312							; has three bytes a row, the whole width (the plug closes
    188  7312							; one side only): columns 0-7 in the first byte, 8-15 in
    189  7312							; the second, 16-19 in the third, the first column in
    190  7312							; bit 7.
    191  7312		       aa	   wall       tax		; the column
    192  7313		       4a		      lsr
    193  7314		       4a		      lsr
    194  7315		       4a		      lsr		; its byte in the row, 0-2
    195  7316		       18		      clc
    196  7317		       65 98		      adc	br
    197  7319		       a8		      tay
    198  731a		       8a		      txa
    199  731b		       29 07		      and	#7	; its bit
    200  731d		       aa		      tax
    201  731e		       b1 92		      lda	(cmap),y
    202  7320		       3d 24 f3 	      and	BITS,x
    203  7323		       60		      rts
    204  7324
    205  7324		       80 40 20 10*BITS       .byte.b	$80, $40, $20, $10, $08, $04, $02, $01
    206  732c
    207  732c							; ---------------------------------------------------------
    208  732c							; blade: where missile 0 goes. In the thrust it is 8 pixels
    209  732c							; beside the hand: right of the figure facing right, left
    210  732c							; of it facing left; near the edge of the screen 4, 2 or 1
    211  732c							; (NUSIZ0 bits 4-5). Otherwise it is hidden: RESMP0 = 2
    212  732c							; keeps it on player 0, switched off.
    213  732c
    214  732c				   blade
    215  732c		       a9 02		      lda	#2
    216  732e		       85 91		      sta	swres	; hidden
    217  7330		       a5 89		      lda	kpose
    218  7332		       c9 03		      cmp	#THRUST_POSE
    219  7334		       d0 41		      bne	bl_done
    220  7336		       a2 03		      ldx	#3	; width: 8 pixels
    221  7338		       a5 88		      lda	kdir
    222  733a		       d0 1a		      bne	bl_left
    223  733c		       a5 86		      lda	kx	; first pixel right of him
    224  733e		       18		      clc
    225  733f		       69 0b		      adc	#FIRST_PIXEL+KNIGHT_W
    226  7341		       c9 a0		      cmp	#160
    227  7343		       b0 32		      bcs	bl_done	; no room at all: hidden
    228  7345		       c9 99		      cmp	#160-7
    229  7347		       90 1c		      bcc	bl_set	; 8 pixels
    230  7349		       ca		      dex
    231  734a		       c9 9d		      cmp	#160-3
    232  734c		       90 17		      bcc	bl_set	; 4
    233  734e		       ca		      dex
    234  734f		       c9 9f		      cmp	#160-1
    235  7351		       90 12		      bcc	bl_set	; 2
    236  7353		       ca		      dex		; 1
    237  7354		       b0 0f		      bcs	bl_set
    238  7356				   bl_left		; it ends at pixel kx + 2
    239  7356		       a5 86		      lda	kx
    240  7358		       38		      sec
    241  7359		       e9 05		      sbc	#KNIGHT_W-FIRST_PIXEL
    242  735b		       b0 08		      bcs	bl_set	; 8 pixels from kx - 5
    243  735d		       ca		      dex
    244  735e		       69 04		      adc	#4	; kx - 1 (carry clear)
    245  7360		       b0 03		      bcs	bl_set	; 4 pixels, if kx >= 1
    246  7362		       ca		      dex
    247  7363		       a9 01		      lda	#1	; kx = 0: 2 pixels, 1 and 2
    248  7365				   bl_set		; A: first pixel, X: width
    249  7365		       38		      sec
    250  7366		       e9 02		      sbc	#M_OFFSET	; the column that puts it
    251  7368		       b0 02		      bcs	bl_col	; there
    252  736a		       69 a0		      adc	#160	; (round the screen)
    253  736c		       85 8f	   bl_col     sta	swx
    254  736e		       bd 78 f3 	      lda	BLADE_NUS,x
    255  7371		       85 90		      sta	swnus
    256  7373		       a9 00		      lda	#0
    257  7375		       85 91		      sta	swres	; shown
    258  7377				   bl_done
    259  7377		       60		      rts
    260  7378
    261  7378		       00 10 20 30 BLADE_NUS  .byte.b	$00, $10, $20, $30	; 1, 2, 4, 8 pixels
