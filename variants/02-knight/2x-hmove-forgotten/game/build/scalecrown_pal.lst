------- FILE hud.asm LEVEL 2 PASS 2
      0  737c					      include	"hud.asm"
      1  737c							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  737c							;
      3  737c							; Entered right after the WSYNC that ends the VBLANK, at
      4  737c							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  737c							; lines (PAL only), then the HUD:
      6  737c							;   lines 0-25   black
      7  737c							;   lines 26-28  Sir Roderick to his column
      8  737c							; and goes on to bank 0 (room_kernel.asm) in line 28.
      9  737c							;
     10  737c							; Cycle counts in the comments: the cycle at which a store
     11  737c							; writes, counted from 0 at the start of the line.
     12  737c
     13  737c				   hud
     14  737c		       a9 00		      lda	#0
     15  737e		       85 01		      sta	VBLANK	; the picture starts
     16  7380					      IF	TOP_BLANK
     17  7380		       a0 12		      ldy	#TOP_BLANK
     18  7382		       85 02	   hu_top     sta	WSYNC
     19  7384		       88		      dey
     20  7385		       d0 fb		      bne	hu_top
     21  7387					      ENDIF
     22  7387		       a0 19		      ldy	#25	; lines 0-24: black
     23  7389				   hu_black
     24  7389		       85 02		      sta	WSYNC
     25  738b		       88		      dey
     26  738c		       d0 fb		      bne	hu_black
     27  738e		       a5 86		      lda	kx
     28  7390		       85 02		      sta	WSYNC	; (the end of line 25)
     29  7392							; line 26: Sir Roderick to column kx, as place does
     30  7392							; it (the stores take 4 cycles, like sta HMP0,x)
     31  7392		       38		      sec
     32  7393		       e9 0f	   hu_p0      sbc	#15
     33  7395		       b0 fc		      bcs	hu_p0	; (hu_p0)
     34  7397		       49 07		      eor	#7
     35  7399		       0a		      asl
     36  739a		       0a		      asl
     37  739b		       0a		      asl
     38  739c		       0a		      asl
     39  739d		       8d 20 00 	      sta.w	HMP0
     40  73a0		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     41  73a3		       85 02		      sta	WSYNC	; 71 at most
     42  73a5							; line 27: empty
     43  73a5		       85 02		      sta	WSYNC
     44  73a7							; line 28: the fine moves, the room's settings
     45  73a7		       a5 88		      lda	kdir
     46  73a9		       85 0b		      sta	REFP0
     47  73ab		       a9 00		      lda	#0
     48  73ad		       85 06		      sta	COLUP0
     49  73af		       a5 90		      lda	swnus
     50  73b1		       85 04		      sta	NUSIZ0	; the width of the blade
     51  73b3		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
