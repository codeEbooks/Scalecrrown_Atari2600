    333  730a							; name: the six pointers of the name in the HUD, X = 0-3
    334  730a							; the level - 1, 4 GAME OVER: one a column of 8 bytes, the
    335  730a							; sixth 40 bytes after the first (room_state adds 8 for the
    336  730a							; key); the 56 bytes are in one page: one high byte
    337  730a		       bd 9e fe    name       lda	TX_HI,x
    338  730d		       85 e4		      sta	txp+1
    339  730f		       85 e6		      sta	txp+3
    340  7311		       85 e8		      sta	txp+5
    341  7313		       85 ea		      sta	txp+7
    342  7315		       85 ec		      sta	txp+9
    343  7317		       85 ee		      sta	txp+11
    344  7319		       bd 98 fe 	      lda	TX_LO,x
    345  731c		       85 e3		      sta	txp
    346  731e		       18		      clc		; (no carry: one page)
    347  731f		       69 08		      adc	#8
    348  7321		       85 e5		      sta	txp+2
    349  7323		       69 08		      adc	#8
    350  7325		       85 e7		      sta	txp+4
    351  7327		       69 08		      adc	#8
    352  7329		       85 e9		      sta	txp+6
    353  732b		       69 08		      adc	#8
    354  732d		       85 eb		      sta	txp+8
    355  732f		       69 08		      adc	#8
    356  7331		       85 ed		      sta	txp+10
    357  7333		       60		      rts
