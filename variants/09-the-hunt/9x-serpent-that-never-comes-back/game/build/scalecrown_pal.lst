    163  71fa				   buttons
    164  71fa		       a5 0c		      lda	INPT4	; bit 7: the fire button
    165  71fc		       49 ff		      eor	#$FF
    166  71fe		       29 80		      and	#$80
    167  7200		       85 f2		      sta	tmp
    168  7202		       ad 82 02 	      lda	SWCHB	; bit 0 RESET, bit 1 SELECT
    169  7205		       49 ff		      eor	#$FF
    170  7207		       29 03		      and	#$03
    171  7209		       05 f2		      ora	tmp
    172  720b		       aa		      tax		; down now
    173  720c		       45 83		      eor	held	; changed
    174  720e		       86 83		      stx	held
    175  7210		       25 83		      and	held	; changed and down now
