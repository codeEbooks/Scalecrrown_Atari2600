    266  7295							; ---------------------------------------------------------
    267  7295							; setup_room: when the screen changes, the playfield of
    268  7295							; the room goes into the Superchip RAM (bank 3)
    269  7295							; - with its door open if it is;
    270  7295							; - the HUD gets the name of its level; the plug of the
    271  7295							;   room is chosen;
    272  7295							; - the plates of the spikes start down, NUSIZ1 of the
    273  7295							;   room;
    274  7295							; - the guards go to their start alive (the army is
    275  7295							;   infinite);
    276  7295							; - in the throne room the King starts again (in front
    277  7295							;   of his throne, no blow, no venom; unless he has been
    278  7295							;   beaten: the crown stays)
    279  7295
    280  7295				   setup_room
    281  7295		       a5 81		      lda	screen
    282  7297		       c5 82		      cmp	shown
    283  7299		       f0 6e		      beq	su_done
    284  729b		       85 82		      sta	shown
    285  729d		       20 e6 1f 	      jsr	TO_COPY	; bank 3: room_copy
    286  72a0				   su_copied		; the tests time the copy
    287  72a0		       a5 85		      lda	room	; the name of the level
    288  72a2		       4a		      lsr
    289  72a3		       4a		      lsr
    290  72a4		       aa		      tax
    291  72a5		       20 0a f3 	      jsr	name
    292  72a8		       bd f8 fc 	      lda	SU_DOWN,x	; the plates: down, for the
    293  72ab		       85 9f		      sta	spk	; time of the level
    294  72ad		       a9 00		      lda	#0
    295  72af		       85 a0		      sta	spup
    296  72b1		       8d 41 10 	      sta	SCW+SC_ACC	; the guards: no fraction,
    297  72b4		       8d 4d 10 	      sta	SCW+SC_SPR	; no sprint, no stun, no
    298  72b7		       8d 4b 10 	      sta	SCW+SC_GT	; return,
    299  72ba		       8d 4c 10 	      sta	SCW+SC_GT+1
    300  72bd		       a9 03		      lda	#3	; both alive, unwounded,
    301  72bf		       8d 40 10 	      sta	SCW+SC_LIVE
    302  72c2		       a9 08		      lda	#8	; facing left,
    303  72c4		       8d 3e 10 	      sta	SCW+SC_SD
    304  72c7		       8d 3f 10 	      sta	SCW+SC_SD+1
    305  72ca		       a6 85		      ldx	room
    306  72cc		       bd 4e f9 	      lda	S_X,x	; at their start (the first:
    307  72cf		       8d 3c 10 	      sta	SCW+SC_SX	; its coarse column and fine
    308  72d2		       bd 5e f9 	      lda	S_X+16,x	; move for the seam, as
    309  72d5		       8d 3d 10 	      sta	SCW+SC_SX+1	; things.asm keeps them)
    310  72d8		       bd 6e f9 	      lda	S_CO,x
    311  72db		       85 bb		      sta	zcoarse
    312  72dd		       bd 7e f9 	      lda	S_HM,x
    313  72e0		       8d 42 10 	      sta	SCW+SC_HM
    314  72e3		       e0 0f		      cpx	#THRONE_ROOM
    315  72e5		       d0 18		      bne	su_plug
    316  72e7		       a9 19		      lda	#KING_START	; the King
    317  72e9		       8d 43 10 	      sta	SCW+SC_KT
    318  72ec		       a9 00		      lda	#0
    319  72ee		       8d 44 10 	      sta	SCW+SC_KH
    320  72f1		       8d 45 10 	      sta	SCW+SC_KF
    321  72f4		       8d 48 10 	      sta	SCW+SC_VD
    322  72f7		       8d 49 10 	      sta	SCW+SC_VA
    323  72fa		       a9 50		      lda	#SPIT_FIRST
    324  72fc		       8d 46 10 	      sta	SCW+SC_KS
    325  72ff				   su_plug
    326  72ff		       bd 9e f9 	      lda	PLUG,x	; the ball on or off
    327  7302		       85 9c		      sta	plug
    328  7304		       bd 0e f9 	      lda	OB_NUS,x
    329  7307		       85 9b		      sta	onus
    330  7309				   su_done
    331  7309		       60		      rts
