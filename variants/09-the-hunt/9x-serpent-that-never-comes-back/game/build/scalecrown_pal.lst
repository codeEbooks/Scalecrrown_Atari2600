     33  7115		       f0 06		      beq	kd_sound	; only the sound
     34  7117		       20 b6 1f 	      jsr	TO_THINGS	; the things (bank 4)
     35  711a		       20 c1 f5 	      jsr	digits	; the score's digits
     36  711d				   kd_sound		; the sound (bank 5)
     37  711d		       20 d2 1f 	      jsr	TO_SOUND
     38  7120				   over_wait
     39  7120		       ad 84 02 	      lda	INTIM
     40  7123		       d0 fb		      bne	over_wait
     41  7125
     42  7125		       a9 02	   main       lda	#2	; VSYNC: three lines,
     43  7127		       85 02		      sta	WSYNC	; 228 cycles
     44  7129		       85 00		      sta	VSYNC
     45  712b		       85 01		      sta	VBLANK
     46  712d		       85 02		      sta	WSYNC
     47  712f		       85 02		      sta	WSYNC
     48  7131		       4a		      lsr
     49  7132		       85 02		      sta	WSYNC
