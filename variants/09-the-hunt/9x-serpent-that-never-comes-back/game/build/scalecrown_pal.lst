    359  7334							; ---------------------------------------------------------
    360  7334							; room_state: in every frame of a game, what follows from
    361  7334							; the things of the room (things.asm, bank 4, in the
    362  7334							; overscan): the thing of player 1 closed or open, the
    363  7334							; collision map with the door closed or open, the HUD
    364  7334							; with the key after LEVEL n (the sixth column of the
    365  7334							; name, 8 bytes on) or, after the end, GAME OVER or
    366  7334							; VICTORY
    367  7334
    368  7334				   room_state
    369  7334		       a6 85		      ldx	room
    370  7336		       bc be f8 	      ldy	OB_KIND0,x	; the thing: closed
    371  7339		       bd de f8 	      lda	OB_BIT,x
    372  733c		       25 9e		      and	opened
    373  733e		       f0 03		      beq	rs_kind
    374  7340		       bc ce f8 	      ldy	OB_KIND1,x	; open
    375  7343				   rs_kind
    376  7343		       84 9a		      sty	okind
    377  7345		       bd e8 fc 	      lda	RDOOR,x	; the door of the room
    378  7348		       25 9e		      and	opened
    379  734a		       f0 08		      beq	rs_closed
    380  734c		       bd 30 fc 	      lda	CM_LO,x	; open (or no door)
    381  734f		       bc 40 fc 	      ldy	CM_HI,x
    382  7352		       d0 06		      bne	rs_map	; (never 0)
    383  7354				   rs_closed
    384  7354		       bd c8 fc 	      lda	CMC_LO,x
    385  7357		       bc d8 fc 	      ldy	CMC_HI,x
    386  735a		       85 a2	   rs_map     sta	cmap
    387  735c		       84 a3		      sty	cmap+1
    388  735e		       a2 05		      ldx	#5	; VICTORY
    389  7360		       a5 c2		      lda	won
    390  7362		       d0 05		      bne	rs_name
    391  7364		       ca		      dex		; GAME OVER
    392  7365		       a5 c1		      lda	over
    393  7367		       f0 03		      beq	rs_play
    394  7369				   rs_name
    395  7369		       4c 0a f3 	      jmp	name
    396  736c				   rs_play
    397  736c		       a5 e3		      lda	txp
    398  736e		       18		      clc		; (no carry: one page)
    399  736f		       69 28		      adc	#40
    400  7371		       a4 9d		      ldy	key
    401  7373		       f0 02		      beq	rs_key
    402  7375		       69 08		      adc	#8
    403  7377		       85 ed	   rs_key     sta	txp+10
    404  7379		       60		      rts
