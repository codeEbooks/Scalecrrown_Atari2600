     95  7187		       b0 04		      bcs	fr_end
     96  7189		       e6 c1		      inc	over
     97  718b		       d0 49		      bne	fr_room	; (never 0)
     98  718d		       a9 00	   fr_end     lda	#0	; the end screen: screen 0,
     99  718f		       85 81		      sta	screen	; over or won go on counting
    100  7191				   fr_ends
    101  7191		       a5 84		      lda	pressed	; RESET: a game at once
    102  7193		       4a		      lsr
    103  7194		       90 06		      bcc	fe_count
    104  7196		       20 54 f2 	      jsr	new_game
    105  7199		       4c d6 f1 	      jmp	fr_room
    106  719c				   fe_count
