------- FILE throne_kernel.asm LEVEL 2 PASS 2
      0  2589					      include	"throne_kernel.asm"
      1  2589							; throne_kernel.asm - bank 2: the throne room
      2  2589							;
      3  2589							; The room kernel of bank 0 (room_kernel.asm) for the last
      4  2589							; room, with two changes:
      5  2589							; - no seam: player 1 shows one thing, the Serpent King
      6  2589							;   (twice as wide) or the crown (four times as wide);
      7  2589							; - the venom: missile 1. Lines B write the colour of player
      8  2589							;   1 to ENAM1 as well as to COLUP1: bit 1 of it turns the
      9  2589							;   missile on or off, as bit 1 of Sir Roderick's colour
     10  2589							;   does with the blade (missile 0). While the venom flies,
     11  2589							;   the King's colours have bit 1 only on the pair of his
     12  2589							;   mouth (look.king_colours; the tables are padded with
     13  2589							;   zeros, because the kernel reads them on every line), so
     14  2589							;   the venom is drawn on those two lines, at the column of
     15  2589							;   missile 1 (prep_room); otherwise RESMP1 keeps it hidden.
     16  2589							; Sir Roderick's figures and colours are the same bytes at
     17  2589							; the same place as in bank 0 (kfig2.asm, kfig0.asm): the
     18  2589							; pointers of prep_room work in both banks. Entered from the
     19  2589							; HUD (hud.asm, bank 7) in HUD line 28, as the room kernel;
     20  2589							; leaves through TO_MAIN in the same way.
     21  2589							;
     22  2589							; Cycle counts in the comments: the cycle at which a store
     23  2589							; writes, counted from 0 at the start of the line; a "+" is
     24  2589							; a load that can take one cycle more when its address
     25  2589							; crosses a page (the colour table of the room is in one
     26  2589							; page: its two loads never do).
     27  2589
     28  2589				   throne_kernel
     29  2589		       85 02		      sta	WSYNC	; HUD line 29
     30  258b		       a5 9c		      lda	plug	; the ball: black on black
     31  258d		       85 1f		      sta	ENABL	; until the room starts
     32  258f		       a0 9f		      ldy	#159	; what line A0 of course 0
     33  2591		       84 d2		      sty	idx	; needs
     34  2593		       a9 13		      lda	#19
     35  2595		       85 d3		      sta	trow
     36  2597		       b1 cb		      lda	(cbk),y
     37  2599		       85 cf		      sta	zbk	; COLUBK of pair 0
     38  259b		       b1 cd		      lda	(cpf),y
     39  259d		       85 d0		      sta	zt	; COLUPF of pair 0
     40  259f		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     41  25a2		       85 d4		      sta	znpf0
     42  25a4		       ad a7 10 	      lda	SCR+SC_PF1+19
     43  25a7		       85 d5		      sta	znpf1
     44  25a9		       ad bb 10 	      lda	SCR+SC_PF2+19
     45  25ac		       85 0f		      sta	PF2	; unseen: COLUPF is 0
     46  25ae		       85 02		      sta	WSYNC	; line 30
     47  25b0		       b1 c3		      lda	(kgfx),y	; +
     48  25b2		       aa		      tax
     49  25b3		       b1 c7		      lda	(sgfx),y	; +
     50  25b5		       a4 d0		      ldy	zt
     51  25b7		       85 02		      sta	WSYNC	; line 31 stays empty
     52  25b9		       4c bc 55 	      jmp	t_top
     53  25bc
     54  25bc							; ---------------------------------------------------------
     55  25bc							; The room: 20 courses of 8 lines, four pairs of lines A and
     56  25bc							; B each, as in room_kernel.asm (the same macros, with
     57  25bc							; ENAM1).
     58  25bc
     59  25bc					      MAC	tline_a_rest
     60  25bc					      ldy	idx
     61  25bc					      dey
     62  25bc					      sty	idx
     63  25bc					      lda	(kcol),y	; +
     64  25bc					      sta	zt
     65  25bc					      lda	(scol),y	; +
     66  25bc					      sta	zc1
     67  25bc					      lda	(kgfx),y	; +
     68  25bc					      tax
     69  25bc					      lda	(sgfx),y	; +
     70  25bc					      ldy	zt
     71  25bc					      ENDM		; prepares line B
     72  25bc
     73  25bc					      MAC	tline_b_first
     74  25bc					      sta	GRP1	;  2
     75  25bc					      stx	GRP0	;  5
     76  25bc					      sty	COLUP0	;  8
     77  25bc					      sty	ENAM0	; 11 the blade: bit 1
     78  25bc					      lda	zc1
     79  25bc					      sta	COLUP1	; 17
     80  25bc					      sta	ENAM1	; 20 the venom: bit 1
     81  25bc					      ldy	idx
     82  25bc					      dey
     83  25bc					      sty	idx
     84  25bc					      ENDM
     85  25bc
     86  25bc					      MAC	tline_b_rest
     87  25bc					      lda	(cbk),y
     88  25bc					      sta	zbk
     89  25bc					      lda	(cpf),y
     90  25bc					      sta	zt
     91  25bc					      lda	(kgfx),y	; +
     92  25bc					      tax
     93  25bc					      lda	(sgfx),y	; +
     94  25bc					      ldy	zt
     95  25bc					      ENDM		; prepares line A
     96  25bc
     97  25bc					      MAC	tline_a_first
     98  25bc					      sta	GRP1	;  2
     99  25bc					      stx	GRP0	;  5
    100  25bc					      sty	COLUPF	;  8
    101  25bc					      lda	zbk
