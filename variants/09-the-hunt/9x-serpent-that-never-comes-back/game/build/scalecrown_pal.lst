     59  7146		       05 c2		      ora	won	; or won: an end screen
     60  7148		       d0 47		      bne	fr_ends
     61  714a		       a5 84		      lda	pressed	; the title: SELECT chooses
     62  714c		       29 02		      and	#$02	; the next sound mode
     63  714e		       f0 0b		      beq	fr_start
     64  7150		       a6 a9		      ldx	mode
     65  7152		       e8		      inx
     66  7153		       e0 03		      cpx	#3
     67  7155		       90 02		      bcc	fr_mode
     68  7157		       a2 00		      ldx	#0
