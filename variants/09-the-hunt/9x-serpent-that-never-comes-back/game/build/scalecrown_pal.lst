    189  721e							; end_score: the six digits of the score into the
    190  721e							; Superchip RAM for the end screen (bank 6): column k at
    191  721e							; 9 k, bottom first as the tables of a block: byte 0 empty,
    192  721e							; bytes 1-8 the digit (DIGITS is bottom first too)
    193  721e
    194  721e				   end_score
    195  721e		       a2 00		      ldx	#0	; X: the column's byte
    196  7220		       86 f3		      stx	tmp+1	; the digit, 0-5
    197  7222		       a5 f3	   es_dig     lda	tmp+1
    198  7224		       4a		      lsr		; C: an odd digit
    199  7225		       a8		      tay
    200  7226		       b9 86 00 	      lda	score,y
    201  7229		       b0 04		      bcs	es_lo	; odd: the low nibble
    202  722b		       4a		      lsr
    203  722c		       4a		      lsr
    204  722d		       4a		      lsr
    205  722e		       4a		      lsr
    206  722f		       29 0f	   es_lo      and	#$0F
    207  7231		       0a		      asl
    208  7232		       0a		      asl
    209  7233		       0a		      asl
    210  7234		       a8		      tay		; 8 x the digit
    211  7235		       a9 00		      lda	#0
    212  7237		       9d 00 10 	      sta	SCW,x	; the empty line
    213  723a		       a9 08		      lda	#8
    214  723c		       85 f2		      sta	tmp
    215  723e				   es_byte
    216  723e		       e8		      inx
    217  723f		       b9 00 fa 	      lda	DIGITS,y
    218  7242		       9d 00 10 	      sta	SCW,x
    219  7245		       c8		      iny
    220  7246		       c6 f2		      dec	tmp
    221  7248		       d0 f4		      bne	es_byte
    222  724a		       e8		      inx		; the next column
    223  724b		       e6 f3		      inc	tmp+1
    224  724d		       a5 f3		      lda	tmp+1
    225  724f		       c9 06		      cmp	#6
    226  7251		       d0 cf		      bne	es_dig
    227  7253		       60		      rts
