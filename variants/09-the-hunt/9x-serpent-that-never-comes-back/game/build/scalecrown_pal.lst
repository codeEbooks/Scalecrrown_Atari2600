------- FILE sound.asm LEVEL 2 PASS 2
      0  5100					      include	"sound.asm"
      1  5100							; sound.asm - bank 5: the sound player
      2  5100							;
      3  5100							; Called once a frame in the overscan, from bank 7 through
      4  5100							; the trampoline TO_SOUND (in the tail of every bank).
      5  5100							; Three modes, chosen with SELECT on the title (main.asm):
      6  5100							;   0 MUSIC	 the theme on both voices (voice 0 the bass,
      7  5100							;		 voice 1 the melody), no effects
      8  5100							;   1 SOUND FX  the effects on voice 0, voice 1 silent
      9  5100							;   2 SILENT	 nothing
     10  5100							; When the mode changes both voices are silenced, any effect
     11  5100							; stops and the music starts again from its first step.
     12  5100							;
     13  5100							; The songs: the theme (the title and the game), the
     14  5100							; lament of GAME OVER and the fanfare of VICTORY; song is
     15  5100							; 2 x the one playing. To start a song the game writes it
     16  5100							; in song and $FF in smode: the player sees a new mode and
     17  5100							; does as above (the silence after an end and after a
     18  5100							; restart: no note of what was playing goes on). The two
     19  5100							; songs of the end play once: each voice ends with a rest
     20  5100							; that loops on itself.
     21  5100							;
     22  5100							; The music (music.py makes the tables from score.py): each
     23  5100							; voice reads a stream of bytes: $FE n chooses instrument
     24  5100							; n; a note (index in NOTE_C / NOTE_F, 0 is a rest) and its
     25  5100							; length in steps; $FF goes back to the voice's loop point.
     26  5100							; A step is a sixteenth note: STEPLEN frames (NTSC 9; PAL 8
     27  5100							; and 7 in turn). The volume of a note follows its
     28  5100							; instrument's envelope, one value a frame (the last holds);
     29  5100							; the last frame of every note is silent.
     30  5100							;
     31  5100							; The effects (sfx.py): AUDC, AUDF, AUDV of each frame in
     32  5100							; three tables, an AUDC of $FF at the end. The game
     33  5100							; asks for one with sfxreq; sfxi is the frame playing.
     34  5100
     35  5100				   sound
     36  5100		       a5 a9		      lda	mode
     37  5102		       c5 aa		      cmp	smode
     38  5104		       f0 16		      beq	so_mode
     39  5106		       85 aa		      sta	smode	; a new mode: silence, the
     40  5108		       a2 00		      ldx	#0	; music from the start, no
     41  510a		       86 19		      stx	AUDV0	; effect
     42  510c		       86 1a		      stx	AUDV1
     43  510e		       86 ad		      stx	sfxi
     44  5110		       86 ae		      stx	mclock
     45  5112		       86 af		      stx	mstep
     46  5114		       86 b0		      stx	vpos
     47  5116		       86 b1		      stx	vpos+1
     48  5118		       86 b2		      stx	vleft
     49  511a		       86 b3		      stx	vleft+1
     50  511c				   so_mode
     51  511c		       a5 a9		      lda	mode
     52  511e		       f0 3a		      beq	music
     53  5120		       c9 01		      cmp	#1
     54  5122		       f0 09		      beq	effects
     55  5124		       a9 00		      lda	#0	; SILENT
     56  5126		       85 19		      sta	AUDV0
     57  5128		       85 1a		      sta	AUDV1
     58  512a		       85 ac		      sta	sfxreq
     59  512c		       60		      rts
     60  512d
     61  512d							; --- SOUND FX ---------------------------------------------
     62  512d
     63  512d				   effects
     64  512d		       a9 00		      lda	#0
     65  512f		       85 1a		      sta	AUDV1	; voice 1 rests
     66  5131		       a6 ac		      ldx	sfxreq
     67  5133		       f0 07		      beq	ef_play
     68  5135		       85 ac		      sta	sfxreq	; (A is 0)
     69  5137		       bd 10 b4 	      lda	SFX_START-1,x	; a new effect, at its start
     70  513a		       85 ad		      sta	sfxi
     71  513c				   ef_play
     72  513c		       a4 ad		      ldy	sfxi
     73  513e		       b9 1e b4 	      lda	SFX_C,y	; AUDC, or $FF at the end
     74  5141		       30 10		      bmi	ef_end
     75  5143		       85 15		      sta	AUDC0
     76  5145		       b9 ea b4 	      lda	SFX_F,y
     77  5148		       85 17		      sta	AUDF0
     78  514a		       b9 b6 b5 	      lda	SFX_V,y
     79  514d		       85 19		      sta	AUDV0
     80  514f		       c8		      iny
     81  5150		       84 ad		      sty	sfxi
     82  5152		       60		      rts
     83  5153		       a9 00	   ef_end     lda	#0
     84  5155		       85 19		      sta	AUDV0
     85  5157		       85 ad		      sta	sfxi	; frame 0: the empty effect
     86  5159		       60		      rts
     87  515a
     88  515a							; --- MUSIC ------------------------------------------------
     89  515a
     90  515a				   music
     91  515a		       a9 00		      lda	#0
     92  515c		       85 ac		      sta	sfxreq	; no effects in this mode
     93  515e		       a5 ae		      lda	mclock
     94  5160		       d0 1e		      bne	mu_frame
     95  5162		       a6 af		      ldx	mstep	; a new step
     96  5164		       bd fe b3 	      lda	STEPLEN,x
     97  5167		       85 ae		      sta	mclock
     98  5169		       e8		      inx
     99  516a		       e0 02		      cpx	#STEPS_N
    100  516c		       90 02		      bcc	mu_step
    101  516e		       a2 00		      ldx	#0
    102  5170				   mu_step
    103  5170		       86 af		      stx	mstep
    104  5172		       a2 01		      ldx	#1
    105  5174				   mu_next
    106  5174		       b5 b2		      lda	vleft,x	; voice X: its note over,
    107  5176		       d0 03		      bne	mu_dec	; the next one
    108  5178		       20 b0 b1 	      jsr	fetch
    109  517b		       d6 b2	   mu_dec     dec	vleft,x	; steps left after this one
    110  517d		       ca		      dex
    111  517e		       10 f4		      bpl	mu_next
    112  5180				   mu_frame
    113  5180		       c6 ae		      dec	mclock	; 0: a step's last frame
    114  5182		       a2 01		      ldx	#1
    115  5184		       a9 00	   mu_vol     lda	#0
    116  5186		       b4 b8		      ldy	vnote,x
    117  5188		       f0 20		      beq	mu_set	; a rest
    118  518a		       b4 b2		      ldy	vleft,x
    119  518c		       d0 04		      bne	mu_on
    120  518e		       a4 ae		      ldy	mclock
    121  5190		       f0 18		      beq	mu_set	; the last frame of the note
    122  5192		       b4 b6	   mu_on      ldy	vins,x
    123  5194		       b5 b4		      lda	venv,x
    124  5196		       d9 02 b4 	      cmp	ENV_LAST,y	; the envelope goes on until
    125  5199		       b0 04		      bcs	mu_hold	; its last value
    126  519b		       f6 b4		      inc	venv,x
    127  519d		       90 03		      bcc	mu_read	; (inc leaves C clear)
    128  519f				   mu_hold
    129  519f		       b9 02 b4 	      lda	ENV_LAST,y
    130  51a2				   mu_read
    131  51a2		       18		      clc
    132  51a3		       79 00 b4 	      adc	ENV_START,y
    133  51a6		       a8		      tay
    134  51a7		       b9 04 b4 	      lda	ENV_DATA,y
    135  51aa		       95 19	   mu_set     sta	AUDV0,x
    136  51ac		       ca		      dex
    137  51ad		       10 d5		      bpl	mu_vol
    138  51af		       60		      rts
    139  51b0
    140  51b0							; fetch: the next note of voice X, through the pointer tmp
    141  51b0							; (the stream of voice X of the song: 2 x song + X)
    142  51b0		       8a	   fetch      txa
    143  51b1		       18		      clc
    144  51b2		       65 ab		      adc	song
    145  51b4		       a8		      tay
    146  51b5		       b9 ec b3 	      lda	VS_LO,y
    147  51b8		       85 f2		      sta	tmp
    148  51ba		       b9 f2 b3 	      lda	VS_HI,y
    149  51bd		       85 f3		      sta	tmp+1
    150  51bf				   fe_byte
    151  51bf		       b4 b0		      ldy	vpos,x
    152  51c1		       b1 f2		      lda	(tmp),y
    153  51c3		       c9 fe		      cmp	#$FE
    154  51c5		       90 1a		      bcc	fe_note	; a note or a rest
    155  51c7		       f0 0d		      beq	fe_ins
    156  51c9		       8a		      txa		; $FF: to the loop point
    157  51ca		       18		      clc
    158  51cb		       65 ab		      adc	song
    159  51cd		       a8		      tay
    160  51ce		       b9 f8 b3 	      lda	VLOOP,y
    161  51d1		       95 b0		      sta	vpos,x
    162  51d3		       4c bf b1 	      jmp	fe_byte
    163  51d6		       c8	   fe_ins     iny		; $FE: an instrument
    164  51d7		       b1 f2		      lda	(tmp),y
    165  51d9		       95 b6		      sta	vins,x
    166  51db		       c8		      iny
    167  51dc		       94 b0		      sty	vpos,x
    168  51de		       4c bf b1 	      jmp	fe_byte
    169  51e1				   fe_note
    170  51e1		       95 b8		      sta	vnote,x
    171  51e3		       c8		      iny
    172  51e4		       b1 f2		      lda	(tmp),y
    173  51e6		       95 b2		      sta	vleft,x	; its steps
    174  51e8		       c8		      iny
    175  51e9		       94 b0		      sty	vpos,x
    176  51eb		       a9 00		      lda	#0
    177  51ed		       95 b4		      sta	venv,x
    178  51ef		       b4 b8		      ldy	vnote,x
