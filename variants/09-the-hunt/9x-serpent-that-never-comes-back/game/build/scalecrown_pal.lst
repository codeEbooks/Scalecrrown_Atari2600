    179  7215							; ---------------------------------------------------------
    180  7215							; theme: the theme from its first step; the player
    181  7215							; silences what was playing (a new song: smode $FF)
    182  7215
    183  7215		       a9 00	   theme      lda	#SONG_THEME
    184  7217		       85 ab		      sta	song
