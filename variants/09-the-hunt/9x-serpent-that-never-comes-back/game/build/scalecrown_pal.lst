    111  785e
    112  785e							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    113  785e							; columns read through six pointers: {1} ... {1}+10 (dig:
    114  785e							; the digits of the score; txp: the name of the level, in
    115  785e							; this bank). Called on the line before the first one.
    116  785e							; Both players are delayed (VDELP0, VDELP1) and have three
    117  785e							; copies 16 pixels apart:
    118  785e							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    119  785e							; A delayed player shows the value written before the last
    120  785e							; write to the other player, so the four writes at the end
    121  785e							; change the copies on the right while the beam is between
    122  785e							; them.
    123  785e					      MAC	hud48
    124  785e					      ldy	#7
    125  785e					      sty	zt2
    126  785e				   .loop      lda	({1}),y
    127  785e					      sta	GRP0	; column 1 (waits)
    128  785e					      sta	WSYNC
    129  785e					      lda	({1}+2),y
    130  785e					      sta	GRP1	;  7 col 2; col 1 shows
    131  785e					      lda	({1}+4),y
    132  785e					      sta	GRP0	; 15 col 3; col 2 shows
    133  785e					      lda	({1}+10),y
    134  785e					      sta	zt
    135  785e					      lda	({1}+8),y
    136  785e					      tax
    137  785e					      lda	({1}+6),y
    138  785e					      ldy	zt
    139  785e					      nop
    140  785e					      sta	GRP1	; 43 col 4; col 3 shows
    141  785e					      stx	GRP0	; 46 col 5; col 4 shows
    142  785e					      sty	GRP1	; 49 col 6; col 5 shows
    143  785e					      sta	GRP0	; 52 col 6 shows
    144  785e					      ldy	zt2
    145  785e					      dey
    146  785e					      sty	zt2
    147  785e					      bpl	.loop
    148  785e					      rts
    149  785e					      ENDM
    150  785e
    151  785e							; each routine in one page (as the blocks of the title: see
    152  785e							; title_kernel.asm); the padding comes after a jmp or an rts
    153  785e		       00 32	   HUD48_BYTES =	50
    154  785e
    155  785e				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    156  785e				  -	      ALIGN	256
    157  785e					      ENDIF
