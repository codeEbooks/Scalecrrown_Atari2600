     47  77eb		       85 02		      sta	WSYNC
     48  77ed		       88		      dey
     49  77ee		       10 ee		      bpl	hu_bar
     50  77f0		       a9 00		      lda	#0	; line 16
     51  77f2		       85 0e		      sta	PF1
     52  77f4		       85 0f		      sta	PF2
     53  77f6		       85 08		      sta	COLUPF	; the room's PF2 unseen
     54  77f8		       a9 0c		      lda	#TEXT_COL
     55  77fa		       85 06		      sta	COLUP0
     56  77fc		       85 07		      sta	COLUP1
     57  77fe		       85 02		      sta	WSYNC
     58  7800		       20 8c f8 	      jsr	hud_text	; lines 17-25: LEVEL n
     59  7803		       a5 8a		      lda	kx
     60  7805		       85 02		      sta	WSYNC	; (the end of line 25)
     61  7807							; line 26: Sir Roderick to column kx, as place does
     62  7807							; it (the stores take 4 cycles, like sta HMP0,x)
