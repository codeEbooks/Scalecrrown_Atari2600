------- FILE hud.asm LEVEL 2 PASS 2
      0  77b8					      include	"hud.asm"
      1  77b8							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  77b8							;
      3  77b8							; Entered right after the WSYNC that ends the VBLANK, at
      4  77b8							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  77b8							; lines (PAL only), then the HUD:
      6  77b8							;   lines 1-9	  the six digits of the score
      7  77b8							;   lines 12-15  the energy bar
      8  77b8							;   lines 17-25  LEVEL n
      9  77b8							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  77b8							;		  (player 1: the thing of band A; the fine
     11  77b8							;		  move of the seam waits in HMP1)
     12  77b8							; and goes on to bank 0 (room_kernel.asm) in line 28, or to
     13  77b8							; bank 2 (throne_kernel.asm) in the throne room.
     14  77b8							;
     15  77b8							; Cycle counts in the comments: the cycle at which a store
     16  77b8							; writes, counted from 0 at the start of the line.
     17  77b8
     18  77b8				   hud
     19  77b8		       a9 00		      lda	#0
     20  77ba		       85 01		      sta	VBLANK	; the picture starts
     21  77bc				  -	      IF	TOP_BLANK
     22  77bc				  -	      ldy	#TOP_BLANK
     23  77bc				  -hu_top     sta	WSYNC
     24  77bc				  -	      dey
     25  77bc				  -	      bne	hu_top
     26  77bc					      ENDIF
     27  77bc		       a9 1e		      lda	#SCORE_COL	; HUD line 0
     28  77be		       85 06		      sta	COLUP0
     29  77c0		       85 07		      sta	COLUP1
     30  77c2		       85 02		      sta	WSYNC
     31  77c4		       20 57 f8 	      jsr	hud_digits	; lines 1-9: the six digits
     32  77c7		       85 02		      sta	WSYNC	; line 10
     33  77c9		       a9 00		      lda	#0
     34  77cb		       85 1b		      sta	GRP0
     35  77cd		       85 1c		      sta	GRP1
     36  77cf		       85 1b		      sta	GRP0	; empty the delayed copies
     37  77d1		       a0 03		      ldy	#3
     38  77d3		       85 02		      sta	WSYNC	; line 11
     39  77d5		       85 02		      sta	WSYNC	; line 12
     40  77d7				   hu_bar		; lines 12-15: energy
     41  77d7		       b9 f1 f9 	      lda	BAR_COL,y
     42  77da		       85 08		      sta	COLUPF	;  6
     43  77dc		       a5 f0		      lda	bar1
     44  77de		       85 0e		      sta	PF1	; 12
