    792  75ee
    793  75ee							; place: object X (0 player 0, 1 player 1, 2 missile 0, 3
    794  75ee							; missile 1, 4 the ball) at column A: the first pixel of a
    795  75ee							; player is A + 3, of a missile or the ball A + 2. Takes one
    796  75ee							; line: the WSYNC, then 15 pixels per 5 cycles.
    797  75ee							; (its loop in one page: a branch that crosses one takes a
    798  75ee							; cycle more, and the column would be wrong; the padding
    799  75ee							; comes after an rts)
    800  75ee				  -	      IF	(* & $FF00) != ((*+8) & $FF00)
    801  75ee				  -	      ALIGN	256
    802  75ee					      ENDIF
    803  75ee				   place
    804  75ee		       85 02		      sta	WSYNC
    805  75f0		       38		      sec
    806  75f1		       e9 0f	   pl_div     sbc	#15
    807  75f3		       b0 fc		      bcs	pl_div	; (pl_div)
    808  75f5		       49 07		      eor	#7
    809  75f7		       0a		      asl
    810  75f8		       0a		      asl
    811  75f9		       0a		      asl
    812  75fa		       0a		      asl
    813  75fb		       95 20		      sta	HMP0,x
    814  75fd		       95 10		      sta	RESP0,x
    815  75ff		       60		      rts
------- FILE scalecrown.asm
------- FILE knight.asm LEVEL 2 PASS 2
      0  7600					      include	"knight.asm"
      1  7600							; knight.asm - bank 7: Sir Roderick
      2  7600							;
      3  7600							; One frame of his: while he parries the venom with his
      4  7600							; shield (things.asm starts it) he stands still and shows
      5  7600							; the parry;
      6  7600							; the button starts a thrust of the sword, during which he
      7  7600							; stands still; otherwise the joystick moves him, first
      8  7600							; left or right, then up or down, each direction tried on
      9  7600							; its own against the walls (so he slides along a wall
     10  7600							; when pushed diagonally into it). Past the edge of the
     11  7600							; screen he goes into the next room: east and west
     12  7600							; through the openings, down and up by the stairs.
     13  7600							; The speeds are in bank7.asm, one table for each
     14  7600							; television (rules.py).
     15  7600
     16  7600				  -	      IF	V_INT != 0
     17  7600				  -	      ERR		; one step at most per frame
     18  7600					      ENDIF
     19  7600				  -	      IF	STRIDE != 8
     20  7600				  -	      ERR		; the walk divides by 8
     21  7600					      ENDIF
     22  7600
