------- FILE title_kernel.asm LEVEL 2 PASS 2
      0  1100					      include	"title_kernel.asm"
      1  1100							; title_kernel.asm - bank 1: the title
      2  1100							;
      3  1100							; Entered right after the WSYNC that ends the VBLANK, at
      4  1100							; cycle 10 of the first visible line. 192 lines (PAL: 18
      5  1100							; black lines above and below):
      6  1100							;   lines 0-3	   positions of the two players
      7  1100							;   decor lines   background, playfield colour and the
      8  1100							;		   playfield of the pillars and torches, one
      9  1100							;		   line of each table per line
     10  1100							;   three blocks  the crown and the two halves of the name,
     11  1100							;		   48 pixels wide, drawn with both players;
     12  1100							;		   the decor stays as on the line before
     13  1100							;   a fourth	   the sound mode (MUSIC, SOUND FX, SILENT)
     14  1100							; Tables of the decor are from the top (index = line); the
     15  1100							; blocks are bottom first (index = lines left). The end
     16  1100							; screens (bank 6: ends_kernel.asm) use the same two
     17  1100							; macros with their own tables.
     18  1100
     19  1100		       00 34	   TITLE_X    =	52	; column of the blocks
     20  1100
     21  1100							; DECOR: lines {1} to {2}-1; colours {3}_BG, {3}_PFC, the
     22  1100							; playfield {4}_PF0-2
     23  1100					      MAC	decor
     24  1100					      ldx	#{1}
     25  1100					      ldy	{3}_BG+{1}
     26  1100				   .dl	      sta	WSYNC
     27  1100					      sty	COLUBK	;  2 (read the line before)
     28  1100					      lda	{3}_PFC,x
     29  1100					      sta	COLUPF	;  9
     30  1100					      lda	{4}_PF0,x
     31  1100					      sta	PF0	; 16
     32  1100					      lda	{4}_PF1,x
     33  1100					      sta	PF1	; 23
     34  1100					      lda	{4}_PF2,x
     35  1100					      sta	PF2	; 30
     36  1100					      inx
     37  1100					      ldy	{3}_BG,x	; + the next line
     38  1100					      cpx	#{2}
     39  1100					      bne	.dl
     40  1100					      ENDM
     41  1100
     42  1100							; A block of 48 pixels: {1} the prefix of its tables.
     43  1100							; Both players delayed, three copies each (see the HUD in
     44  1100							; hud.asm); the colour of each line is written before the
     45  1100							; block starts on that line. The block stays in one page: a
     46  1100							; branch taken to another page takes a cycle more, and the
     47  1100							; end of the line has none to spare. When it would not fit,
     48  1100							; a jmp goes over to the next page.
     49  1100		       00 3c	   BLOCK_BYTES =	60	; a block, and a little more
     50  1100
     51  1100					      MAC	block
     52  1100					      IF	((*+3) & $FF00) != ((*+3+BLOCK_BYTES) & $FF00)
     53  1100					      jmp	.go
     54  1100					      ALIGN	256
     55  1100					      ENDIF
     56  1100				   .go	      ldy	#{1}_H-1
     57  1100					      sty	zt2
     58  1100				   .bl	      lda	{1}0,y
     59  1100					      sta	GRP0	; column 1 (waits)
     60  1100					      sta	WSYNC
     61  1100					      lda	{1}_COL,y
     62  1100					      sta	COLUP0	;  6
     63  1100					      sta	COLUP1	;  9
     64  1100					      lda	{1}1,y
     65  1100					      sta	GRP1	; 16 col 2; col 1 shows
     66  1100					      lda	{1}2,y
     67  1100					      sta	GRP0	; 23 col 3; col 2 shows
     68  1100					      ldx	{1}4,y
     69  1100					      lda	{1}5,y
     70  1100					      sta	zt
     71  1100					      lda	{1}3,y
     72  1100					      ldy	zt
     73  1100					      sta	GRP1	; 44 col 4; col 3 shows
     74  1100					      stx	GRP0	; 47 col 5; col 4 shows
     75  1100					      sty	GRP1	; 50 col 6; col 5 shows
     76  1100					      sta	GRP0	; 53 col 6 shows
     77  1100					      ldy	zt2
     78  1100					      dey
     79  1100					      sty	zt2
     80  1100					      bpl	.bl
     81  1100					      ENDM
     82  1100
