    111  7857
    112  7857							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    113  7857							; columns read through six pointers: {1} ... {1}+10 (dig:
    114  7857							; the digits of the score; txp: the name of the level, in
    115  7857							; this bank). Called on the line before the first one.
    116  7857							; Both players are delayed (VDELP0, VDELP1) and have three
    117  7857							; copies 16 pixels apart:
    118  7857							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    119  7857							; A delayed player shows the value written before the last
    120  7857							; write to the other player, so the four writes at the end
    121  7857							; change the copies on the right while the beam is between
    122  7857							; them.
    123  7857					      MAC	hud48
    124  7857					      ldy	#7
    125  7857					      sty	zt2
    126  7857				   .loop      lda	({1}),y
    127  7857					      sta	GRP0	; column 1 (waits)
    128  7857					      sta	WSYNC
    129  7857					      lda	({1}+2),y
    130  7857					      sta	GRP1	;  7 col 2; col 1 shows
    131  7857					      lda	({1}+4),y
    132  7857					      sta	GRP0	; 15 col 3; col 2 shows
    133  7857					      lda	({1}+10),y
    134  7857					      sta	zt
    135  7857					      lda	({1}+8),y
    136  7857					      tax
    137  7857					      lda	({1}+6),y
    138  7857					      ldy	zt
    139  7857					      nop
    140  7857					      sta	GRP1	; 43 col 4; col 3 shows
    141  7857					      stx	GRP0	; 46 col 5; col 4 shows
    142  7857					      sty	GRP1	; 49 col 6; col 5 shows
    143  7857					      sta	GRP0	; 52 col 6 shows
    144  7857					      ldy	zt2
    145  7857					      dey
    146  7857					      sty	zt2
    147  7857					      bpl	.loop
    148  7857					      rts
    149  7857					      ENDM
    150  7857
    151  7857							; each routine in one page (as the blocks of the title: see
    152  7857							; title_kernel.asm); the padding comes after a jmp or an rts
    153  7857		       00 32	   HUD48_BYTES =	50
    154  7857
    155  7857				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    156  7857				  -	      ALIGN	256
    157  7857					      ENDIF
    158  7857				   hud_digits
