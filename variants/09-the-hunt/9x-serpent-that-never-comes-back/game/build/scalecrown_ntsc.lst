------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  0589					      include	"room_kernel.asm"
      1  0589							; room_kernel.asm - bank 0: the room
      2  0589							;
      3  0589							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  0589							; when the players have their columns for the room. Lines
      5  0589							; 29-31 of the HUD (black) switch the ball on if the room
      6  0589							; has a plug (it closes the outer opening of the rooms at
      7  0589							; the ends of a level; the ball has the colour of the
      8  0589							; playfield, the wall's) and read what the first line of
      9  0589							; the room needs; then the 160 lines of the room,
     10  0589							; BOT_BLANK
     11  0589							; black lines (PAL only); then the overscan starts and the
     12  0589							; program goes back to bank 7.
     13  0589							;
     14  0589							; Cycle counts in the comments: the cycle at which a store
     15  0589							; writes, counted from 0 at the start of the line; a "+" is
     16  0589							; a load that can take one cycle more when its address
     17  0589							; crosses a page.
     18  0589
     19  0589				   room_kernel
     20  0589		       85 02		      sta	WSYNC	; HUD line 29
     21  058b		       a5 9c		      lda	plug	; the ball: black on black
     22  058d		       85 1f		      sta	ENABL	; until the room starts
     23  058f		       a0 9f		      ldy	#159	; what line A0 of course 0
     24  0591		       84 d2		      sty	idx	; needs
     25  0593		       a9 13		      lda	#19
     26  0595		       85 d3		      sta	trow
     27  0597		       b1 cb		      lda	(cbk),y	; +
     28  0599		       85 cf		      sta	zbk	; COLUBK of pair 0
     29  059b		       b1 cd		      lda	(cpf),y	; +
     30  059d		       85 d0		      sta	zt	; COLUPF of pair 0
     31  059f		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     32  05a2		       85 d4		      sta	znpf0
     33  05a4		       ad a7 10 	      lda	SCR+SC_PF1+19
     34  05a7		       85 d5		      sta	znpf1
     35  05a9		       ad bb 10 	      lda	SCR+SC_PF2+19
     36  05ac		       85 0f		      sta	PF2	; unseen: COLUPF is 0
     37  05ae		       85 02		      sta	WSYNC	; line 30
     38  05b0		       b1 c3		      lda	(kgfx),y	; +
     39  05b2		       aa		      tax
     40  05b3		       b1 c7		      lda	(sgfx),y	; +
     41  05b5		       a4 d0		      ldy	zt
     42  05b7		       85 02		      sta	WSYNC	; line 31 stays empty
     43  05b9		       4c bc 15 	      jmp	k_top
     44  05bc
     45  05bc							; ---------------------------------------------------------
     46  05bc							; The room: 20 courses of 8 lines, each four pairs of lines
     47  05bc							; A and B. Lines A write the playfield colours, lines B the
     48  05bc							; colours of the figures; both write the two figures.
     49  05bc							;
     50  05bc							; At the start of each line (after WSYNC) the registers hold
     51  05bc							; what the line writes first:
     52  05bc							;   line A: A = GRP1, X = GRP0, Y = COLUPF
     53  05bc							;   line B: A = GRP1, X = GRP0, Y = COLUP0
     54  05bc							; The rest of the line prepares the next one; idx is the
     55  05bc							; index (159 at the top) of the line being prepared.
     56  05bc							; The playfield changes once a course: A1, A2, A3 read the
     57  05bc							; next course from the Superchip RAM, A0 writes PF0 and
     58  05bc							; PF1, the end of B3 writes PF2 (after the right half is
     59  05bc							; drawn).
     60  05bc							; Lines B also write the colour of Sir Roderick to ENAM0:
     61  05bc							; bit 1 of it turns the blade (missile 0) on or off. Only in
     62  05bc							; the thrust can it show: otherwise RESMP0 keeps it hidden,
     63  05bc							; and in the thrust the colours are zero outside the figure
     64  05bc							; and have bit 1 only on the pair of the blade (art.py).
     65  05bc
     66  05bc					      MAC	line_a_rest
     67  05bc					      ldy	idx
     68  05bc					      dey
     69  05bc					      sty	idx
     70  05bc					      lda	(kcol),y	; +
     71  05bc					      sta	zt
     72  05bc					      lda	(scol),y	; +
     73  05bc					      sta	zc1
     74  05bc					      lda	(kgfx),y	; +
     75  05bc					      tax
     76  05bc					      lda	(sgfx),y	; +
     77  05bc					      ldy	zt
     78  05bc					      ENDM		; prepares line B
     79  05bc
     80  05bc					      MAC	line_b_first
     81  05bc					      sta	GRP1	;  2
     82  05bc					      stx	GRP0	;  5
     83  05bc					      sty	COLUP0	;  8
     84  05bc					      sty	ENAM0	; 11 the blade: bit 1
     85  05bc					      lda	zc1
     86  05bc					      sta	COLUP1	; 17
     87  05bc					      ldy	idx
     88  05bc					      dey
     89  05bc					      sty	idx
     90  05bc					      ENDM
     91  05bc
     92  05bc					      MAC	line_b_rest
     93  05bc					      lda	(cbk),y	; +
     94  05bc					      sta	zbk
     95  05bc					      lda	(cpf),y	; +
     96  05bc					      sta	zt
     97  05bc					      lda	(kgfx),y	; +
     98  05bc					      tax
     99  05bc					      lda	(sgfx),y	; +
    100  05bc					      ldy	zt
    101  05bc					      ENDM		; prepares line A
    102  05bc
    103  05bc					      MAC	line_a_first
    104  05bc					      sta	GRP1	;  2
    105  05bc					      stx	GRP0	;  5
    106  05bc					      sty	COLUPF	;  8
    107  05bc					      lda	zbk
    108  05bc					      sta	COLUBK	; 14
    109  05bc					      ldx	trow
    110  05bc					      lda	SCR+{1},x
    111  05bc					      ENDM		; A1-A3: {1} = SC table
    112  05bc
