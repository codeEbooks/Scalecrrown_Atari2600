    160  71d8		       bd f8 fb 	      lda	SU_DOWN,x	; the plates: down, for the
    161  71db		       85 9f		      sta	spk	; time of the level
    162  71dd		       a9 00		      lda	#0
    163  71df		       85 a0		      sta	spup
    164  71e1		       8d 41 10 	      sta	SCW+SC_ACC	; the guards: no fraction,
    165  71e4		       a9 03		      lda	#3	; both alive,
    166  71e6		       8d 40 10 	      sta	SCW+SC_LIVE
    167  71e9		       a9 08		      lda	#8	; facing left,
    168  71eb		       8d 3e 10 	      sta	SCW+SC_SD
