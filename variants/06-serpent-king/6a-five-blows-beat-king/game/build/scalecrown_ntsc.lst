    100  774a		       a5 9b		      lda	onus
    101  774c		       85 05		      sta	NUSIZ1
    102  774e		       85 2b		      sta	HMCLR	; 43: 41 cycles after HMOVE
    103  7750		       ad c2 10 	      lda	SCR+SC_HM	; the fine move of the seam
    104  7753		       85 21		      sta	HMP1	; (its HMOVE uses it)
    105  7755		       a5 85		      lda	room	; the throne room has its
    106  7757		       c9 0f		      cmp	#THRONE_ROOM	; own kernel
    107  7759		       f0 03		      beq	hu_throne
    108  775b		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
    109  775e				   hu_throne
    110  775e		       4c b0 1f 	      jmp	TO_THRONE	; bank 2
    111  7761
    112  7761							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    113  7761							; columns read through six pointers: {1} ... {1}+10 (dig:
    114  7761							; the digits of the score; txp: the name of the level, in
    115  7761							; this bank). Called on the line before the first one.
    116  7761							; Both players are delayed (VDELP0, VDELP1) and have three
    117  7761							; copies 16 pixels apart:
    118  7761							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    119  7761							; A delayed player shows the value written before the last
    120  7761							; write to the other player, so the four writes at the end
    121  7761							; change the copies on the right while the beam is between
    122  7761							; them.
    123  7761					      MAC	hud48
    124  7761					      ldy	#7
    125  7761					      sty	zt2
    126  7761				   .loop      lda	({1}),y
    127  7761					      sta	GRP0	; column 1 (waits)
    128  7761					      sta	WSYNC
    129  7761					      lda	({1}+2),y
    130  7761					      sta	GRP1	;  7 col 2; col 1 shows
    131  7761					      lda	({1}+4),y
    132  7761					      sta	GRP0	; 15 col 3; col 2 shows
    133  7761					      lda	({1}+10),y
    134  7761					      sta	zt
    135  7761					      lda	({1}+8),y
    136  7761					      tax
    137  7761					      lda	({1}+6),y
    138  7761					      ldy	zt
    139  7761					      nop
    140  7761					      sta	GRP1	; 43 col 4; col 3 shows
    141  7761					      stx	GRP0	; 46 col 5; col 4 shows
    142  7761					      sty	GRP1	; 49 col 6; col 5 shows
    143  7761					      sta	GRP0	; 52 col 6 shows
    144  7761					      ldy	zt2
    145  7761					      dey
    146  7761					      sty	zt2
    147  7761					      bpl	.loop
    148  7761					      rts
    149  7761					      ENDM
    150  7761
    151  7761							; each routine in one page (as the blocks of the title: see
    152  7761							; title_kernel.asm); the padding comes after a jmp or an rts
    153  7761		       00 32	   HUD48_BYTES =	50
    154  7761
    155  7761				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    156  7761				  -	      ALIGN	256
    157  7761					      ENDIF
    158  7761				   hud_digits
