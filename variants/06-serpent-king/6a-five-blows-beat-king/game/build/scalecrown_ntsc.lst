     13  7779		       aa		      tax
     14  777a		       b1 cc		      lda	(dig+6),y
     15  777c		       a4 bf		      ldy	zt
     16  777e		       ea		      nop
     17  777f		       85 1c		      sta	GRP1
     18  7781		       86 1b		      stx	GRP0
     19  7783		       84 1c		      sty	GRP1
     20  7785		       85 1b		      sta	GRP0
     21  7787		       a4 de		      ldy	zt2
     22  7789		       88		      dey
