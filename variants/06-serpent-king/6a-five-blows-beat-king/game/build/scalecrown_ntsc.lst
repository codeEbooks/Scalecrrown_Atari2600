      0  7100					      include	"main.asm"
      1  7100							; main.asm - bank 7: start, the frame, and what is done
      2  7100							; in it besides the kernels:
      3  7100							; - the buttons: RESET starts again;
      4  7100							; - GAME OVER, VICTORY: the game stops;
      5  7100							; - setting a room up: its playfield comes from bank 3
      6  7100							;   into the Superchip RAM;
      7  7100							; - what the kernels need: Sir Roderick, the colours of
      8  7100							;   the room, the HUD, the bands of player 1, the King or
      9  7100							;   the crown on player 1, the venom on missile 1.
     10  7100							; In the overscan the things of the room, the guards and
     11  7100							; the Serpent King (bank 4).
     12  7100
     13  7100				   start
     14  7100		       78		      sei
     15  7101		       d8		      cld
     16  7102		       a2 00		      ldx	#0
     17  7104		       8a		      txa
     18  7105		       95 00	   clear      sta	0,x	; TIA and RAM
     19  7107		       ca		      dex
     20  7108		       d0 fb		      bne	clear
     21  710a		       ca		      dex
     22  710b		       9a		      txs		; stack at $FF
     23  710c		       a9 ff		      lda	#$FF
     24  710e		       85 82		      sta	shown	; no room set up yet
     25  7110		       20 87 f1 	      jsr	new_game	; the game at once
     26  7113		       4c 21 f1 	      jmp	main
