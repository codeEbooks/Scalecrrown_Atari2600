    134  71c5							; ---------------------------------------------------------
    135  71c5							; setup_room: when the screen changes, the playfield of
    136  71c5							; the room goes into the Superchip RAM (bank 3)
    137  71c5							; - with its door open if it is;
    138  71c5							; - the HUD gets the name of its level; the plug of the
    139  71c5							;   room is chosen;
    140  71c5							; - the plates of the spikes start down, NUSIZ1 of the
    141  71c5							;   room;
    142  71c5							; - the guards go to their start alive (the army is
    143  71c5							;   infinite);
    144  71c5							; - in the throne room the King starts again (in front
    145  71c5							;   of his throne, no blow, no venom; unless he has been
    146  71c5							;   beaten: the crown stays)
    147  71c5
    148  71c5				   setup_room
    149  71c5		       a5 81		      lda	screen
    150  71c7		       c5 82		      cmp	shown
    151  71c9		       f0 65		      beq	su_done
    152  71cb		       85 82		      sta	shown
    153  71cd		       20 e6 1f 	      jsr	TO_COPY	; bank 3: room_copy
    154  71d0				   su_copied		; the tests time the copy
    155  71d0		       a5 85		      lda	room	; the name of the level
    156  71d2		       4a		      lsr
    157  71d3		       4a		      lsr
    158  71d4		       aa		      tax
