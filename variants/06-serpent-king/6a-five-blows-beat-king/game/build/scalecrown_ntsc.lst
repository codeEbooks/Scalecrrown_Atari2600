------- FILE knight.asm LEVEL 2 PASS 2
      0  7512					      include	"knight.asm"
      1  7512							; knight.asm - bank 7: Sir Roderick
      2  7512							;
      3  7512							; One frame of his: while he parries the venom with his
      4  7512							; shield (things.asm starts it) he stands still and shows
      5  7512							; the parry;
      6  7512							; the button starts a thrust of the sword, during which he
      7  7512							; stands still; otherwise the joystick moves him, first
      8  7512							; left or right, then up or down, each direction tried on
      9  7512							; its own against the walls (so he slides along a wall
     10  7512							; when pushed diagonally into it). Past the edge of the
     11  7512							; screen he goes into the next room: east and west
     12  7512							; through the openings, down and up by the stairs.
     13  7512							; The speeds are in bank7.asm, one table for each
     14  7512							; television (rules.py).
     15  7512
     16  7512				  -	      IF	V_INT != 0
     17  7512				  -	      ERR		; one step at most per frame
     18  7512					      ENDIF
     19  7512				  -	      IF	STRIDE != 8
     20  7512				  -	      ERR		; the walk divides by 8
     21  7512					      ENDIF
     22  7512
