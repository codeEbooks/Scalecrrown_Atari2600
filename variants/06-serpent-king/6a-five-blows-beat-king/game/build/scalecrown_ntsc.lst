------- FILE hud.asm LEVEL 2 PASS 2
      0  76c2					      include	"hud.asm"
      1  76c2							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  76c2							;
      3  76c2							; Entered right after the WSYNC that ends the VBLANK, at
      4  76c2							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  76c2							; lines (PAL only), then the HUD:
      6  76c2							;   lines 1-9	  the six digits of the score
      7  76c2							;   lines 12-15  the energy bar
      8  76c2							;   lines 17-25  LEVEL n
      9  76c2							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  76c2							;		  (player 1: the thing of band A; the fine
     11  76c2							;		  move of the seam waits in HMP1)
     12  76c2							; and goes on to bank 0 (room_kernel.asm) in line 28, or to
     13  76c2							; bank 2 (throne_kernel.asm) in the throne room.
     14  76c2							;
     15  76c2							; Cycle counts in the comments: the cycle at which a store
     16  76c2							; writes, counted from 0 at the start of the line.
     17  76c2
     18  76c2				   hud
     19  76c2		       a9 00		      lda	#0
     20  76c4		       85 01		      sta	VBLANK	; the picture starts
     21  76c6				  -	      IF	TOP_BLANK
     22  76c6				  -	      ldy	#TOP_BLANK
     23  76c6				  -hu_top     sta	WSYNC
     24  76c6				  -	      dey
     25  76c6				  -	      bne	hu_top
     26  76c6					      ENDIF
     27  76c6		       a9 1e		      lda	#SCORE_COL	; HUD line 0
     28  76c8		       85 06		      sta	COLUP0
     29  76ca		       85 07		      sta	COLUP1
     30  76cc		       85 02		      sta	WSYNC
     31  76ce		       20 61 f7 	      jsr	hud_digits	; lines 1-9: the six digits
     32  76d1		       85 02		      sta	WSYNC	; line 10
     33  76d3		       a9 00		      lda	#0
     34  76d5		       85 1b		      sta	GRP0
     35  76d7		       85 1c		      sta	GRP1
     36  76d9		       85 1b		      sta	GRP0	; empty the delayed copies
     37  76db		       a0 03		      ldy	#3
     38  76dd		       85 02		      sta	WSYNC	; line 11
     39  76df		       85 02		      sta	WSYNC	; line 12
     40  76e1				   hu_bar		; lines 12-15: energy
     41  76e1		       b9 fb f8 	      lda	BAR_COL,y
     42  76e4		       85 08		      sta	COLUPF	;  6
     43  76e6		       a5 df		      lda	bar1
     44  76e8		       85 0e		      sta	PF1	; 12
     45  76ea		       a5 e0		      lda	bar2
     46  76ec		       85 0f		      sta	PF2	; 18
     47  76ee		       85 02		      sta	WSYNC
     48  76f0		       88		      dey
     49  76f1		       10 ee		      bpl	hu_bar
     50  76f3		       a9 00		      lda	#0	; line 16
     51  76f5		       85 0e		      sta	PF1
     52  76f7		       85 0f		      sta	PF2
     53  76f9		       85 08		      sta	COLUPF	; the room's PF2 unseen
     54  76fb		       a9 0a		      lda	#TEXT_COL
     55  76fd		       85 06		      sta	COLUP0
     56  76ff		       85 07		      sta	COLUP1
     57  7701		       85 02		      sta	WSYNC
     58  7703		       20 8f f7 	      jsr	hud_text	; lines 17-25: LEVEL n
     59  7706		       a5 8a		      lda	kx
     60  7708		       85 02		      sta	WSYNC	; (the end of line 25)
     61  770a							; line 26: Sir Roderick to column kx, as place does
     62  770a							; it (the stores take 4 cycles, like sta HMP0,x)
     63  770a		       38		      sec
     64  770b		       e9 0f	   hu_p0      sbc	#15
     65  770d		       b0 fc		      bcs	hu_p0	; (hu_p0)
     66  770f		       49 07		      eor	#7
     67  7711		       0a		      asl
     68  7712		       0a		      asl
     69  7713		       0a		      asl
     70  7714		       0a		      asl
     71  7715		       8d 20 00 	      sta.w	HMP0
