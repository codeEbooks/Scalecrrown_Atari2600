     32  76da				  -KSTEP_FRAC =	97
     33  76da				  -VEN_INT    =	2
     34  76da				  -VEN_FRAC   =	61
     35  76da				  -KHIT_FRAMES =	25
     36  76da				  -PARRY_FRAMES =	12
     37  76da				  -STUN_FRAMES =	25
     38  76da				  -RESPAWN_FRAMES =	200
