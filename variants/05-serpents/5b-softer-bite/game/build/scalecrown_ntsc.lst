      0  7443					      include	"knight.asm"
      1  7443							; knight.asm - bank 7: Sir Roderick
      2  7443							;
      3  7443							; the button starts a thrust of the sword, during which he
      4  7443							; stands still; otherwise the joystick moves him, first
      5  7443							; left or right, then up or down, each direction tried on
      6  7443							; its own against the walls (so he slides along a wall
      7  7443							; when pushed diagonally into it). Past the edge of the
      8  7443							; screen he goes into the next room: east and west
      9  7443							; through the openings, down and up by the stairs.
     10  7443							; The speeds are in bank7.asm, one table for each
     11  7443							; television (rules.py).
     12  7443
     13  7443				  -	      IF	V_INT != 0
     14  7443				  -	      ERR		; one step at most per frame
     15  7443					      ENDIF
     16  7443				  -	      IF	STRIDE != 8
     17  7443				  -	      ERR		; the walk divides by 8
     18  7443					      ENDIF
