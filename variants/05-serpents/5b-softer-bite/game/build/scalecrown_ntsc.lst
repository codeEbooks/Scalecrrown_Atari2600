    155  71d7		       a9 03		      lda	#3	; both alive,
    156  71d9		       8d 40 10 	      sta	SCW+SC_LIVE
    157  71dc		       a9 08		      lda	#8	; facing left,
    158  71de		       8d 3e 10 	      sta	SCW+SC_SD
    159  71e1		       8d 3f 10 	      sta	SCW+SC_SD+1
    160  71e4		       a6 85		      ldx	room
    161  71e6		       bd 6e f7 	      lda	S_X,x	; at their start (the first:
    162  71e9		       8d 3c 10 	      sta	SCW+SC_SX	; its coarse column and fine
    163  71ec		       bd 7e f7 	      lda	S_X+16,x	; move for the seam, as
    164  71ef		       8d 3d 10 	      sta	SCW+SC_SX+1	; things.asm keeps them)
    165  71f2		       bd 8e f7 	      lda	S_CO,x
