    183  7537							; ---------------------------------------------------------
    184  7537							; box_free: carry clear if Sir Roderick fits at column nx,
    185  7537							; top line ny: no block under his 8 x 24 box is stone. The
    186  7537							; box touches block columns (nx + 3) / 8 and (nx + 10) / 8,
    187  7537							; block rows ny / 16, (ny + 12) / 16 and (ny + 23) / 16
    188  7537							; (24 lines can touch three rows of 16, never four).
    189  7537
    190  7537				   box_free
    191  7537		       a5 a3		      lda	nx
    192  7539		       18		      clc
    193  753a		       69 03		      adc	#FIRST_PIXEL
    194  753c		       4a		      lsr
    195  753d		       4a		      lsr
    196  753e		       4a		      lsr
    197  753f		       85 a5		      sta	bc0	; left edge
    198  7541		       a5 a3		      lda	nx
    199  7543		       18		      clc
    200  7544		       69 0a		      adc	#FIRST_PIXEL+KNIGHT_W-1
    201  7546		       4a		      lsr
    202  7547		       4a		      lsr
    203  7548		       4a		      lsr
    204  7549		       85 a6		      sta	bc1	; right edge
    205  754b		       a5 a4		      lda	ny
    206  754d		       20 61 f5 	      jsr	bf_row	; top line
    207  7550		       b0 2b		      bcs	bf_done
    208  7552		       a5 a4		      lda	ny
    209  7554		       18		      clc
    210  7555		       69 0c		      adc	#KNIGHT_H/2
    211  7557		       20 61 f5 	      jsr	bf_row	; middle
    212  755a		       b0 21		      bcs	bf_done
    213  755c		       a5 a4		      lda	ny
    214  755e		       18		      clc
    215  755f		       69 17		      adc	#KNIGHT_H-1	; bottom line, and back
    216  7561		       4a	   bf_row     lsr		; A: a line of the box
    217  7562		       4a		      lsr
    218  7563		       4a		      lsr
    219  7564		       4a		      lsr		; its block row (0-9)
    220  7565		       85 a7		      sta	br
    221  7567		       0a		      asl		; (clears the carry)
    222  7568		       65 a7		      adc	br
    223  756a		       85 a7		      sta	br	; 3 x the row: its byte 0
    224  756c		       a5 a5		      lda	bc0
    225  756e		       20 7e f5 	      jsr	wall
    226  7571		       d0 09		      bne	bf_stone
    227  7573		       a5 a6		      lda	bc1
    228  7575		       20 7e f5 	      jsr	wall
    229  7578		       d0 02		      bne	bf_stone
    230  757a		       18		      clc		; free
    231  757b		       60		      rts
    232  757c				   bf_stone
    233  757c		       38		      sec
    234  757d				   bf_done
    235  757d		       60		      rts
    236  757e
    237  757e							; wall: Z clear (bne) if block column A (0-19) is stone in
    238  757e							; the block row whose first byte is br. The collision map
    239  757e							; has three bytes a row, the whole width (the plug closes
    240  757e							; one side only): columns 0-7 in the first byte, 8-15 in
    241  757e							; the second, 16-19 in the third, the first column in
    242  757e							; bit 7.
    243  757e		       aa	   wall       tax		; the column
    244  757f		       4a		      lsr
    245  7580		       4a		      lsr
    246  7581		       4a		      lsr		; its byte in the row, 0-2
    247  7582		       18		      clc
    248  7583		       65 a7		      adc	br
    249  7585		       a8		      tay
    250  7586		       8a		      txa
    251  7587		       29 07		      and	#7	; its bit
    252  7589		       aa		      tax
    253  758a		       b1 a1		      lda	(cmap),y
    254  758c		       3d 90 f5 	      and	BITS,x
    255  758f		       60		      rts
    256  7590
    257  7590		       80 40 20 10*BITS       .byte.b	$80, $40, $20, $10, $08, $04, $02, $01
    258  7598
    259  7598							; ---------------------------------------------------------
    260  7598							; blade: where missile 0 goes. In the thrust it is 8 pixels
    261  7598							; beside the hand: right of the figure facing right, left
    262  7598							; of it facing left; near the edge of the screen 4, 2 or 1
    263  7598							; (NUSIZ0 bits 4-5). Otherwise it is hidden: RESMP0 = 2
    264  7598							; keeps it on player 0, switched off.
    265  7598
    266  7598				   blade
    267  7598		       a9 02		      lda	#2
    268  759a		       85 95		      sta	swres	; hidden
    269  759c		       a5 8d		      lda	kpose
    270  759e		       c9 03		      cmp	#THRUST_POSE
    271  75a0		       d0 41		      bne	bl_done
    272  75a2		       a2 03		      ldx	#3	; width: 8 pixels
    273  75a4		       a5 8c		      lda	kdir
    274  75a6		       d0 1a		      bne	bl_left
    275  75a8		       a5 8a		      lda	kx	; first pixel right of him
    276  75aa		       18		      clc
    277  75ab		       69 0b		      adc	#FIRST_PIXEL+KNIGHT_W
    278  75ad		       c9 a0		      cmp	#160
    279  75af		       b0 32		      bcs	bl_done	; no room at all: hidden
    280  75b1		       c9 99		      cmp	#160-7
    281  75b3		       90 1c		      bcc	bl_set	; 8 pixels
    282  75b5		       ca		      dex
    283  75b6		       c9 9d		      cmp	#160-3
    284  75b8		       90 17		      bcc	bl_set	; 4
    285  75ba		       ca		      dex
    286  75bb		       c9 9f		      cmp	#160-1
    287  75bd		       90 12		      bcc	bl_set	; 2
    288  75bf		       ca		      dex		; 1
    289  75c0		       b0 0f		      bcs	bl_set
    290  75c2				   bl_left		; it ends at pixel kx + 2
    291  75c2		       a5 8a		      lda	kx
    292  75c4		       38		      sec
    293  75c5		       e9 05		      sbc	#KNIGHT_W-FIRST_PIXEL
    294  75c7		       b0 08		      bcs	bl_set	; 8 pixels from kx - 5
    295  75c9		       ca		      dex
    296  75ca		       69 04		      adc	#4	; kx - 1 (carry clear)
    297  75cc		       b0 03		      bcs	bl_set	; 4 pixels, if kx >= 1
    298  75ce		       ca		      dex
    299  75cf		       a9 01		      lda	#1	; kx = 0: 2 pixels, 1 and 2
    300  75d1				   bl_set		; A: first pixel, X: width
    301  75d1		       38		      sec
    302  75d2		       e9 02		      sbc	#M_OFFSET	; the column that puts it
    303  75d4		       b0 02		      bcs	bl_col	; there
    304  75d6		       69 a0		      adc	#160	; (round the screen)
    305  75d8		       85 93	   bl_col     sta	swx
    306  75da		       bd e4 f5 	      lda	BLADE_NUS,x
    307  75dd		       85 94		      sta	swnus
    308  75df		       a9 00		      lda	#0
    309  75e1		       85 95		      sta	swres	; shown
    310  75e3				   bl_done
    311  75e3		       60		      rts
    312  75e4
    313  75e4		       00 10 20 30 BLADE_NUS  .byte.b	$00, $10, $20, $30	; 1, 2, 4, 8 pixels
------- FILE scalecrown.asm
------- FILE hud.asm LEVEL 2 PASS 2
      0  75e8					      include	"hud.asm"
      1  75e8							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  75e8							;
      3  75e8							; Entered right after the WSYNC that ends the VBLANK, at
      4  75e8							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  75e8							; lines (PAL only), then the HUD:
      6  75e8							;   lines 1-9	  the six digits of the score
      7  75e8							;   lines 12-15  the energy bar
      8  75e8							;   lines 17-25  LEVEL n
      9  75e8							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  75e8							;		  (player 1: the thing of band A; the fine
     11  75e8							;		  move of the seam waits in HMP1)
     12  75e8							; and goes on to bank 0 (room_kernel.asm) in line 28.
     13  75e8							;
     14  75e8							; Cycle counts in the comments: the cycle at which a store
     15  75e8							; writes, counted from 0 at the start of the line.
     16  75e8
     17  75e8				   hud
     18  75e8		       a9 00		      lda	#0
     19  75ea		       85 01		      sta	VBLANK	; the picture starts
     20  75ec				  -	      IF	TOP_BLANK
     21  75ec				  -	      ldy	#TOP_BLANK
     22  75ec				  -hu_top     sta	WSYNC
     23  75ec				  -	      dey
     24  75ec				  -	      bne	hu_top
     25  75ec					      ENDIF
     26  75ec		       a9 1e		      lda	#SCORE_COL	; HUD line 0
     27  75ee		       85 06		      sta	COLUP0
     28  75f0		       85 07		      sta	COLUP1
     29  75f2		       85 02		      sta	WSYNC
     30  75f4		       20 7e f6 	      jsr	hud_digits	; lines 1-9: the six digits
     31  75f7		       85 02		      sta	WSYNC	; line 10
     32  75f9		       a9 00		      lda	#0
     33  75fb		       85 1b		      sta	GRP0
     34  75fd		       85 1c		      sta	GRP1
     35  75ff		       85 1b		      sta	GRP0	; empty the delayed copies
     36  7601		       a0 03		      ldy	#3
     37  7603		       85 02		      sta	WSYNC	; line 11
     38  7605		       85 02		      sta	WSYNC	; line 12
     39  7607				   hu_bar		; lines 12-15: energy
     40  7607		       b9 12 f8 	      lda	BAR_COL,y
     41  760a		       85 08		      sta	COLUPF	;  6
     42  760c		       a5 dd		      lda	bar1
     43  760e		       85 0e		      sta	PF1	; 12
     44  7610		       a5 de		      lda	bar2
     45  7612		       85 0f		      sta	PF2	; 18
     46  7614		       85 02		      sta	WSYNC
     47  7616		       88		      dey
     48  7617		       10 ee		      bpl	hu_bar
     49  7619		       a9 00		      lda	#0	; line 16
     50  761b		       85 0e		      sta	PF1
     51  761d		       85 0f		      sta	PF2
     52  761f		       85 08		      sta	COLUPF	; the room's PF2 unseen
     53  7621		       a9 0a		      lda	#TEXT_COL
     54  7623		       85 06		      sta	COLUP0
     55  7625		       85 07		      sta	COLUP1
     56  7627		       85 02		      sta	WSYNC
     57  7629		       20 ac f6 	      jsr	hud_text	; lines 17-25: LEVEL n
     58  762c		       a5 8a		      lda	kx
     59  762e		       85 02		      sta	WSYNC	; (the end of line 25)
     60  7630							; line 26: Sir Roderick to column kx, as place does
     61  7630							; it (the stores take 4 cycles, like sta HMP0,x)
     62  7630		       38		      sec
     63  7631		       e9 0f	   hu_p0      sbc	#15
     64  7633		       b0 fc		      bcs	hu_p0	; (hu_p0)
     65  7635		       49 07		      eor	#7
     66  7637		       0a		      asl
     67  7638		       0a		      asl
     68  7639		       0a		      asl
     69  763a		       0a		      asl
     70  763b		       8d 20 00 	      sta.w	HMP0
     71  763e		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     72  7641		       a5 96		      lda	ox
     73  7643		       85 02		      sta	WSYNC	; 73 at most
     74  7645							; line 27: player 1 to column ox
     75  7645		       38		      sec
     76  7646		       e9 0f	   hu_p1      sbc	#15
     77  7648		       b0 fc		      bcs	hu_p1	; (hu_p1)
     78  764a		       49 07		      eor	#7
     79  764c		       0a		      asl
     80  764d		       0a		      asl
     81  764e		       0a		      asl
     82  764f		       0a		      asl
     83  7650		       8d 21 00 	      sta.w	HMP1
     84  7653		       8d 11 00 	      sta.w	RESP1
     85  7656		       85 02		      sta	WSYNC
     86  7658							; line 28: the fine moves, the room's settings
     87  7658		       85 2a		      sta	HMOVE	;  2
     88  765a		       a5 8c		      lda	kdir
     89  765c		       85 0b		      sta	REFP0
     90  765e		       a5 98		      lda	odir
     91  7660		       85 0c		      sta	REFP1
     92  7662		       a9 00		      lda	#0
     93  7664		       85 25		      sta	VDELP0
     94  7666		       85 26		      sta	VDELP1
     95  7668		       85 06		      sta	COLUP0
     96  766a		       85 07		      sta	COLUP1
     97  766c		       a5 94		      lda	swnus
     98  766e		       85 04		      sta	NUSIZ0	; the width of the blade
     99  7670		       a5 9a		      lda	onus
    100  7672		       85 05		      sta	NUSIZ1
    101  7674		       85 2b		      sta	HMCLR	; 43: 41 cycles after HMOVE
    102  7676		       ad c2 10 	      lda	SCR+SC_HM	; the fine move of the seam
    103  7679		       85 21		      sta	HMP1	; (its HMOVE uses it)
    104  767b		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
    105  767e
    106  767e							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    107  767e							; columns read through six pointers: {1} ... {1}+10 (dig:
    108  767e							; the digits of the score; txp: the name of the level, in
    109  767e							; this bank). Called on the line before the first one.
    110  767e							; Both players are delayed (VDELP0, VDELP1) and have three
    111  767e							; copies 16 pixels apart:
    112  767e							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    113  767e							; A delayed player shows the value written before the last
    114  767e							; write to the other player, so the four writes at the end
    115  767e							; change the copies on the right while the beam is between
    116  767e							; them.
    117  767e					      MAC	hud48
    118  767e					      ldy	#7
    119  767e					      sty	zt2
    120  767e				   .loop      lda	({1}),y
    121  767e					      sta	GRP0	; column 1 (waits)
    122  767e					      sta	WSYNC
    123  767e					      lda	({1}+2),y
    124  767e					      sta	GRP1	;  7 col 2; col 1 shows
    125  767e					      lda	({1}+4),y
    126  767e					      sta	GRP0	; 15 col 3; col 2 shows
    127  767e					      lda	({1}+10),y
    128  767e					      sta	zt
    129  767e					      lda	({1}+8),y
    130  767e					      tax
    131  767e					      lda	({1}+6),y
    132  767e					      ldy	zt
    133  767e					      nop
    134  767e					      sta	GRP1	; 43 col 4; col 3 shows
    135  767e					      stx	GRP0	; 46 col 5; col 4 shows
    136  767e					      sty	GRP1	; 49 col 6; col 5 shows
    137  767e					      sta	GRP0	; 52 col 6 shows
    138  767e					      ldy	zt2
    139  767e					      dey
    140  767e					      sty	zt2
    141  767e					      bpl	.loop
    142  767e					      rts
    143  767e					      ENDM
    144  767e
    145  767e							; each routine in one page (as the blocks of the title: see
    146  767e							; title_kernel.asm); the padding comes after a jmp or an rts
    147  767e		       00 32	   HUD48_BYTES =	50
    148  767e
    149  767e				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    150  767e				  -	      ALIGN	256
    151  767e					      ENDIF
    152  767e				   hud_digits
      0  767e					      HUD48	dig
      1  767e		       a0 07		      ldy	#7
      2  7680		       84 dc		      sty	zt2
      3  7682		       b1 c4	   .loop      lda	(dig),y
      4  7684		       85 1b		      sta	GRP0
      5  7686		       85 02		      sta	WSYNC
      6  7688		       b1 c6		      lda	(dig+2),y
      7  768a		       85 1c		      sta	GRP1
      8  768c		       b1 c8		      lda	(dig+4),y
      9  768e		       85 1b		      sta	GRP0
     10  7690		       b1 ce		      lda	(dig+10),y
     11  7692		       85 bd		      sta	zt
     12  7694		       b1 cc		      lda	(dig+8),y
     13  7696		       aa		      tax
     14  7697		       b1 ca		      lda	(dig+6),y
     15  7699		       a4 bd		      ldy	zt
     16  769b		       ea		      nop
     17  769c		       85 1c		      sta	GRP1
     18  769e		       86 1b		      stx	GRP0
     19  76a0		       84 1c		      sty	GRP1
     20  76a2		       85 1b		      sta	GRP0
     21  76a4		       a4 dc		      ldy	zt2
     22  76a6		       88		      dey
     23  76a7		       84 dc		      sty	zt2
     24  76a9		       10 d7		      bpl	.loop
     25  76ab		       60		      rts
    154  76ac				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    155  76ac				  -	      ALIGN	256
    156  76ac					      ENDIF
    157  76ac				   hud_text
      0  76ac					      HUD48	txp
      1  76ac		       a0 07		      ldy	#7
      2  76ae		       84 dc		      sty	zt2
      3  76b0		       b1 d0	   .loop      lda	(txp),y
      4  76b2		       85 1b		      sta	GRP0
      5  76b4		       85 02		      sta	WSYNC
      6  76b6		       b1 d2		      lda	(txp+2),y
      7  76b8		       85 1c		      sta	GRP1
      8  76ba		       b1 d4		      lda	(txp+4),y
      9  76bc		       85 1b		      sta	GRP0
     10  76be		       b1 da		      lda	(txp+10),y
     11  76c0		       85 bd		      sta	zt
     12  76c2		       b1 d8		      lda	(txp+8),y
     13  76c4		       aa		      tax
     14  76c5		       b1 d6		      lda	(txp+6),y
     15  76c7		       a4 bd		      ldy	zt
     16  76c9		       ea		      nop
     17  76ca		       85 1c		      sta	GRP1
     18  76cc		       86 1b		      stx	GRP0
     19  76ce		       84 1c		      sty	GRP1
     20  76d0		       85 1b		      sta	GRP0
     21  76d2		       a4 dc		      ldy	zt2
     22  76d4		       88		      dey
     23  76d5		       84 dc		      sty	zt2
     24  76d7		       10 d7		      bpl	.loop
     25  76d9		       60		      rts
