      7  76da		       00 00	   H_FRAC     =	0
      8  76da		       00 00	   V_INT      =	0
      9  76da		       00 cd	   V_FRAC     =	205
     10  76da		       00 0c	   THRUST_FRAMES =	12
     11  76da		       00 3c	   BITE_FRAMES =	60
     12  76da		       00 3c	   GO_FRAMES  =	60
     13  76da		       00 51	   KSTEP_FRAC =	81
     14  76da		       00 01	   VEN_INT    =	1
     15  76da		       00 de	   VEN_FRAC   =	222
     16  76da		       00 1e	   KHIT_FRAMES =	30
     17  76da		       00 0f	   PARRY_FRAMES =	15
     18  76da		       00 1e	   STUN_FRAMES =	30
