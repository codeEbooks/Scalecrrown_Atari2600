------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 5 of the chain of the book: the serpents
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four
      7  8000 ????						; levels (dungeon.py).
      8  8000 ????						; The joystick moves him, the walls stop him, the button
      9  8000 ????						; thrusts the sword; RESET starts again.
     10  8000 ????						; The openings east and west lead to the rooms beside, the
     11  8000 ????						; stairs to the level below and back; the ball closes the
     12  8000 ????						; outer side of the rooms at the ends of a level. The HUD:
     13  8000 ????						; the score, the energy, the name of the level.
     14  8000 ????						; The things: a chest in each level gives the key of the
     15  8000 ????						; level's door (a grate on the stair down; the golden gate
     16  8000 ????						; before the throne room); spikes go up and down in eight
     17  8000 ????						; rooms; points for chests and doors.
     18  8000 ????						; The serpents: one or two in a room, crawling to and fro,
     19  8000 ????						; faster in the lower levels; a bite takes energy, and so
     20  8000 ????						; do the spikes; a wound makes him flash; energy 0: GAME
     21  8000 ????						; OVER.
     22  8000 ????						; A thrust of the sword kills a serpent (they are back
     23  8000 ????						; when he comes in again).
     24  8000 ????						; Player 1 shows two things: the kernel moves it in the
     25  8000 ????						; middle of the room (the seam) to the serpent of the band
     26  8000 ????						; below; two things in the same lines take turns.
     27  8000 ????						; After GAME OVER or VICTORY the game stops; RESET
     28  8000 ????						; starts again.
     29  8000 ????						;
     30  8000 ????						; Banks (the address of each one for the 6507):
     31  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     32  8000 ????						;   1 ($3000) the title: only its tail before step 8
     33  8000 ????						;   2 ($5000) the throne room: only its tail before
     34  8000 ????						;	       step 6
     35  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     36  8000 ????						;   4 ($9000) the things: chests, doors, spikes
     37  8000 ????						;	       the serpents, the Serpent King
     38  8000 ????						;   5 ($B000) sound: only its tail before step 7
     39  8000 ????						;   6 ($D000) the end screens: only its tail before
     40  8000 ????						;	       step 8
     41  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     42  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     43  8000 ????						; window and ends with the same tail (trampolines, reset).
     44  8000 ????						;
     45  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     46  8000 ????						;	  [-DPAL=1]
     47  8000 ????
     48  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 11	   RESP1      =	$11	; any write: player 1 starts here
     24  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     25  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here
     26  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     27  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1
     28  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     29  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on
     30  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     31  8000 ????	       00 21	   HMP1       =	$21	; fine move of player 1
     32  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     33  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball
     34  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed
     35  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed
     36  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     37  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     38  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves
     39  8000 ????
     40  8000 ????						; TIA, read side
     41  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     42  8000 ????
     43  8000 ????						; RIOT
     44  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     45  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     46  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     47  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     50  8000 ????
     51  8000 ????			  -	      IFNCONST	PAL
     52  8000 ????			  -PAL	      =	0
     53  8000 ????				      ENDIF
     54  8000 ????
     55  8000 ????			  -	      IF	PAL
     56  8000 ????			  -TOP_BLANK  =	18	; black lines above the HUD
     57  8000 ????			  -BOT_BLANK  =	18	; and below the room
     58  8000 ????			  -VBLANK_TIM =	54
     59  8000 ????			  -OVER_TIM   =	43
     60  8000 ????				      ELSE
     61  8000 ????	       00 00	   TOP_BLANK  =	0
     62  8000 ????	       00 00	   BOT_BLANK  =	0
     63  8000 ????	       00 2c	   VBLANK_TIM =	44
     64  8000 ????	       00 23	   OVER_TIM   =	35
     65  8000 ????				      ENDIF
     66  8000 ????
     67  8000 ????						; F4: an access to $1FF4 + n selects bank n
     68  8000 ????	       1f f4	   F4B0       =	$1FF4
     69  8000 ????	       1f f5	   F4B1       =	$1FF5
     70  8000 ????	       1f f6	   F4B2       =	$1FF6
     71  8000 ????	       1f f7	   F4B3       =	$1FF7
     72  8000 ????	       1f f8	   F4B4       =	$1FF8
     73  8000 ????	       1f f9	   F4B5       =	$1FF9
     74  8000 ????	       1f fa	   F4B6       =	$1FFA
     75  8000 ????	       1f fb	   F4B7       =	$1FFB
     76  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     77  8000 ????	       10 00	   SCW	      =	$1000
     78  8000 ????	       10 80	   SCR	      =	$1080
     79  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     80  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     81  8000 ????	       00 28	   SC_PF2     =	40
     82  8000 ????	       00 3c	   SC_SX      =	60	; the guards: columns (two),
     83  8000 ????	       00 3e	   SC_SD      =	62	; facing: 0 right, 8 left (two),
     84  8000 ????	       00 40	   SC_LIVE    =	64	; alive: bit 0 the first, bit 1 the
     85  8000 ????						; second;
     86  8000 ????	       00 41	   SC_ACC     =	65	; the fraction of their crawl (the
     87  8000 ????						; King's steps);
     88  8000 ????	       00 42	   SC_HM      =	66	; HMP1 for the seam (the fine move)
     89  8000 ????
     90  8000 ????						; trampolines, the same addresses in every bank
     91  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
     92  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
     93  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
     94  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
     95  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
     96  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
     97  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
     98  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
     99  8000 ????
    100  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD
    101  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
    102  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
    103  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
    104  8000 ????	       00 18	   KNIGHT_H   =	24
    105  8000 ????
    106  8000 ????						; ---------------------------------------------------------
    107  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
    108  8000 ????						;
    109  8000 ????						; Every variable has one owner, the part of the program
    110  8000 ????						; that writes it (the others read it); the groups below say
    111  8000 ????						; which.
    112  8000 ????
    113 U00e1 ????				      SEG.U	ram
    114 U0080					      ORG	$80
    115 U0080							; == state (main.asm): frame, screens, buttons, the game
    116 U0080							; == (knight.asm changes room and screen on the way out)
    117 U0080		       00	   frames     ds	1	; frame counter
    118 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
    119 U0082		       00	   shown      ds	1	; the screen set up in the SC
    120 U0083		       00	   held       ds	1	; buttons down a frame ago
    121 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
    122 U0085							; RESET $01
    123 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    124 U0086		       00 00 00    score      ds	3	; BCD, six digits (things.asm
    125 U0089							; adds the points)
    126 U0089		       00	   energy     ds	1	; 0-12 (things.asm: the wounds)
    127 U008a							; == Sir Roderick (knight.asm)
    128 U008a		       00	   kx	      ds	1	; column, 0-149
    129 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    130 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    131 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    132 U008e		       00	   kdist      ds	1	; units walked: pose of the walk
    133 U008f		       00	   hacc       ds	1	; fraction of a step: sideways,
    134 U0090		       00	   vacc       ds	1	; up and down
    135 U0091		       00	   thrust     ds	1	; frames of the thrust still to go
    136 U0092		       00	   moved      ds	1	; he moved in this frame
    137 U0093		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    138 U0094		       00	   swnus      ds	1
    139 U0095		       00	   swres      ds	1
    140 U0096							; == player 1, the plug (main.asm: setup_room,
    141 U0096							; == p1_bands: the thing of band A)
    142 U0096		       00	   ox	      ds	1	; column
    143 U0097		       00	   oy	      ds	1	; top line (odd)
    144 U0098		       00	   odir       ds	1	; 0 right, 8 left (REFP1)
    145 U0099		       00	   okind      ds	1	; first frame in the OG tables
    146 U009a		       00	   onus       ds	1	; NUSIZ1 in the room
    147 U009b		       00	   plug       ds	1	; ENABL in the room: 2 the ball
    148 U009c							; == the things (things.asm; new_game and setup_room
    149 U009c							; == start them)
    150 U009c		       00	   key	      ds	1	; the key he has: its level, 0 none
    151 U009d		       00	   opened     ds	1	; open: chests bits 0-3, doors 4-7
    152 U009e		       00	   spk	      ds	1	; frames left before the plates turn
    153 U009f		       00	   spup       ds	1	; the plates: 0 down, 1 up
    154 U00a0		       00	   hurt       ds	1	; frames before a wound can come
    155 U00a1							; again (the spikes, a bite)
    156 U00a1							; == the collision test (knight.asm: box_free, wall)
    157 U00a1		       00 00	   cmap       ds	2	; collision map of the room
    158 U00a3							; (main.asm: room_state)
    159 U00a3		       00	   nx	      ds	1	; the box tried: column, top line
    160 U00a4		       00	   ny	      ds	1
    161 U00a5		       00	   bc0	      ds	1	; its block columns, left, right
    162 U00a6		       00	   bc1	      ds	1
    163 U00a7		       00	   br	      ds	1	; 3 x the block row tested (its
    164 U00a8							; first byte in the map)
    165 U00a8							; == the seam of player 1 (main.asm prepares;
    166 U00a8							; == room_kernel.asm)
    167 U00a8		       00	   zcnt       ds	1	; courses to the seam (0: none)
    168 U00a9		       00	   zcoarse    ds	1	; the delay before RESP1 there
    169 U00aa		       00	   zref       ds	1	; REFP1 below the seam
    170 U00ab		       00 00	   s2gfx      ds	2	; player 1 below the seam: graphics,
    171 U00ad		       00 00	   s2col      ds	2	; colours
    172 U00af							; == GAME OVER, VICTORY (things.asm sets them)
    173 U00af		       00	   over       ds	1	; 0 playing, 1 GAME OVER
    174 U00b0							; == the kernels (main.asm prepares; room_kernel.asm)
    175 U00b0		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    176 U00b2		       00 00	   kcol       ds	2
    177 U00b4		       00 00	   sgfx       ds	2	; player 1: graphics, colours
    178 U00b6		       00 00	   scol       ds	2
    179 U00b8		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    180 U00ba		       00 00	   cpf	      ds	2
    181 U00bc		       00	   zbk	      ds	1	; COLUBK of the next line A
    182 U00bd		       00	   zt	      ds	1	; colour for Y at the end of a line
    183 U00be		       00	   zc1	      ds	1	; COLUP1 of the next line B
    184 U00bf		       00	   idx	      ds	1	; index of the line being prepared
    185 U00c0		       00	   trow       ds	1	; Superchip index of the next course
    186 U00c1		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    187 U00c2		       00	   znpf1      ds	1
    188 U00c3		       00	   znpf2      ds	1
    189 U00c4							; == the HUD (main.asm prepares; hud.asm)
    190 U00c4		       00 00 00 00*dig	      ds	12	; the six columns of digits
    191 U00d0		       00 00 00 00*txp	      ds	12	; and of the name of the level
    192 U00dc		       00	   zt2	      ds	1
    193 U00dd		       00	   bar1       ds	1	; energy bar: PF1, PF2
    194 U00de		       00	   bar2       ds	1
    195 U00df							; == scratch (anyone; never kept across a call; the room
    196 U00df							; == kernel keeps a value of the seam in tmp)
    197 U00df		       00 00	   tmp	      ds	2
    198 U00e1				   ram_end
    199 U00e1
    200 U00e1							; ---------------------------------------------------------
    201 U00e1							; the banks
    202 U00e1
    203 U00e1					      MAC	bank
    204 U00e1					      SEG	bank{1}
    205 U00e1					      ORG	{1}*$1000
    206 U00e1					      RORG	$1000+{1}*$2000
    207 U00e1					      ds	256, 0	; the Superchip window
    208 U00e1					      ENDM		; {1}: bank number
    209 U00e1
    210 U00e1					      MAC	tail
    211 U00e1					      ORG	{1}*$1000+$FAA
    212 U00e1					      RORG	$1FAA+{1}*$2000
    213 U00e1					      sta	F4B6	; $FAA: to the end screens
    214 U00e1					      jmp	ends_kernel
    215 U00e1					      sta	F4B2	; $FB0: to the throne kernel
    216 U00e1					      jmp	throne_kernel
    217 U00e1					      sta	F4B4	; $FB6: (jsr here) bank 4
    218 U00e1					      jsr	things	; $FB9: in bank 4
    219 U00e1					      sta	F4B7	; $FBC: bank 7 again
    220 U00e1					      rts		; $FBF: in bank 7
    221 U00e1					      sta	F4B0	; $FC0: to the room kernel
    222 U00e1					      jmp	room_kernel
    223 U00e1					      sta	F4B1	; $FC6: to the title kernel
    224 U00e1					      jmp	title_kernel
    225 U00e1					      sta	F4B7	; $FCC: back to the frame
    226 U00e1					      jmp	kernel_done
    227 U00e1					      sta	F4B5	; $FD2: (jsr here) bank 5
    228 U00e1					      jsr	sound	; $FD5: in bank 5
    229 U00e1					      sta	F4B7	; $FD8: bank 7 again
    230 U00e1					      rts		; $FDB: in bank 7
    231 U00e1					      ORG	{1}*$1000+$FE0
    232 U00e1					      RORG	$1FE0+{1}*$2000
    233 U00e1					      sta	F4B7	; $FE0: reset, in any bank
    234 U00e1					      jmp	start
    235 U00e1					      sta	F4B3	; $FE6: (jsr here) bank 3
    236 U00e1					      jsr	room_copy	; $FE9: in bank 3
    237 U00e1					      sta	F4B7	; $FEC: bank 7 again
    238 U00e1					      rts		; $FEF: in bank 7
    239 U00e1					      ORG	{1}*$1000+$FFC
    240 U00e1					      RORG	$1FFC+{1}*$2000
    241 U00e1					      .word	$1FE0+{1}*$2000
    242 U00e1					      .word	$1FE0+{1}*$2000
    243 U00e1					      ENDM		; {1}: bank number
    244 U00e1
    245 U00e1							; A bank whose code comes in a later step has only its
    246 U00e1							; tail, and the routine its trampoline goes to is a stub:
    247 U00e1							; never called before that step.
    248 U00e1
    249 U00e1							; --- bank 0: the room -------------------------------------
      0 U00e1					      BANK	0
      1  1000 ????				      SEG	bank0
      2  0000					      ORG	0*$1000
      3  0000					      RORG	$1000+0*$2000
      4  0000		       00 00 00 00*	      ds	256, 0
------- FILE kfig0.asm LEVEL 2 PASS 2
      0  0100					      include	"kfig0.asm"
      1  0100							; generated by build_assets.py - Sir Roderick for bank 0
      2  0100
      3  0100							; his figures and the colours of the thrust (they
      4  0100							; also switch the blade)
      5  0100					      IF	!PAL
      6  0100							; KFG: bottom first; between them only the zeros
      7  0100							; that the lines each one is read at need (zeros
      8  0100							; below it, above it):
      9  0100							;   knight_stand (135, 135)
     10  0100							;   knight_walk1 (135, 135)
     11  0100							;   knight_walk2 (135, 135)
     12  0100							;   knight_thrust (135, 135)
     13  0100							;   the colours of the thrust (135, 135)
     14  0100				   KFG
     15  0100		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     16  010b		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     17  0116		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     18  0121		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     19  012c		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     20  0137		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     21  0142		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     22  014d		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     23  0158		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     24  0163		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     25  016e		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     26  0179		       00 00 00 00*	      .byte.b	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
     27  0184		       00 00 00 e7*	      .byte.b	$00,$00,$00,$E7,$66,$66,$66,$7E,$3C,$3C,$3E
     28  018f		       1e 9e 9f de*	      .byte.b	$1E,$9E,$9F,$DE,$7E,$3C,$18,$3C,$7E,$72,$7E
     29  019a		       7c 38 60 38*	      .byte.b	$7C,$38,$60,$38,$18,$00,$00,$00,$00,$00,$00
