------- FILE things.asm LEVEL 2 PASS 2
      0  4100					      include	"things.asm"
      1  4100							; things.asm - bank 4: the things of the rooms, the guards
      2  4100							; and the serpents
      3  4100							;
      4  4100							; Called once a frame in the overscan of a game, from bank 7
      5  4100							; through the trampoline TO_THINGS: what
      6  4100							; Sir Roderick's move of this frame did, after the picture
      7  4100							; that showed it.
      8  4100							; - The spikes: the time of the plates. setup_room
      9  4100							;   (main.asm) starts them down when he comes into a room;
     10  4100							;   when they turn, their version of the two courses goes
     11  4100							;   into the Superchip RAM, where the kernel draws the room
     12  4100							;   from.
     13  4100							; - The hurt: on a raised plate he loses SPIKE_DAMAGE units
     14  4100							;   of energy, again every HURT_FRAMES while he stays on
     15  4100							;   it. While the count of a wound goes down (after the
     16  4100							;   spikes or a bite) nothing hurts him, and he flashes.
     17  4100							; - The guards, each one alive: the blade of a thrust
     18  4100							;   kills a serpent it touches (SERPENT_BCD points);
     19  4100							;   a serpent whose box touches his bites (BITE_DAMAGE,
     20  4100							;   then BITE_FRAMES without wounds); then they crawl
     21  4100							;   along their paths, turning at the ends, at the speed of
     22  4100							;   the room (a fraction of a pixel a frame).
     23  4100							;   The column of the first guard, for the seam of the
     24  4100							;   next frame (zcoarse, SC_HM).
     25  4100							; - The thing of the room: a chest he touches opens and
     26  4100							;   gives him the key of the level; a door he stands in
     27  4100							;   front of with that key opens (the key is used up), and
     28  4100							;   the open version of the grate goes into the Superchip
     29  4100							;   RAM. Points for both.
     30  4100							; - The throne room has nothing (the King: step 6).
     31  4100							; - GAME OVER: energy 0. From then on nothing here.
     32  4100							; What player 1 shows, the collision map and the key in the
     33  4100							; HUD follow in the next frame (room_state, p1_bands in
     34  4100							; main.asm).
     35  4100							;
     36  4100							; The tables (bank4.asm, from dungeon.py and rules.py): for
     37  4100							; each room its lists of versions, the bit of its thing in
     38  4100							; `opened`, where he touches it, where the plates are;
     39  4100							; its guards (32 entries: r the first, 16 + r the second).
     40  4100
     41  4100				  -	      IF	CHEST_BCD == 0 || SPK_UP == 0
     42  4100				  -	      ERR		; (the branches below)
     43  4100					      ENDIF
     44  4100
     45  4100				   things
     46  4100		       a5 af		      lda	over	; GAME OVER: all stops
     47  4102		       f0 01		      beq	th_go
     48  4104		       60		      rts
     49  4105				   th_go
     50  4105							; --- the plates: down for the time of the level, up
     51  4105							; for SPK_UP frames
     52  4105		       c6 9e		      dec	spk
     53  4107		       d0 24		      bne	th_hurt
     54  4109		       a4 85		      ldy	room
     55  410b		       a5 9f		      lda	spup	; they turn
     56  410d		       49 01		      eor	#1
     57  410f		       85 9f		      sta	spup
     58  4111		       f0 0b		      beq	th_down
     59  4113		       a9 3c		      lda	#SPK_UP
     60  4115		       85 9e		      sta	spk
     61  4117		       be 62 93 	      ldx	SPU4,y	; the raised version
     62  411a		       d0 0e		      bne	th_turn	; (an empty list is entry 0:
     63  411c		       f0 0f		      beq	th_hurt	; nothing to write)
     64  411e				   th_down
     65  411e		       98		      tya
     66  411f		       4a		      lsr
     67  4120		       4a		      lsr
     68  4121		       aa		      tax		; level - 1
     69  4122		       bd 12 94 	      lda	TH_DOWN,x
     70  4125		       85 9e		      sta	spk
     71  4127		       be 52 93 	      ldx	SPD4,y	; the lowered version
     72  412a				   th_turn
     73  412a		       20 de 91 	      jsr	put
     74  412d							; --- the hurt: while it counts down, no new one
     75  412d				   th_hurt
     76  412d		       a5 a0		      lda	hurt
     77  412f		       f0 04		      beq	th_feet
     78  4131		       c6 a0		      dec	hurt
