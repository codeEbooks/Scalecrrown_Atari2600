------- FILE scalecrown.asm
------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  04d2					      include	"room_kernel.asm"
      1  04d2							; room_kernel.asm - bank 0: the room
      2  04d2							;
      3  04d2							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  04d2							; when the players have their columns for the room. Lines
      5  04d2							; 29-31 of the HUD (black) switch the ball on if the room
      6  04d2							; has a plug (it closes the outer opening of the rooms at
      7  04d2							; the ends of a level; the ball has the colour of the
      8  04d2							; playfield, the wall's) and read what the first line of
      9  04d2							; the room needs; then the 160 lines of the room,
     10  04d2							; BOT_BLANK
     11  04d2							; black lines (PAL only); then the overscan starts and the
     12  04d2							; program goes back to bank 7.
     13  04d2							;
     14  04d2							; Cycle counts in the comments: the cycle at which a store
     15  04d2							; writes, counted from 0 at the start of the line; a "+" is
     16  04d2							; a load that can take one cycle more when its address
     17  04d2							; crosses a page.
     18  04d2
     19  04d2				   room_kernel
     20  04d2		       85 02		      sta	WSYNC	; HUD line 29
     21  04d4		       a5 9b		      lda	plug	; the ball: black on black
     22  04d6		       85 1f		      sta	ENABL	; until the room starts
     23  04d8		       a0 9f		      ldy	#159	; what line A0 of course 0
     24  04da		       84 bf		      sty	idx	; needs
     25  04dc		       a9 13		      lda	#19
     26  04de		       85 c0		      sta	trow
     27  04e0		       b1 b8		      lda	(cbk),y	; +
     28  04e2		       85 bc		      sta	zbk	; COLUBK of pair 0
     29  04e4		       b1 ba		      lda	(cpf),y	; +
     30  04e6		       85 bd		      sta	zt	; COLUPF of pair 0
     31  04e8		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     32  04eb		       85 c1		      sta	znpf0
     33  04ed		       ad a7 10 	      lda	SCR+SC_PF1+19
     34  04f0		       85 c2		      sta	znpf1
     35  04f2		       ad bb 10 	      lda	SCR+SC_PF2+19
