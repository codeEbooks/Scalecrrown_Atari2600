     54  76da							; poses of the walk, a pose every STRIDE
     55  76da				   WALK
     56  76da		       01 00 02 00	      .byte.b	$01,$00,$02,$00
     57  76de							; player 1: the thing of band A closed and open, the
     58  76de							; bit that opens it, its top line and column; NUSIZ1
     59  76de				   OB_KIND0
     60  76de		       0a 00 00 00*	      .byte.b	$0A,$00,$00,$00,$0A,$00,$00,$00
     61  76e6		       00 00 00 0a*	      .byte.b	$00,$00,$00,$0A,$00,$0A,$0E,$00
     62  76ee				   OB_KIND1
     63  76ee		       0c 00 00 00*	      .byte.b	$0C,$00,$00,$00,$0C,$00,$00,$00
     64  76f6		       00 00 00 0c*	      .byte.b	$00,$00,$00,$0C,$00,$0C,$00,$00
