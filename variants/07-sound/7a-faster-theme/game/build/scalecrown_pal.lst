    111  778c
    112  778c							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    113  778c							; columns read through six pointers: {1} ... {1}+10 (dig:
    114  778c							; the digits of the score; txp: the name of the level, in
    115  778c							; this bank). Called on the line before the first one.
    116  778c							; Both players are delayed (VDELP0, VDELP1) and have three
    117  778c							; copies 16 pixels apart:
    118  778c							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    119  778c							; A delayed player shows the value written before the last
    120  778c							; write to the other player, so the four writes at the end
    121  778c							; change the copies on the right while the beam is between
    122  778c							; them.
    123  778c					      MAC	hud48
    124  778c					      ldy	#7
    125  778c					      sty	zt2
    126  778c				   .loop      lda	({1}),y
    127  778c					      sta	GRP0	; column 1 (waits)
    128  778c					      sta	WSYNC
    129  778c					      lda	({1}+2),y
    130  778c					      sta	GRP1	;  7 col 2; col 1 shows
    131  778c					      lda	({1}+4),y
    132  778c					      sta	GRP0	; 15 col 3; col 2 shows
    133  778c					      lda	({1}+10),y
    134  778c					      sta	zt
    135  778c					      lda	({1}+8),y
    136  778c					      tax
    137  778c					      lda	({1}+6),y
    138  778c					      ldy	zt
    139  778c					      nop
    140  778c					      sta	GRP1	; 43 col 4; col 3 shows
    141  778c					      stx	GRP0	; 46 col 5; col 4 shows
    142  778c					      sty	GRP1	; 49 col 6; col 5 shows
    143  778c					      sta	GRP0	; 52 col 6 shows
    144  778c					      ldy	zt2
    145  778c					      dey
    146  778c					      sty	zt2
    147  778c					      bpl	.loop
    148  778c					      rts
    149  778c					      ENDM
    150  778c
    151  778c							; each routine in one page (as the blocks of the title: see
    152  778c							; title_kernel.asm); the padding comes after a jmp or an rts
    153  778c		       00 32	   HUD48_BYTES =	50
    154  778c
    155  778c				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    156  778c				  -	      ALIGN	256
    157  778c					      ENDIF
