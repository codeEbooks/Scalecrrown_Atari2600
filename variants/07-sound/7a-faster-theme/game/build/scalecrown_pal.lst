    182  71f2		       4a		      lsr
    183  71f3		       4a		      lsr
    184  71f4		       aa		      tax
    185  71f5		       20 51 f2 	      jsr	name
    186  71f8		       bd 22 fc 	      lda	SU_DOWN,x	; the plates: down, for the
    187  71fb		       85 9f		      sta	spk	; time of the level
    188  71fd		       a9 00		      lda	#0
    189  71ff		       85 a0		      sta	spup
    190  7201		       8d 41 10 	      sta	SCW+SC_ACC	; the guards: no fraction,
    191  7204		       a9 03		      lda	#3	; both alive,
    192  7206		       8d 40 10 	      sta	SCW+SC_LIVE
    193  7209		       a9 08		      lda	#8	; facing left,
    194  720b		       8d 3e 10 	      sta	SCW+SC_SD
    195  720e		       8d 3f 10 	      sta	SCW+SC_SD+1
    196  7211		       a6 85		      ldx	room
    197  7213		       bd 7c f8 	      lda	S_X,x	; at their start (the first:
    198  7216		       8d 3c 10 	      sta	SCW+SC_SX	; its coarse column and fine
    199  7219		       bd 8c f8 	      lda	S_X+16,x	; move for the seam, as
    200  721c		       8d 3d 10 	      sta	SCW+SC_SX+1	; things.asm keeps them)
    201  721f		       bd 9c f8 	      lda	S_CO,x
    202  7222		       85 bb		      sta	zcoarse
    203  7224		       bd ac f8 	      lda	S_HM,x
