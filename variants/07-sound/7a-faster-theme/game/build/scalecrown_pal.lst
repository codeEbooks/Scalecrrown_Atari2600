    669  751c
    670  751c							; place: object X (0 player 0, 1 player 1, 2 missile 0, 3
    671  751c							; missile 1, 4 the ball) at column A: the first pixel of a
    672  751c							; player is A + 3, of a missile or the ball A + 2. Takes one
    673  751c							; line: the WSYNC, then 15 pixels per 5 cycles.
    674  751c							; (its loop in one page: a branch that crosses one takes a
    675  751c							; cycle more, and the column would be wrong; the padding
    676  751c							; comes after an rts)
    677  751c				  -	      IF	(* & $FF00) != ((*+8) & $FF00)
    678  751c				  -	      ALIGN	256
    679  751c					      ENDIF
    680  751c				   place
    681  751c		       85 02		      sta	WSYNC
    682  751e		       38		      sec
    683  751f		       e9 0f	   pl_div     sbc	#15
    684  7521		       b0 fc		      bcs	pl_div	; (pl_div)
    685  7523		       49 07		      eor	#7
    686  7525		       0a		      asl
    687  7526		       0a		      asl
    688  7527		       0a		      asl
    689  7528		       0a		      asl
    690  7529		       95 20		      sta	HMP0,x
    691  752b		       95 10		      sta	RESP0,x
    692  752d		       60		      rts
------- FILE scalecrown.asm
------- FILE knight.asm LEVEL 2 PASS 2
      0  752e					      include	"knight.asm"
      1  752e							; knight.asm - bank 7: Sir Roderick
      2  752e							;
      3  752e							; One frame of his: while he parries the venom with his
      4  752e							; shield (things.asm starts it) he stands still and shows
      5  752e							; the parry;
      6  752e							; the button starts a thrust of the sword, during which he
      7  752e							; stands still; otherwise the joystick moves him, first
      8  752e							; left or right, then up or down, each direction tried on
      9  752e							; its own against the walls (so he slides along a wall
     10  752e							; when pushed diagonally into it). Past the edge of the
     11  752e							; screen he goes into the next room: east and west
     12  752e							; through the openings, down and up by the stairs.
     13  752e							; The speeds are in bank7.asm, one table for each
     14  752e							; television (rules.py).
     15  752e
     16  752e				  -	      IF	V_INT != 0
     17  752e				  -	      ERR		; one step at most per frame
     18  752e					      ENDIF
     19  752e				  -	      IF	STRIDE != 8
     20  752e				  -	      ERR		; the walk divides by 8
     21  752e					      ENDIF
     22  752e
     23  752e				   knight
     24  752e		       a5 92		      lda	parry	; the parry
     25  7530		       f0 07		      beq	kn_thrust
     26  7532		       c6 92		      dec	parry
