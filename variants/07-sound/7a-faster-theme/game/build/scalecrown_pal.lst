    250  727b							; ---------------------------------------------------------
    251  727b							; room_state: in every frame of a game, what follows from
    252  727b							; the things of the room (things.asm, bank 4, in the
    253  727b							; overscan): the thing of player 1 closed or open, the
    254  727b							; collision map with the door closed or open, the HUD
    255  727b							; with the key after LEVEL n (the sixth column of the
    256  727b							; name, 8 bytes on) or, after the end, GAME OVER or
    257  727b							; VICTORY
    258  727b
    259  727b				   room_state
    260  727b		       a6 85		      ldx	room
    261  727d		       bc ec f7 	      ldy	OB_KIND0,x	; the thing: closed
    262  7280		       bd 0c f8 	      lda	OB_BIT,x
    263  7283		       25 9e		      and	opened
    264  7285		       f0 03		      beq	rs_kind
