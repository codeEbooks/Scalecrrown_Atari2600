------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 7 of the chain of the book: the sound
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four
      7  8000 ????						; levels (dungeon.py).
      8  8000 ????						; The joystick moves him, the walls stop him, the button
      9  8000 ????						; thrusts the sword; RESET starts again.
     10  8000 ????						; The openings east and west lead to the rooms beside, the
     11  8000 ????						; stairs to the level below and back; the ball closes the
     12  8000 ????						; outer side of the rooms at the ends of a level. The HUD:
     13  8000 ????						; the score, the energy, the name of the level.
     14  8000 ????						; The things: a chest in each level gives the key of the
     15  8000 ????						; level's door (a grate on the stair down; the golden gate
     16  8000 ????						; before the throne room); spikes go up and down in eight
     17  8000 ????						; rooms; points for chests and doors.
     18  8000 ????						; The serpents: one or two in a room, crawling to and fro,
     19  8000 ????						; faster in the lower levels; a bite takes energy, and so
     20  8000 ????						; do the spikes; a wound makes him flash; energy 0: GAME
     21  8000 ????						; OVER.
     22  8000 ????						; A thrust of the sword kills a serpent (they are back
     23  8000 ????						; when he comes in again).
     24  8000 ????						; Player 1 shows two things: the kernel moves it in the
     25  8000 ????						; middle of the room (the seam) to the serpent of the band
     26  8000 ????						; below; two things in the same lines take turns.
     27  8000 ????						; The Serpent King: in the throne room, drawn by its own
     28  8000 ????						; kernel (bank 2), he goes up and down to meet Sir
     29  8000 ????						; Roderick and spits venom (missile 1) at him; the oak
     30  8000 ????						; shield parries what comes from the side Sir Roderick
     31  8000 ????						; faces. Ten blows beat the King; the crown appears on the
     32  8000 ????						; throne; struck, it breaks: VICTORY.
     33  8000 ????						; After GAME OVER or VICTORY the game stops; RESET
     34  8000 ????						; starts again.
     35  8000 ????						; The sound (bank 5): the theme, and the effects of the
     36  8000 ????						; sword, the stairs, the things, the bites and the blows.
     37  8000 ????						; SELECT, in the game, chooses MUSIC, SOUND FX or SILENT.
     38  8000 ????						;
     39  8000 ????						; Banks (the address of each one for the 6507):
     40  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     41  8000 ????						;   1 ($3000) the title: only its tail before step 8
     42  8000 ????						;   2 ($5000) the throne room: its kernel, the King, the
     43  8000 ????						;	       crown, its colours
     44  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     45  8000 ????						;   4 ($9000) the things: chests, doors, spikes
     46  8000 ????						;	       the serpents, the Serpent King
     47  8000 ????						;   5 ($B000) sound: player, music, effects
     48  8000 ????						;   6 ($D000) the end screens: only its tail before
     49  8000 ????						;	       step 8
     50  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     51  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     52  8000 ????						; window and ends with the same tail (trampolines, reset).
     53  8000 ????						; Banks 0 and 2 then start with the same bytes: Sir
     54  8000 ????						; Roderick's figures and colours (kfig0.asm, kfig2.asm), so
     55  8000 ????						; that the pointers to them work in both kernels.
     56  8000 ????						;
     57  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     58  8000 ????						;	  [-DPAL=1]
     59  8000 ????
     60  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 11	   RESP1      =	$11	; any write: player 1 starts here
     24  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     25  8000 ????	       00 13	   RESM1      =	$13	; any write: missile 1 starts here
     26  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here
     27  8000 ????	       00 15	   AUDC0      =	$15	; sound, voice 0: waveform (0-15)
     28  8000 ????	       00 16	   AUDC1      =	$16	; voice 1
     29  8000 ????	       00 17	   AUDF0      =	$17	; voice 0: frequency divider (0-31)
     30  8000 ????	       00 18	   AUDF1      =	$18	; voice 1
     31  8000 ????	       00 19	   AUDV0      =	$19	; voice 0: volume (0-15)
     32  8000 ????	       00 1a	   AUDV1      =	$1A	; voice 1
     33  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     34  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1
     35  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     36  8000 ????	       00 1e	   ENAM1      =	$1E	; bit 1: missile 1 on
     37  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on
     38  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     39  8000 ????	       00 21	   HMP1       =	$21	; fine move of player 1
     40  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     41  8000 ????	       00 23	   HMM1       =	$23	; fine move of missile 1
     42  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball
     43  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed
     44  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed
     45  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     46  8000 ????	       00 29	   RESMP1     =	$29	; bit 1: missile 1 off, on player 1
     47  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     48  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves
     49  8000 ????
     50  8000 ????						; TIA, read side
     51  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     52  8000 ????
     53  8000 ????						; RIOT
     54  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     55  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     56  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     57  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     62  8000 ????
     63  8000 ????			  -	      IFNCONST	PAL
     64  8000 ????			  -PAL	      =	0
     65  8000 ????				      ENDIF
     66  8000 ????
     67  8000 ????				      IF	PAL
     68  8000 ????	       00 12	   TOP_BLANK  =	18	; black lines above the HUD
     69  8000 ????	       00 12	   BOT_BLANK  =	18	; and below the room
     70  8000 ????	       00 36	   VBLANK_TIM =	54
     71  8000 ????	       00 2b	   OVER_TIM   =	43
     72  8000 ????			  -	      ELSE
     73  8000 ????			  -TOP_BLANK  =	0
     74  8000 ????			  -BOT_BLANK  =	0
     75  8000 ????			  -VBLANK_TIM =	44
     76  8000 ????			  -OVER_TIM   =	35
     77  8000 ????				      ENDIF
     78  8000 ????
     79  8000 ????						; F4: an access to $1FF4 + n selects bank n
     80  8000 ????	       1f f4	   F4B0       =	$1FF4
     81  8000 ????	       1f f5	   F4B1       =	$1FF5
     82  8000 ????	       1f f6	   F4B2       =	$1FF6
     83  8000 ????	       1f f7	   F4B3       =	$1FF7
     84  8000 ????	       1f f8	   F4B4       =	$1FF8
     85  8000 ????	       1f f9	   F4B5       =	$1FF9
     86  8000 ????	       1f fa	   F4B6       =	$1FFA
     87  8000 ????	       1f fb	   F4B7       =	$1FFB
     88  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     89  8000 ????	       10 00	   SCW	      =	$1000
     90  8000 ????	       10 80	   SCR	      =	$1080
     91  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     92  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     93  8000 ????	       00 28	   SC_PF2     =	40
     94  8000 ????	       00 3c	   SC_SX      =	60	; the guards: columns (two),
     95  8000 ????	       00 3e	   SC_SD      =	62	; facing: 0 right, 8 left (two),
     96  8000 ????	       00 40	   SC_LIVE    =	64	; alive: bit 0 the first, bit 1 the
     97  8000 ????						; second;
     98  8000 ????	       00 41	   SC_ACC     =	65	; the fraction of their crawl (the
     99  8000 ????						; King's steps);
    100  8000 ????	       00 42	   SC_HM      =	66	; HMP1 for the seam (the fine move)
    101  8000 ????	       00 43	   SC_KT      =	67	; the Serpent King: top line,
    102  8000 ????	       00 44	   SC_KH      =	68	; blows he has had,
    103  8000 ????	       00 45	   SC_KF      =	69	; frames of his flash after a blow,
    104  8000 ????	       00 46	   SC_KS      =	70	; frames before he spits;
    105  8000 ????	       00 47	   SC_VP      =	71	; the venom: its first pixel,
    106  8000 ????	       00 48	   SC_VD      =	72	; 0 none, 1 flying right, 2 left,
    107  8000 ????	       00 49	   SC_VA      =	73	; the fraction of its flight;
    108  8000 ????	       00 4a	   SC_CROWN   =	74	; 0 the King, 1 the crown, 2 broken
    109  8000 ????						; (new_game: 0; it stays when he
    110  8000 ????						; leaves the throne room)
    111  8000 ????
    112  8000 ????						; trampolines, the same addresses in every bank
    113  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
    114  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
    115  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
    116  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
    117  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
    118  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
    119  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
    120  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
    121  8000 ????
    122  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD
    123  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
    124  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
    125  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
    126  8000 ????	       00 18	   KNIGHT_H   =	24
    127  8000 ????
    128  8000 ????						; ---------------------------------------------------------
    129  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
    130  8000 ????						;
    131  8000 ????						; Every variable has one owner, the part of the program
    132  8000 ????						; that writes it (the others read it); the groups below say
    133  8000 ????						; which.
    134  8000 ????
    135 U00f4 ????				      SEG.U	ram
    136 U0080					      ORG	$80
    137 U0080							; == state (main.asm): frame, screens, buttons, the game
    138 U0080							; == (knight.asm changes room and screen on the way out)
    139 U0080		       00	   frames     ds	1	; frame counter
    140 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
    141 U0082		       00	   shown      ds	1	; the screen set up in the SC
    142 U0083		       00	   held       ds	1	; buttons down a frame ago
    143 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
    144 U0085							; RESET $01
    145 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    146 U0086		       00 00 00    score      ds	3	; BCD, six digits (things.asm
    147 U0089							; adds the points)
    148 U0089		       00	   energy     ds	1	; 0-12 (things.asm: the wounds)
    149 U008a							; == Sir Roderick (knight.asm)
    150 U008a		       00	   kx	      ds	1	; column, 0-149
    151 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    152 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    153 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    154 U008e		       00	   kdist      ds	1	; units walked: pose of the walk
    155 U008f		       00	   hacc       ds	1	; fraction of a step: sideways,
    156 U0090		       00	   vacc       ds	1	; up and down
    157 U0091		       00	   thrust     ds	1	; frames of the thrust still to go
    158 U0092		       00	   parry      ds	1	; frames of the parry still to
    159 U0093							; go (things.asm starts it)
    160 U0093		       00	   moved      ds	1	; he moved in this frame
    161 U0094		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    162 U0095		       00	   swnus      ds	1
    163 U0096		       00	   swres      ds	1
    164 U0097							; == player 1, the plug (main.asm: setup_room,
    165 U0097							; == p1_bands: the thing of band A)
    166 U0097		       00	   ox	      ds	1	; column
    167 U0098		       00	   oy	      ds	1	; top line (odd)
    168 U0099		       00	   odir       ds	1	; 0 right, 8 left (REFP1)
    169 U009a		       00	   okind      ds	1	; first frame in the OG tables
    170 U009b		       00	   onus       ds	1	; NUSIZ1 in the room
    171 U009c		       00	   plug       ds	1	; ENABL in the room: 2 the ball
    172 U009d							; == the things (things.asm; new_game and setup_room
    173 U009d							; == start them)
    174 U009d		       00	   key	      ds	1	; the key he has: its level, 0 none
    175 U009e		       00	   opened     ds	1	; open: chests bits 0-3, doors 4-7
    176 U009f		       00	   spk	      ds	1	; frames left before the plates turn
    177 U00a0		       00	   spup       ds	1	; the plates: 0 down, 1 up
    178 U00a1		       00	   hurt       ds	1	; frames before a wound can come
    179 U00a2							; again (the spikes, a bite)
    180 U00a2							; == the collision test (knight.asm: box_free, wall)
    181 U00a2		       00 00	   cmap       ds	2	; collision map of the room
    182 U00a4							; (main.asm: room_state)
    183 U00a4		       00	   nx	      ds	1	; the box tried: column, top line
    184 U00a5		       00	   ny	      ds	1
    185 U00a6		       00	   bc0	      ds	1	; its block columns, left, right
    186 U00a7		       00	   bc1	      ds	1
    187 U00a8		       00	   br	      ds	1	; 3 x the block row tested (its
    188 U00a9							; first byte in the map)
    189 U00a9							; == sound (sound.asm; mode: main.asm, SELECT;
    190 U00a9							; == sfxreq: knight.asm asks, sound.asm clears; song:
    191 U00a9							; == main.asm and things.asm)
    192 U00a9		       00	   mode       ds	1	; 0 MUSIC, 1 SOUND FX, 2 SILENT
    193 U00aa		       00	   smode      ds	1	; the mode the player last saw ($FF:
    194 U00ab							; a song to start)
    195 U00ab		       00	   song       ds	1	; 2 x the song (main.asm,
    196 U00ac							; things.asm choose it)
    197 U00ac		       00	   sfxreq     ds	1	; effect asked for (0: none)
    198 U00ad		       00	   sfxi       ds	1	; effect playing: its frame, 0 none
    199 U00ae		       00	   mclock     ds	1	; frames left in this step
    200 U00af		       00	   mstep      ds	1	; index in STEPLEN
    201 U00b0		       00 00	   vpos       ds	2	; each voice: offset in its stream,
    202 U00b2		       00 00	   vleft      ds	2	; steps left of its note,
    203 U00b4		       00 00	   venv       ds	2	; frame of the note (envelope),
    204 U00b6		       00 00	   vins       ds	2	; instrument,
    205 U00b8		       00 00	   vnote      ds	2	; note (0: a rest)
    206 U00ba							; == the seam of player 1 (main.asm prepares;
    207 U00ba							; == room_kernel.asm)
    208 U00ba		       00	   zcnt       ds	1	; courses to the seam (0: none)
    209 U00bb		       00	   zcoarse    ds	1	; the delay before RESP1 there
    210 U00bc		       00	   zref       ds	1	; REFP1 below the seam
    211 U00bd		       00 00	   s2gfx      ds	2	; player 1 below the seam: graphics,
    212 U00bf		       00 00	   s2col      ds	2	; colours
    213 U00c1							; == GAME OVER, VICTORY (things.asm sets them)
    214 U00c1		       00	   over       ds	1	; 0 playing, 1 GAME OVER
    215 U00c2		       00	   won	      ds	1	; 0 playing, 1 VICTORY
    216 U00c3							; == the kernels (main.asm prepares; room_kernel.asm)
    217 U00c3		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    218 U00c5		       00 00	   kcol       ds	2
    219 U00c7		       00 00	   sgfx       ds	2	; player 1: graphics, colours
    220 U00c9		       00 00	   scol       ds	2
    221 U00cb		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    222 U00cd		       00 00	   cpf	      ds	2
    223 U00cf		       00	   zbk	      ds	1	; COLUBK of the next line A
    224 U00d0		       00	   zt	      ds	1	; colour for Y at the end of a line
    225 U00d1		       00	   zc1	      ds	1	; COLUP1 of the next line B
    226 U00d2		       00	   idx	      ds	1	; index of the line being prepared
    227 U00d3		       00	   trow       ds	1	; Superchip index of the next course
    228 U00d4		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    229 U00d5		       00	   znpf1      ds	1
    230 U00d6		       00	   znpf2      ds	1
    231 U00d7							; == the HUD (main.asm prepares; hud.asm)
    232 U00d7		       00 00 00 00*dig	      ds	12	; the six columns of digits
    233 U00e3		       00 00 00 00*txp	      ds	12	; and of the name of the level
    234 U00ef		       00	   zt2	      ds	1
    235 U00f0		       00	   bar1       ds	1	; energy bar: PF1, PF2
    236 U00f1		       00	   bar2       ds	1
    237 U00f2							; == scratch (anyone; never kept across a call; the room
    238 U00f2							; == kernel keeps a value of the seam in tmp)
    239 U00f2		       00 00	   tmp	      ds	2
    240 U00f4				   ram_end
    241 U00f4
    242 U00f4							; ---------------------------------------------------------
    243 U00f4							; the banks
    244 U00f4
    245 U00f4					      MAC	bank
    246 U00f4					      SEG	bank{1}
    247 U00f4					      ORG	{1}*$1000
    248 U00f4					      RORG	$1000+{1}*$2000
    249 U00f4					      ds	256, 0	; the Superchip window
    250 U00f4					      ENDM		; {1}: bank number
    251 U00f4
    252 U00f4					      MAC	tail
    253 U00f4					      ORG	{1}*$1000+$FAA
    254 U00f4					      RORG	$1FAA+{1}*$2000
    255 U00f4					      sta	F4B6	; $FAA: to the end screens
    256 U00f4					      jmp	ends_kernel
    257 U00f4					      sta	F4B2	; $FB0: to the throne kernel
    258 U00f4					      jmp	throne_kernel
    259 U00f4					      sta	F4B4	; $FB6: (jsr here) bank 4
    260 U00f4					      jsr	things	; $FB9: in bank 4
    261 U00f4					      sta	F4B7	; $FBC: bank 7 again
    262 U00f4					      rts		; $FBF: in bank 7
    263 U00f4					      sta	F4B0	; $FC0: to the room kernel
    264 U00f4					      jmp	room_kernel
    265 U00f4					      sta	F4B1	; $FC6: to the title kernel
    266 U00f4					      jmp	title_kernel
    267 U00f4					      sta	F4B7	; $FCC: back to the frame
    268 U00f4					      jmp	kernel_done
    269 U00f4					      sta	F4B5	; $FD2: (jsr here) bank 5
    270 U00f4					      jsr	sound	; $FD5: in bank 5
    271 U00f4					      sta	F4B7	; $FD8: bank 7 again
    272 U00f4					      rts		; $FDB: in bank 7
    273 U00f4					      ORG	{1}*$1000+$FE0
    274 U00f4					      RORG	$1FE0+{1}*$2000
    275 U00f4					      sta	F4B7	; $FE0: reset, in any bank
