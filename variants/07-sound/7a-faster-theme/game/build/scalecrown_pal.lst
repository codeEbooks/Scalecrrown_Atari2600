------- FILE sound.asm LEVEL 2 PASS 2
      0  5100					      include	"sound.asm"
      1  5100							; sound.asm - bank 5: the sound player
      2  5100							;
      3  5100							; Called once a frame in the overscan, from bank 7 through
      4  5100							; the trampoline TO_SOUND (in the tail of every bank).
      5  5100							; Three modes, chosen with SELECT (main.asm):
      6  5100							;   0 MUSIC	 the theme on both voices (voice 0 the bass,
      7  5100							;		 voice 1 the melody), no effects
      8  5100							;   1 SOUND FX  the effects on voice 0, voice 1 silent
      9  5100							;   2 SILENT	 nothing
     10  5100							; When the mode changes both voices are silenced, any effect
     11  5100							; stops and the music starts again from its first step.
     12  5100							;
     13  5100							; The song: the theme; song is 2 x the one playing. To
     14  5100							; start it the game writes it in song and $FF in smode
     15  5100							; (RESET): the player sees a new mode and does as above.
     16  5100							;
     17  5100							; The music (music.py makes the tables from score.py): each
     18  5100							; voice reads a stream of bytes: $FE n chooses instrument
     19  5100							; n; a note (index in NOTE_C / NOTE_F, 0 is a rest) and its
     20  5100							; length in steps; $FF goes back to the voice's loop point.
     21  5100							; A step is a sixteenth note: STEPLEN frames (NTSC 9; PAL 8
     22  5100							; and 7 in turn). The volume of a note follows its
     23  5100							; instrument's envelope, one value a frame (the last holds);
     24  5100							; the last frame of every note is silent.
     25  5100							;
     26  5100							; The effects (sfx.py): AUDC, AUDF, AUDV of each frame in
     27  5100							; three tables, an AUDC of $FF at the end. The game
     28  5100							; asks for one with sfxreq; sfxi is the frame playing.
     29  5100
     30  5100				   sound
     31  5100		       a5 a9		      lda	mode
     32  5102		       c5 aa		      cmp	smode
     33  5104		       f0 16		      beq	so_mode
     34  5106		       85 aa		      sta	smode	; a new mode: silence, the
     35  5108		       a2 00		      ldx	#0	; music from the start, no
     36  510a		       86 19		      stx	AUDV0	; effect
     37  510c		       86 1a		      stx	AUDV1
     38  510e		       86 ad		      stx	sfxi
     39  5110		       86 ae		      stx	mclock
     40  5112		       86 af		      stx	mstep
     41  5114		       86 b0		      stx	vpos
     42  5116		       86 b1		      stx	vpos+1
     43  5118		       86 b2		      stx	vleft
     44  511a		       86 b3		      stx	vleft+1
     45  511c				   so_mode
     46  511c		       a5 a9		      lda	mode
     47  511e		       f0 3a		      beq	music
     48  5120		       c9 01		      cmp	#1
     49  5122		       f0 09		      beq	effects
     50  5124		       a9 00		      lda	#0	; SILENT
     51  5126		       85 19		      sta	AUDV0
     52  5128		       85 1a		      sta	AUDV1
     53  512a		       85 ac		      sta	sfxreq
     54  512c		       60		      rts
     55  512d
     56  512d							; --- SOUND FX ---------------------------------------------
     57  512d
     58  512d				   effects
     59  512d		       a9 00		      lda	#0
     60  512f		       85 1a		      sta	AUDV1	; voice 1 rests
     61  5131		       a6 ac		      ldx	sfxreq
     62  5133		       f0 07		      beq	ef_play
     63  5135		       85 ac		      sta	sfxreq	; (A is 0)
     64  5137		       bd 1c b4 	      lda	SFX_START-1,x	; a new effect, at its start
     65  513a		       85 ad		      sta	sfxi
     66  513c				   ef_play
     67  513c		       a4 ad		      ldy	sfxi
     68  513e		       b9 2a b4 	      lda	SFX_C,y	; AUDC, or $FF at the end
     69  5141		       30 10		      bmi	ef_end
     70  5143		       85 15		      sta	AUDC0
     71  5145		       b9 f6 b4 	      lda	SFX_F,y
     72  5148		       85 17		      sta	AUDF0
     73  514a		       b9 c2 b5 	      lda	SFX_V,y
     74  514d		       85 19		      sta	AUDV0
     75  514f		       c8		      iny
     76  5150		       84 ad		      sty	sfxi
     77  5152		       60		      rts
     78  5153		       a9 00	   ef_end     lda	#0
     79  5155		       85 19		      sta	AUDV0
     80  5157		       85 ad		      sta	sfxi	; frame 0: the empty effect
     81  5159		       60		      rts
     82  515a
     83  515a							; --- MUSIC ------------------------------------------------
     84  515a
     85  515a				   music
     86  515a		       a9 00		      lda	#0
     87  515c		       85 ac		      sta	sfxreq	; no effects in this mode
     88  515e		       a5 ae		      lda	mclock
     89  5160		       d0 1e		      bne	mu_frame
     90  5162		       a6 af		      ldx	mstep	; a new step
     91  5164		       bd fe b3 	      lda	STEPLEN,x
     92  5167		       85 ae		      sta	mclock
     93  5169		       e8		      inx
     94  516a		       e0 0e		      cpx	#STEPS_N
     95  516c		       90 02		      bcc	mu_step
     96  516e		       a2 00		      ldx	#0
     97  5170				   mu_step
     98  5170		       86 af		      stx	mstep
     99  5172		       a2 01		      ldx	#1
    100  5174				   mu_next
    101  5174		       b5 b2		      lda	vleft,x	; voice X: its note over,
    102  5176		       d0 03		      bne	mu_dec	; the next one
    103  5178		       20 b0 b1 	      jsr	fetch
    104  517b		       d6 b2	   mu_dec     dec	vleft,x	; steps left after this one
    105  517d		       ca		      dex
    106  517e		       10 f4		      bpl	mu_next
    107  5180				   mu_frame
    108  5180		       c6 ae		      dec	mclock	; 0: a step's last frame
    109  5182		       a2 01		      ldx	#1
    110  5184		       a9 00	   mu_vol     lda	#0
    111  5186		       b4 b8		      ldy	vnote,x
    112  5188		       f0 20		      beq	mu_set	; a rest
    113  518a		       b4 b2		      ldy	vleft,x
    114  518c		       d0 04		      bne	mu_on
    115  518e		       a4 ae		      ldy	mclock
    116  5190		       f0 18		      beq	mu_set	; the last frame of the note
    117  5192		       b4 b6	   mu_on      ldy	vins,x
    118  5194		       b5 b4		      lda	venv,x
    119  5196		       d9 0e b4 	      cmp	ENV_LAST,y	; the envelope goes on until
    120  5199		       b0 04		      bcs	mu_hold	; its last value
    121  519b		       f6 b4		      inc	venv,x
    122  519d		       90 03		      bcc	mu_read	; (inc leaves C clear)
    123  519f				   mu_hold
    124  519f		       b9 0e b4 	      lda	ENV_LAST,y
    125  51a2				   mu_read
    126  51a2		       18		      clc
    127  51a3		       79 0c b4 	      adc	ENV_START,y
    128  51a6		       a8		      tay
    129  51a7		       b9 10 b4 	      lda	ENV_DATA,y
    130  51aa		       95 19	   mu_set     sta	AUDV0,x
    131  51ac		       ca		      dex
    132  51ad		       10 d5		      bpl	mu_vol
    133  51af		       60		      rts
    134  51b0
    135  51b0							; fetch: the next note of voice X, through the pointer tmp
    136  51b0							; (the stream of voice X of the song: 2 x song + X)
    137  51b0		       8a	   fetch      txa
    138  51b1		       18		      clc
    139  51b2		       65 ab		      adc	song
    140  51b4		       a8		      tay
    141  51b5		       b9 ec b3 	      lda	VS_LO,y
    142  51b8		       85 f2		      sta	tmp
    143  51ba		       b9 f2 b3 	      lda	VS_HI,y
    144  51bd		       85 f3		      sta	tmp+1
    145  51bf				   fe_byte
    146  51bf		       b4 b0		      ldy	vpos,x
    147  51c1		       b1 f2		      lda	(tmp),y
    148  51c3		       c9 fe		      cmp	#$FE
    149  51c5		       90 1a		      bcc	fe_note	; a note or a rest
    150  51c7		       f0 0d		      beq	fe_ins
    151  51c9		       8a		      txa		; $FF: to the loop point
    152  51ca		       18		      clc
    153  51cb		       65 ab		      adc	song
    154  51cd		       a8		      tay
    155  51ce		       b9 f8 b3 	      lda	VLOOP,y
    156  51d1		       95 b0		      sta	vpos,x
    157  51d3		       4c bf b1 	      jmp	fe_byte
    158  51d6		       c8	   fe_ins     iny		; $FE: an instrument
    159  51d7		       b1 f2		      lda	(tmp),y
    160  51d9		       95 b6		      sta	vins,x
    161  51db		       c8		      iny
    162  51dc		       94 b0		      sty	vpos,x
    163  51de		       4c bf b1 	      jmp	fe_byte
    164  51e1				   fe_note
    165  51e1		       95 b8		      sta	vnote,x
    166  51e3		       c8		      iny
    167  51e4		       b1 f2		      lda	(tmp),y
    168  51e6		       95 b2		      sta	vleft,x	; its steps
    169  51e8		       c8		      iny
    170  51e9		       94 b0		      sty	vpos,x
    171  51eb		       a9 00		      lda	#0
    172  51ed		       95 b4		      sta	venv,x
