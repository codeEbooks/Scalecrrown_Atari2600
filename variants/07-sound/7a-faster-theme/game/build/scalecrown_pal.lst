    160  71e5							; ---------------------------------------------------------
    161  71e5							; setup_room: when the screen changes, the playfield of
    162  71e5							; the room goes into the Superchip RAM (bank 3)
    163  71e5							; - with its door open if it is;
    164  71e5							; - the HUD gets the name of its level; the plug of the
    165  71e5							;   room is chosen;
    166  71e5							; - the plates of the spikes start down, NUSIZ1 of the
    167  71e5							;   room;
    168  71e5							; - the guards go to their start alive (the army is
    169  71e5							;   infinite);
    170  71e5							; - in the throne room the King starts again (in front
    171  71e5							;   of his throne, no blow, no venom; unless he has been
    172  71e5							;   beaten: the crown stays)
    173  71e5
    174  71e5				   setup_room
    175  71e5		       a5 81		      lda	screen
    176  71e7		       c5 82		      cmp	shown
    177  71e9		       f0 65		      beq	su_done
    178  71eb		       85 82		      sta	shown
    179  71ed		       20 e6 1f 	      jsr	TO_COPY	; bank 3: room_copy
    180  71f0				   su_copied		; the tests time the copy
