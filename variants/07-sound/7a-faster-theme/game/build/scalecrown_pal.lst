------- FILE hud.asm LEVEL 2 PASS 2
      0  76e6					      include	"hud.asm"
      1  76e6							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  76e6							;
      3  76e6							; Entered right after the WSYNC that ends the VBLANK, at
      4  76e6							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  76e6							; lines (PAL only), then the HUD:
      6  76e6							;   lines 1-9	  the six digits of the score
      7  76e6							;   lines 12-15  the energy bar
      8  76e6							;   lines 17-25  LEVEL n
      9  76e6							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  76e6							;		  (player 1: the thing of band A; the fine
     11  76e6							;		  move of the seam waits in HMP1)
     12  76e6							; and goes on to bank 0 (room_kernel.asm) in line 28, or to
     13  76e6							; bank 2 (throne_kernel.asm) in the throne room.
     14  76e6							;
     15  76e6							; Cycle counts in the comments: the cycle at which a store
     16  76e6							; writes, counted from 0 at the start of the line.
     17  76e6
     18  76e6				   hud
     19  76e6		       a9 00		      lda	#0
     20  76e8		       85 01		      sta	VBLANK	; the picture starts
     21  76ea					      IF	TOP_BLANK
     22  76ea		       a0 12		      ldy	#TOP_BLANK
     23  76ec		       85 02	   hu_top     sta	WSYNC
     24  76ee		       88		      dey
     25  76ef		       d0 fb		      bne	hu_top
     26  76f1					      ENDIF
     27  76f1		       a9 2c		      lda	#SCORE_COL	; HUD line 0
     28  76f3		       85 06		      sta	COLUP0
     29  76f5		       85 07		      sta	COLUP1
     30  76f7		       85 02		      sta	WSYNC
     31  76f9		       20 8c f7 	      jsr	hud_digits	; lines 1-9: the six digits
     32  76fc		       85 02		      sta	WSYNC	; line 10
     33  76fe		       a9 00		      lda	#0
     34  7700		       85 1b		      sta	GRP0
     35  7702		       85 1c		      sta	GRP1
     36  7704		       85 1b		      sta	GRP0	; empty the delayed copies
     37  7706		       a0 03		      ldy	#3
     38  7708		       85 02		      sta	WSYNC	; line 11
     39  770a		       85 02		      sta	WSYNC	; line 12
     40  770c				   hu_bar		; lines 12-15: energy
     41  770c		       b9 26 f9 	      lda	BAR_COL,y
     42  770f		       85 08		      sta	COLUPF	;  6
     43  7711		       a5 f0		      lda	bar1
     44  7713		       85 0e		      sta	PF1	; 12
     45  7715		       a5 f1		      lda	bar2
     46  7717		       85 0f		      sta	PF2	; 18
     47  7719		       85 02		      sta	WSYNC
     48  771b		       88		      dey
     49  771c		       10 ee		      bpl	hu_bar
