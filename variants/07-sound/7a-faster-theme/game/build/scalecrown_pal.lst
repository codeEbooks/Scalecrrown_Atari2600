      0  7100					      include	"main.asm"
      1  7100							; main.asm - bank 7: start, the frame, and what is done
      2  7100							; in it besides the kernels:
      3  7100							; - the buttons: RESET starts again;
      4  7100							; - SELECT in the game: the next sound mode;
      5  7100							; - GAME OVER, VICTORY: the game stops;
      6  7100							; - setting a room up: its playfield comes from bank 3
      7  7100							;   into the Superchip RAM;
      8  7100							; - what the kernels need: Sir Roderick, the colours of
      9  7100							;   the room, the HUD, the bands of player 1, the King or
     10  7100							;   the crown on player 1, the venom on missile 1.
     11  7100							; In the overscan the things of the room, the guards and
     12  7100							; the Serpent King (bank 4, in a game) and the sound
     13  7100							; player (bank 5).
     14  7100
     15  7100				   start
