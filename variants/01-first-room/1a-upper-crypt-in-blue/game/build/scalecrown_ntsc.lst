------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  023e					      include	"room_kernel.asm"
      1  023e							; room_kernel.asm - bank 0: the room
      2  023e							;
      3  023e							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  023e							; when Sir Roderick has his column for the room. Lines
      5  023e							; 29-31 of the HUD (black) read what the first line of the
      6  023e							; room needs; then the 160 lines of the room, BOT_BLANK
      7  023e							; black lines (PAL only); then the overscan starts and the
      8  023e							; program goes back to bank 7.
      9  023e							;
     10  023e							; Cycle counts in the comments: the cycle at which a store
     11  023e							; writes, counted from 0 at the start of the line; a "+" is
     12  023e							; a load that can take one cycle more when its address
     13  023e							; crosses a page.
     14  023e
     15  023e				   room_kernel
     16  023e		       85 02		      sta	WSYNC	; HUD line 29
     17  0240		       a0 9f		      ldy	#159	; what line A0 of course 0
     18  0242		       84 92		      sty	idx	; needs
     19  0244		       a9 13		      lda	#19
     20  0246		       85 93		      sta	trow
     21  0248		       b1 8c		      lda	(cbk),y	; +
     22  024a		       85 90		      sta	zbk	; COLUBK of pair 0
     23  024c		       b1 8e		      lda	(cpf),y	; +
     24  024e		       85 91		      sta	zt	; COLUPF of pair 0
     25  0250		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     26  0253		       85 94		      sta	znpf0
     27  0255		       ad a7 10 	      lda	SCR+SC_PF1+19
     28  0258		       85 95		      sta	znpf1
     29  025a		       ad bb 10 	      lda	SCR+SC_PF2+19
     30  025d		       85 96		      sta	znpf2	; for line A0
     31  025f		       85 02		      sta	WSYNC	; line 30
     32  0261		       b1 88		      lda	(kgfx),y	; +
     33  0263		       aa		      tax
     34  0264		       a4 91		      ldy	zt
     35  0266		       85 02		      sta	WSYNC	; line 31 stays empty
     36  0268		       4c 6b 12 	      jmp	k_top
     37  026b
     38  026b							; ---------------------------------------------------------
     39  026b							; The room: 20 courses of 8 lines, each four pairs of lines
     40  026b							; A and B. Lines A write the playfield colours, lines B the
     41  026b							; colour of Sir Roderick; both write his figure.
     42  026b							;
     43  026b							; At the start of each line (after WSYNC) the registers hold
     44  026b							; what the line writes first:
     45  026b							;   line A: X = GRP0, Y = COLUPF
     46  026b							;   line B: X = GRP0, Y = COLUP0
     47  026b							; The rest of the line prepares the next one; idx is the
     48  026b							; index (159 at the top) of the line being prepared.
     49  026b							; The playfield changes once a course: A1, A2, A3 read the
     50  026b							; next course from the Superchip RAM, A0 writes PF0, PF1
     51  026b							; and PF2.
     52  026b
