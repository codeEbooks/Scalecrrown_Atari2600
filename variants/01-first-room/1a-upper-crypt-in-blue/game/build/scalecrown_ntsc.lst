------- FILE hud.asm LEVEL 2 PASS 2
      0  71a8					      include	"hud.asm"
      1  71a8							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  71a8							;
      3  71a8							; Entered right after the WSYNC that ends the VBLANK, at
      4  71a8							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  71a8							; lines (PAL only), then the HUD:
      6  71a8							;   lines 0-25   black
      7  71a8							;   lines 26-28  Sir Roderick to his column
      8  71a8							; and goes on to bank 0 (room_kernel.asm) in line 28.
      9  71a8							;
     10  71a8							; Cycle counts in the comments: the cycle at which a store
     11  71a8							; writes, counted from 0 at the start of the line.
     12  71a8
     13  71a8				   hud
     14  71a8		       a9 00		      lda	#0
     15  71aa		       85 01		      sta	VBLANK	; the picture starts
     16  71ac				  -	      IF	TOP_BLANK
     17  71ac				  -	      ldy	#TOP_BLANK
     18  71ac				  -hu_top     sta	WSYNC
     19  71ac				  -	      dey
     20  71ac				  -	      bne	hu_top
     21  71ac					      ENDIF
     22  71ac		       a0 19		      ldy	#25	; lines 0-24: black
     23  71ae				   hu_black
     24  71ae		       85 02		      sta	WSYNC
     25  71b0		       88		      dey
     26  71b1		       d0 fb		      bne	hu_black
     27  71b3		       a5 84		      lda	kx
     28  71b5		       85 02		      sta	WSYNC	; (the end of line 25)
     29  71b7							; line 26: Sir Roderick to column kx, as place does
     30  71b7							; it (the stores take 4 cycles, like sta HMP0,x)
     31  71b7		       38		      sec
     32  71b8		       e9 0f	   hu_p0      sbc	#15
     33  71ba		       b0 fc		      bcs	hu_p0	; (hu_p0)
     34  71bc		       49 07		      eor	#7
     35  71be		       0a		      asl
     36  71bf		       0a		      asl
     37  71c0		       0a		      asl
     38  71c1		       0a		      asl
     39  71c2		       8d 20 00 	      sta.w	HMP0
     40  71c5		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     41  71c8		       85 02		      sta	WSYNC	; 71 at most
     42  71ca							; line 27: empty
     43  71ca		       85 02		      sta	WSYNC
     44  71cc							; line 28: the fine moves, the room's settings
     45  71cc		       85 2a		      sta	HMOVE	;  2
     46  71ce		       a5 86		      lda	kdir
     47  71d0		       85 0b		      sta	REFP0
     48  71d2		       a9 00		      lda	#0
     49  71d4		       85 06		      sta	COLUP0
     50  71d6		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
