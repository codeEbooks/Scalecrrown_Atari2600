------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 1 of the chain of the book: the first room
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the room where he comes into the
      7  8000 ????						; Crypt of Scales, The Broken Gate (dungeon.py).
      8  8000 ????						; He stands where he comes in.
      9  8000 ????						;
     10  8000 ????						; Banks (the address of each one for the 6507):
     11  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     12  8000 ????						;   1 ($3000) the title: only its tail before step 8
     13  8000 ????						;   2 ($5000) the throne room: only its tail before
     14  8000 ????						;	       step 6
     15  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     16  8000 ????						;   4 ($9000) the things: only its tail before step 4
     17  8000 ????						;   5 ($B000) sound: only its tail before step 7
     18  8000 ????						;   6 ($D000) the end screens: only its tail before
     19  8000 ????						;	       step 8
     20  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     21  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     22  8000 ????						; window and ends with the same tail (trampolines, reset).
     23  8000 ????						;
     24  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     25  8000 ????						;	  [-DPAL=1]
     26  8000 ????
     27  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     11  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     12  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     13  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     14  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     15  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     16  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     17  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     18  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     19  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     20  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     21  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     22  8000 ????
     23  8000 ????						; RIOT
     24  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     25  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     29  8000 ????
     30  8000 ????			  -	      IFNCONST	PAL
     31  8000 ????			  -PAL	      =	0
     32  8000 ????				      ENDIF
     33  8000 ????
     34  8000 ????			  -	      IF	PAL
     35  8000 ????			  -TOP_BLANK  =	18	; black lines above the HUD
     36  8000 ????			  -BOT_BLANK  =	18	; and below the room
     37  8000 ????			  -VBLANK_TIM =	54
     38  8000 ????			  -OVER_TIM   =	43
     39  8000 ????				      ELSE
     40  8000 ????	       00 00	   TOP_BLANK  =	0
     41  8000 ????	       00 00	   BOT_BLANK  =	0
     42  8000 ????	       00 2c	   VBLANK_TIM =	44
     43  8000 ????	       00 23	   OVER_TIM   =	35
     44  8000 ????				      ENDIF
     45  8000 ????
     46  8000 ????						; F4: an access to $1FF4 + n selects bank n
     47  8000 ????	       1f f4	   F4B0       =	$1FF4
     48  8000 ????	       1f f5	   F4B1       =	$1FF5
     49  8000 ????	       1f f6	   F4B2       =	$1FF6
     50  8000 ????	       1f f7	   F4B3       =	$1FF7
     51  8000 ????	       1f f8	   F4B4       =	$1FF8
     52  8000 ????	       1f f9	   F4B5       =	$1FF9
     53  8000 ????	       1f fa	   F4B6       =	$1FFA
     54  8000 ????	       1f fb	   F4B7       =	$1FFB
     55  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     56  8000 ????	       10 00	   SCW	      =	$1000
     57  8000 ????	       10 80	   SCR	      =	$1080
     58  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     59  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     60  8000 ????	       00 28	   SC_PF2     =	40
     61  8000 ????
     62  8000 ????						; trampolines, the same addresses in every bank
     63  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
     64  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
     65  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
     66  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
     67  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
     68  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
     69  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
     70  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
     71  8000 ????
     72  8000 ????						; ---------------------------------------------------------
     73  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
     74  8000 ????						;
     75  8000 ????						; Every variable has one owner, the part of the program
     76  8000 ????						; that writes it (the others read it); the groups below say
     77  8000 ????						; which.
     78  8000 ????
     79 U0099 ????				      SEG.U	ram
     80 U0080					      ORG	$80
     81 U0080							; == state (main.asm): frame, screens, the game
     82 U0080		       00	   frames     ds	1	; frame counter
     83 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
     84 U0082		       00	   shown      ds	1	; the screen set up in the SC
     85 U0083		       00	   room       ds	1	; 0-15: level room / 4 + 1
     86 U0084							; == Sir Roderick (main.asm: new_game)
     87 U0084		       00	   kx	      ds	1	; column, 0-149
     88 U0085		       00	   ky	      ds	1	; top line, odd, 1-135
     89 U0086		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
     90 U0087		       00	   kpose      ds	1	; 0: he stands
     91 U0088							; == the kernels (main.asm prepares; room_kernel.asm)
     92 U0088		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
     93 U008a		       00 00	   kcol       ds	2
     94 U008c		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
     95 U008e		       00 00	   cpf	      ds	2
     96 U0090		       00	   zbk	      ds	1	; COLUBK of the next line A
     97 U0091		       00	   zt	      ds	1	; colour for Y at the end of a line
     98 U0092		       00	   idx	      ds	1	; index of the line being prepared
     99 U0093		       00	   trow       ds	1	; Superchip index of the next course
    100 U0094		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    101 U0095		       00	   znpf1      ds	1
    102 U0096		       00	   znpf2      ds	1
    103 U0097							; == scratch (anyone; never kept across a call)
    104 U0097		       00 00	   tmp	      ds	2
    105 U0099				   ram_end
    106 U0099
    107 U0099							; ---------------------------------------------------------
    108 U0099							; the banks
    109 U0099
    110 U0099					      MAC	bank
    111 U0099					      SEG	bank{1}
    112 U0099					      ORG	{1}*$1000
    113 U0099					      RORG	$1000+{1}*$2000
    114 U0099					      ds	256, 0	; the Superchip window
    115 U0099					      ENDM		; {1}: bank number
    116 U0099
    117 U0099					      MAC	tail
    118 U0099					      ORG	{1}*$1000+$FAA
    119 U0099					      RORG	$1FAA+{1}*$2000
    120 U0099					      sta	F4B6	; $FAA: to the end screens
    121 U0099					      jmp	ends_kernel
    122 U0099					      sta	F4B2	; $FB0: to the throne kernel
    123 U0099					      jmp	throne_kernel
    124 U0099					      sta	F4B4	; $FB6: (jsr here) bank 4
    125 U0099					      jsr	things	; $FB9: in bank 4
    126 U0099					      sta	F4B7	; $FBC: bank 7 again
    127 U0099					      rts		; $FBF: in bank 7
    128 U0099					      sta	F4B0	; $FC0: to the room kernel
    129 U0099					      jmp	room_kernel
    130 U0099					      sta	F4B1	; $FC6: to the title kernel
    131 U0099					      jmp	title_kernel
    132 U0099					      sta	F4B7	; $FCC: back to the frame
    133 U0099					      jmp	kernel_done
    134 U0099					      sta	F4B5	; $FD2: (jsr here) bank 5
    135 U0099					      jsr	sound	; $FD5: in bank 5
    136 U0099					      sta	F4B7	; $FD8: bank 7 again
    137 U0099					      rts		; $FDB: in bank 7
    138 U0099					      ORG	{1}*$1000+$FE0
    139 U0099					      RORG	$1FE0+{1}*$2000
    140 U0099					      sta	F4B7	; $FE0: reset, in any bank
    141 U0099					      jmp	start
    142 U0099					      sta	F4B3	; $FE6: (jsr here) bank 3
    143 U0099					      jsr	room_copy	; $FE9: in bank 3
    144 U0099					      sta	F4B7	; $FEC: bank 7 again
    145 U0099					      rts		; $FEF: in bank 7
    146 U0099					      ORG	{1}*$1000+$FFC
    147 U0099					      RORG	$1FFC+{1}*$2000
    148 U0099					      .word	$1FE0+{1}*$2000
    149 U0099					      .word	$1FE0+{1}*$2000
    150 U0099					      ENDM		; {1}: bank number
    151 U0099
    152 U0099							; A bank whose code comes in a later step has only its
    153 U0099							; tail, and the routine its trampoline goes to is a stub:
    154 U0099							; never called before that step.
    155 U0099
    156 U0099							; --- bank 0: the room -------------------------------------
      0 U0099					      BANK	0
      1  1000 ????				      SEG	bank0
      2  0000					      ORG	0*$1000
      3  0000					      RORG	$1000+0*$2000
      4  0000		       00 00 00 00*	      ds	256, 0
