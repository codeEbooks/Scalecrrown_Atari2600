------- FILE scalecrown.asm
------- FILE room_kernel.asm LEVEL 2 PASS 2
      0  04ba					      include	"room_kernel.asm"
      1  04ba							; room_kernel.asm - bank 0: the room
      2  04ba							;
      3  04ba							; Entered from the HUD (hud.asm, bank 7) in HUD line 28,
      4  04ba							; when Sir Roderick has his column for the room. Lines
      5  04ba							; 29-31 of the HUD (black) switch the ball on if the room
      6  04ba							; has a plug (it closes the outer opening of the rooms at
      7  04ba							; the ends of a level; the ball has the colour of the
      8  04ba							; playfield, the wall's) and read what the first line of
      9  04ba							; the room needs; then the 160 lines of the room,
     10  04ba							; BOT_BLANK
     11  04ba							; black lines (PAL only); then the overscan starts and the
     12  04ba							; program goes back to bank 7.
     13  04ba							;
     14  04ba							; Cycle counts in the comments: the cycle at which a store
     15  04ba							; writes, counted from 0 at the start of the line; a "+" is
     16  04ba							; a load that can take one cycle more when its address
     17  04ba							; crosses a page.
     18  04ba
     19  04ba				   room_kernel
     20  04ba		       85 02		      sta	WSYNC	; HUD line 29
     21  04bc		       a5 96		      lda	plug	; the ball: black on black
     22  04be		       85 1f		      sta	ENABL	; until the room starts
     23  04c0		       a0 9f		      ldy	#159	; what line A0 of course 0
     24  04c2		       84 a8		      sty	idx	; needs
     25  04c4		       a9 13		      lda	#19
     26  04c6		       85 a9		      sta	trow
     27  04c8		       b1 a2		      lda	(cbk),y	; +
     28  04ca		       85 a6		      sta	zbk	; COLUBK of pair 0
     29  04cc		       b1 a4		      lda	(cpf),y	; +
     30  04ce		       85 a7		      sta	zt	; COLUPF of pair 0
     31  04d0		       ad 93 10 	      lda	SCR+SC_PF0+19	; course 0
     32  04d3		       85 aa		      sta	znpf0
     33  04d5		       ad a7 10 	      lda	SCR+SC_PF1+19
     34  04d8		       85 ab		      sta	znpf1
     35  04da		       ad bb 10 	      lda	SCR+SC_PF2+19
     36  04dd		       85 ac		      sta	znpf2	; for line A0
     37  04df		       85 02		      sta	WSYNC	; line 30
     38  04e1		       b1 9e		      lda	(kgfx),y	; +
     39  04e3		       aa		      tax
     40  04e4		       a4 a7		      ldy	zt
     41  04e6		       85 02		      sta	WSYNC	; line 31 stays empty
     42  04e8		       4c eb 14 	      jmp	k_top
     43  04eb
     44  04eb							; ---------------------------------------------------------
     45  04eb							; The room: 20 courses of 8 lines, each four pairs of lines
     46  04eb							; A and B. Lines A write the playfield colours, lines B the
     47  04eb							; colour of Sir Roderick; both write his figure.
     48  04eb							;
     49  04eb							; At the start of each line (after WSYNC) the registers hold
     50  04eb							; what the line writes first:
     51  04eb							;   line A: X = GRP0, Y = COLUPF
     52  04eb							;   line B: X = GRP0, Y = COLUP0
     53  04eb							; The rest of the line prepares the next one; idx is the
     54  04eb							; index (159 at the top) of the line being prepared.
     55  04eb							; The playfield changes once a course: A1, A2, A3 read the
     56  04eb							; next course from the Superchip RAM, A0 writes PF0, PF1
     57  04eb							; and PF2.
     58  04eb							; Lines B also write the colour of Sir Roderick to ENAM0:
     59  04eb							; bit 1 of it turns the blade (missile 0) on or off. Only in
     60  04eb							; the thrust can it show: otherwise RESMP0 keeps it hidden,
     61  04eb							; and in the thrust the colours are zero outside the figure
     62  04eb							; and have bit 1 only on the pair of the blade (art.py).
     63  04eb
     64  04eb					      MAC	line_a_rest
     65  04eb					      ldy	idx
     66  04eb					      dey
     67  04eb					      sty	idx
     68  04eb					      lda	(kcol),y	; +
     69  04eb					      sta	zt
     70  04eb					      lda	(kgfx),y	; +
     71  04eb					      tax
     72  04eb					      ldy	zt
     73  04eb					      ENDM		; prepares line B
     74  04eb
     75  04eb					      MAC	line_b_first
     76  04eb					      stx	GRP0	;  2
     77  04eb					      sty	COLUP0	;  5
     78  04eb					      sty	ENAM0	;  8 the blade: bit 1
     79  04eb					      ldy	idx
     80  04eb					      dey
     81  04eb					      sty	idx
     82  04eb					      ENDM
     83  04eb
     84  04eb					      MAC	line_b_rest
     85  04eb					      lda	(cbk),y	; +
     86  04eb					      sta	zbk
     87  04eb					      lda	(cpf),y	; +
     88  04eb					      sta	zt
     89  04eb					      lda	(kgfx),y	; +
     90  04eb					      tax
     91  04eb					      ldy	zt
     92  04eb					      ENDM		; prepares line A
     93  04eb
     94  04eb					      MAC	line_a_first
     95  04eb					      stx	GRP0	;  2
     96  04eb					      sty	COLUPF	;  5
     97  04eb					      lda	zbk
     98  04eb					      sta	COLUBK	; 11
     99  04eb					      ldx	trow
    100  04eb					      lda	SCR+{1},x
    101  04eb					      ENDM		; A1-A3: {1} = SC table
    102  04eb
    103  04eb		       85 02	   k_top      sta	WSYNC
    104  04ed		       86 1b	   k_a0       stx	GRP0	;  2
    105  04ef		       84 08		      sty	COLUPF	;  5
    106  04f1		       a5 a6		      lda	zbk
    107  04f3		       85 09		      sta	COLUBK	; 11
    108  04f5		       a5 aa		      lda	znpf0
    109  04f7		       85 0d		      sta	PF0	; 17
    110  04f9		       a5 ab		      lda	znpf1
    111  04fb		       85 0e		      sta	PF1	; 23
    112  04fd		       a5 ac		      lda	znpf2
    113  04ff		       85 0f		      sta	PF2	; 29
      0  0501					      LINE_A_REST
      1  0501		       a4 a8		      ldy	idx
      2  0503		       88		      dey
      3  0504		       84 a8		      sty	idx
      4  0506		       b1 a0		      lda	(kcol),y
      5  0508		       85 a7		      sta	zt
      6  050a		       b1 9e		      lda	(kgfx),y
      7  050c		       aa		      tax
      8  050d		       a4 a7		      ldy	zt
    115  050f		       85 02		      sta	WSYNC
      0  0511				   k_b0       LINE_B_FIRST
      1  0511		       86 1b		      stx	GRP0
      2  0513		       84 06		      sty	COLUP0
      3  0515		       84 1d		      sty	ENAM0
      4  0517		       a4 a8		      ldy	idx
      5  0519		       88		      dey
      6  051a		       84 a8		      sty	idx
      0  051c					      LINE_B_REST
      1  051c		       b1 a2		      lda	(cbk),y
      2  051e		       85 a6		      sta	zbk
      3  0520		       b1 a4		      lda	(cpf),y
      4  0522		       85 a7		      sta	zt
      5  0524		       b1 9e		      lda	(kgfx),y
      6  0526		       aa		      tax
      7  0527		       a4 a7		      ldy	zt
