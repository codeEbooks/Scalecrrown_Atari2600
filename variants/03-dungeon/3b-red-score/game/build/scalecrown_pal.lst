     13  755a		       aa		      tax
     14  755b		       b1 bf		      lda	(txp+6),y
     15  755d		       a4 a7		      ldy	zt
     16  755f		       ea		      nop
     17  7560		       85 1c		      sta	GRP1
     18  7562		       86 1b		      stx	GRP0
     19  7564		       84 1c		      sty	GRP1
     20  7566		       85 1b		      sta	GRP0
     21  7568		       a4 c5		      ldy	zt2
     22  756a		       88		      dey
     23  756b		       84 c5		      sty	zt2
