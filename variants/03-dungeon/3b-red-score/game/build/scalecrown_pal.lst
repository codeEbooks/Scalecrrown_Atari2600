      1  72f4							; knight.asm - bank 7: Sir Roderick
      2  72f4							;
      3  72f4							; the button starts a thrust of the sword, during which he
      4  72f4							; stands still; otherwise the joystick moves him, first
      5  72f4							; left or right, then up or down, each direction tried on
      6  72f4							; its own against the walls (so he slides along a wall
      7  72f4							; when pushed diagonally into it). Past the edge of the
      8  72f4							; screen he goes into the next room: east and west
      9  72f4							; through the openings, down and up by the stairs.
     10  72f4							; The speeds are in bank7.asm, one table for each
     11  72f4							; television (rules.py).
     12  72f4
     13  72f4				  -	      IF	V_INT != 0
     14  72f4				  -	      ERR		; one step at most per frame
     15  72f4					      ENDIF
     16  72f4				  -	      IF	STRIDE != 8
     17  72f4				  -	      ERR		; the walk divides by 8
     18  72f4					      ENDIF
