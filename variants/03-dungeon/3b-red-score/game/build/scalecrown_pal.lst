------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 3 of the chain of the book: the dungeon
      3  8000 ????						;
      4  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      5  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      6  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four
      7  8000 ????						; levels (dungeon.py).
      8  8000 ????						; The joystick moves him, the walls stop him, the button
      9  8000 ????						; thrusts the sword; RESET starts again.
     10  8000 ????						; The openings east and west lead to the rooms beside, the
     11  8000 ????						; stairs to the level below and back; the ball closes the
     12  8000 ????						; outer side of the rooms at the ends of a level. The HUD:
     13  8000 ????						; the score, the energy, the name of the level.
     14  8000 ????						; The doors are open.
     15  8000 ????						;
     16  8000 ????						; Banks (the address of each one for the 6507):
     17  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     18  8000 ????						;   1 ($3000) the title: only its tail before step 8
     19  8000 ????						;   2 ($5000) the throne room: only its tail before
     20  8000 ????						;	       step 6
     21  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     22  8000 ????						;   4 ($9000) the things: only its tail before step 4
     23  8000 ????						;   5 ($B000) sound: only its tail before step 7
     24  8000 ????						;   6 ($D000) the end screens: only its tail before
     25  8000 ????						;	       step 8
     26  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     27  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     28  8000 ????						; window and ends with the same tail (trampolines, reset).
     29  8000 ????						;
     30  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     31  8000 ????						;	  [-DPAL=1]
     32  8000 ????
     33  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     24  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here
     25  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     26  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1
     27  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     28  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on
     29  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     30  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     31  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball
     32  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed
     33  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed
     34  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     35  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     36  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves
     37  8000 ????
     38  8000 ????						; TIA, read side
     39  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     40  8000 ????
     41  8000 ????						; RIOT
     42  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     43  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     44  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     45  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     35  8000 ????
     36  8000 ????			  -	      IFNCONST	PAL
     37  8000 ????			  -PAL	      =	0
     38  8000 ????				      ENDIF
     39  8000 ????
     40  8000 ????				      IF	PAL
     41  8000 ????	       00 12	   TOP_BLANK  =	18	; black lines above the HUD
     42  8000 ????	       00 12	   BOT_BLANK  =	18	; and below the room
     43  8000 ????	       00 36	   VBLANK_TIM =	54
     44  8000 ????	       00 2b	   OVER_TIM   =	43
     45  8000 ????			  -	      ELSE
     46  8000 ????			  -TOP_BLANK  =	0
     47  8000 ????			  -BOT_BLANK  =	0
     48  8000 ????			  -VBLANK_TIM =	44
     49  8000 ????			  -OVER_TIM   =	35
     50  8000 ????				      ENDIF
     51  8000 ????
     52  8000 ????						; F4: an access to $1FF4 + n selects bank n
     53  8000 ????	       1f f4	   F4B0       =	$1FF4
     54  8000 ????	       1f f5	   F4B1       =	$1FF5
     55  8000 ????	       1f f6	   F4B2       =	$1FF6
     56  8000 ????	       1f f7	   F4B3       =	$1FF7
     57  8000 ????	       1f f8	   F4B4       =	$1FF8
     58  8000 ????	       1f f9	   F4B5       =	$1FF9
     59  8000 ????	       1f fa	   F4B6       =	$1FFA
     60  8000 ????	       1f fb	   F4B7       =	$1FFB
     61  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     62  8000 ????	       10 00	   SCW	      =	$1000
     63  8000 ????	       10 80	   SCR	      =	$1080
     64  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     65  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     66  8000 ????	       00 28	   SC_PF2     =	40
     67  8000 ????
     68  8000 ????						; trampolines, the same addresses in every bank
     69  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
     70  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
     71  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
     72  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
     73  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
     74  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
     75  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
     76  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
     77  8000 ????
     78  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD
     79  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
     80  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
     81  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
     82  8000 ????	       00 18	   KNIGHT_H   =	24
     83  8000 ????
     84  8000 ????						; ---------------------------------------------------------
     85  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
     86  8000 ????						;
     87  8000 ????						; Every variable has one owner, the part of the program
     88  8000 ????						; that writes it (the others read it); the groups below say
     89  8000 ????						; which.
     90  8000 ????
     91 U00ca ????				      SEG.U	ram
     92 U0080					      ORG	$80
     93 U0080							; == state (main.asm): frame, screens, buttons, the game
     94 U0080							; == (knight.asm changes room and screen on the way out)
     95 U0080		       00	   frames     ds	1	; frame counter
     96 U0081		       00	   screen     ds	1	; 1-16: a room (room + 1)
     97 U0082		       00	   shown      ds	1	; the screen set up in the SC
     98 U0083		       00	   held       ds	1	; buttons down a frame ago
     99 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
    100 U0085							; RESET $01
    101 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    102 U0086		       00 00 00    score      ds	3	; BCD, six digits
    103 U0089		       00	   energy     ds	1	; 0-12: the bar of the HUD
    104 U008a							; == Sir Roderick (knight.asm)
    105 U008a		       00	   kx	      ds	1	; column, 0-149
    106 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    107 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    108 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    109 U008e		       00	   kdist      ds	1	; units walked: pose of the walk
    110 U008f		       00	   hacc       ds	1	; fraction of a step: sideways,
    111 U0090		       00	   vacc       ds	1	; up and down
    112 U0091		       00	   thrust     ds	1	; frames of the thrust still to go
    113 U0092		       00	   moved      ds	1	; he moved in this frame
    114 U0093		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    115 U0094		       00	   swnus      ds	1
    116 U0095		       00	   swres      ds	1
    117 U0096							; == the plug (main.asm: setup_room)
    118 U0096		       00	   plug       ds	1	; ENABL in the room: 2 the ball
    119 U0097							; == the collision test (knight.asm: box_free, wall)
    120 U0097		       00 00	   cmap       ds	2	; collision map of the room
    121 U0099							; (main.asm: room_state)
    122 U0099		       00	   nx	      ds	1	; the box tried: column, top line
    123 U009a		       00	   ny	      ds	1
    124 U009b		       00	   bc0	      ds	1	; its block columns, left, right
    125 U009c		       00	   bc1	      ds	1
    126 U009d		       00	   br	      ds	1	; 3 x the block row tested (its
    127 U009e							; first byte in the map)
    128 U009e							; == the kernels (main.asm prepares; room_kernel.asm)
    129 U009e		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    130 U00a0		       00 00	   kcol       ds	2
    131 U00a2		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    132 U00a4		       00 00	   cpf	      ds	2
    133 U00a6		       00	   zbk	      ds	1	; COLUBK of the next line A
    134 U00a7		       00	   zt	      ds	1	; colour for Y at the end of a line
    135 U00a8		       00	   idx	      ds	1	; index of the line being prepared
    136 U00a9		       00	   trow       ds	1	; Superchip index of the next course
    137 U00aa		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    138 U00ab		       00	   znpf1      ds	1
    139 U00ac		       00	   znpf2      ds	1
    140 U00ad							; == the HUD (main.asm prepares; hud.asm)
    141 U00ad		       00 00 00 00*dig	      ds	12	; the six columns of digits
    142 U00b9		       00 00 00 00*txp	      ds	12	; and of the name of the level
    143 U00c5		       00	   zt2	      ds	1
    144 U00c6		       00	   bar1       ds	1	; energy bar: PF1, PF2
    145 U00c7		       00	   bar2       ds	1
    146 U00c8							; == scratch (anyone; never kept across a call)
    147 U00c8		       00 00	   tmp	      ds	2
    148 U00ca				   ram_end
    149 U00ca
    150 U00ca							; ---------------------------------------------------------
    151 U00ca							; the banks
    152 U00ca
    153 U00ca					      MAC	bank
    154 U00ca					      SEG	bank{1}
    155 U00ca					      ORG	{1}*$1000
    156 U00ca					      RORG	$1000+{1}*$2000
    157 U00ca					      ds	256, 0	; the Superchip window
    158 U00ca					      ENDM		; {1}: bank number
    159 U00ca
    160 U00ca					      MAC	tail
    161 U00ca					      ORG	{1}*$1000+$FAA
    162 U00ca					      RORG	$1FAA+{1}*$2000
    163 U00ca					      sta	F4B6	; $FAA: to the end screens
    164 U00ca					      jmp	ends_kernel
    165 U00ca					      sta	F4B2	; $FB0: to the throne kernel
    166 U00ca					      jmp	throne_kernel
    167 U00ca					      sta	F4B4	; $FB6: (jsr here) bank 4
    168 U00ca					      jsr	things	; $FB9: in bank 4
    169 U00ca					      sta	F4B7	; $FBC: bank 7 again
    170 U00ca					      rts		; $FBF: in bank 7
    171 U00ca					      sta	F4B0	; $FC0: to the room kernel
    172 U00ca					      jmp	room_kernel
    173 U00ca					      sta	F4B1	; $FC6: to the title kernel
    174 U00ca					      jmp	title_kernel
    175 U00ca					      sta	F4B7	; $FCC: back to the frame
    176 U00ca					      jmp	kernel_done
    177 U00ca					      sta	F4B5	; $FD2: (jsr here) bank 5
    178 U00ca					      jsr	sound	; $FD5: in bank 5
    179 U00ca					      sta	F4B7	; $FD8: bank 7 again
    180 U00ca					      rts		; $FDB: in bank 7
    181 U00ca					      ORG	{1}*$1000+$FE0
    182 U00ca					      RORG	$1FE0+{1}*$2000
    183 U00ca					      sta	F4B7	; $FE0: reset, in any bank
    184 U00ca					      jmp	start
    185 U00ca					      sta	F4B3	; $FE6: (jsr here) bank 3
    186 U00ca					      jsr	room_copy	; $FE9: in bank 3
    187 U00ca					      sta	F4B7	; $FEC: bank 7 again
    188 U00ca					      rts		; $FEF: in bank 7
    189 U00ca					      ORG	{1}*$1000+$FFC
    190 U00ca					      RORG	$1FFC+{1}*$2000
    191 U00ca					      .word	$1FE0+{1}*$2000
    192 U00ca					      .word	$1FE0+{1}*$2000
    193 U00ca					      ENDM		; {1}: bank number
    194 U00ca
    195 U00ca							; A bank whose code comes in a later step has only its
    196 U00ca							; tail, and the routine its trampoline goes to is a stub:
    197 U00ca							; never called before that step.
    198 U00ca
    199 U00ca							; --- bank 0: the room -------------------------------------
      0 U00ca					      BANK	0
      1  1000 ????				      SEG	bank0
      2  0000					      ORG	0*$1000
      3  0000					      RORG	$1000+0*$2000
      4  0000		       00 00 00 00*	      ds	256, 0
