      4  7548		       85 1b		      sta	GRP0
      5  754a		       85 02		      sta	WSYNC
      6  754c		       b1 bb		      lda	(txp+2),y
      7  754e		       85 1c		      sta	GRP1
      8  7550		       b1 bd		      lda	(txp+4),y
      9  7552		       85 1b		      sta	GRP0
     10  7554		       b1 c3		      lda	(txp+10),y
     11  7556		       85 a7		      sta	zt
