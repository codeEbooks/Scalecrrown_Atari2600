------- FILE hud.asm LEVEL 2 PASS 2
      0  7499					      include	"hud.asm"
      1  7499							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  7499							;
      3  7499							; Entered right after the WSYNC that ends the VBLANK, at
      4  7499							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  7499							; lines (PAL only), then the HUD:
      6  7499							;   lines 1-9	  the six digits of the score
      7  7499							;   lines 12-15  the energy bar
      8  7499							;   lines 17-25  LEVEL n
      9  7499							;   lines 26-28  Sir Roderick to his column
     10  7499							; and goes on to bank 0 (room_kernel.asm) in line 28.
     11  7499							;
     12  7499							; Cycle counts in the comments: the cycle at which a store
     13  7499							; writes, counted from 0 at the start of the line.
     14  7499
     15  7499				   hud
     16  7499		       a9 00		      lda	#0
     17  749b		       85 01		      sta	VBLANK	; the picture starts
     18  749d					      IF	TOP_BLANK
     19  749d		       a0 12		      ldy	#TOP_BLANK
     20  749f		       85 02	   hu_top     sta	WSYNC
     21  74a1		       88		      dey
     22  74a2		       d0 fb		      bne	hu_top
     23  74a4					      ENDIF
     24  74a4		       a9 64		      lda	#SCORE_COL	; HUD line 0
     25  74a6		       85 06		      sta	COLUP0
     26  74a8		       85 07		      sta	COLUP1
     27  74aa		       85 02		      sta	WSYNC
     28  74ac		       20 14 f5 	      jsr	hud_digits	; lines 1-9: the six digits
     29  74af		       85 02		      sta	WSYNC	; line 10
     30  74b1		       a9 00		      lda	#0
     31  74b3		       85 1b		      sta	GRP0
     32  74b5		       85 1c		      sta	GRP1
     33  74b7		       85 1b		      sta	GRP0	; empty the delayed copies
     34  74b9		       a0 03		      ldy	#3
     35  74bb		       85 02		      sta	WSYNC	; line 11
     36  74bd		       85 02		      sta	WSYNC	; line 12
     37  74bf				   hu_bar		; lines 12-15: energy
     38  74bf		       b9 c8 f5 	      lda	BAR_COL,y
     39  74c2		       85 08		      sta	COLUPF	;  6
     40  74c4		       a5 c6		      lda	bar1
     41  74c6		       85 0e		      sta	PF1	; 12
     42  74c8		       a5 c7		      lda	bar2
     43  74ca		       85 0f		      sta	PF2	; 18
     44  74cc		       85 02		      sta	WSYNC
     45  74ce		       88		      dey
     46  74cf		       10 ee		      bpl	hu_bar
     47  74d1		       a9 00		      lda	#0	; line 16
     48  74d3		       85 0e		      sta	PF1
     49  74d5		       85 0f		      sta	PF2
     50  74d7		       85 08		      sta	COLUPF	; the room's PF2 unseen
     51  74d9		       a9 0c		      lda	#TEXT_COL
     52  74db		       85 06		      sta	COLUP0
     53  74dd		       85 07		      sta	COLUP1
     54  74df		       85 02		      sta	WSYNC
     55  74e1		       20 42 f5 	      jsr	hud_text	; lines 17-25: LEVEL n
     56  74e4		       a5 8a		      lda	kx
     57  74e6		       85 02		      sta	WSYNC	; (the end of line 25)
     58  74e8							; line 26: Sir Roderick to column kx, as place does
     59  74e8							; it (the stores take 4 cycles, like sta HMP0,x)
     60  74e8		       38		      sec
     61  74e9		       e9 0f	   hu_p0      sbc	#15
     62  74eb		       b0 fc		      bcs	hu_p0	; (hu_p0)
     63  74ed		       49 07		      eor	#7
     64  74ef		       0a		      asl
     65  74f0		       0a		      asl
     66  74f1		       0a		      asl
     67  74f2		       0a		      asl
     68  74f3		       8d 20 00 	      sta.w	HMP0
     69  74f6		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     70  74f9		       85 02		      sta	WSYNC	; 71 at most
     71  74fb							; line 27: empty
     72  74fb		       85 02		      sta	WSYNC
     73  74fd							; line 28: the fine moves, the room's settings
     74  74fd		       85 2a		      sta	HMOVE	;  2
     75  74ff		       a5 8c		      lda	kdir
     76  7501		       85 0b		      sta	REFP0
     77  7503		       a9 00		      lda	#0
     78  7505		       85 25		      sta	VDELP0
     79  7507		       85 26		      sta	VDELP1
     80  7509		       85 06		      sta	COLUP0
     81  750b		       85 1c		      sta	GRP1	; (the HUD may leave it on)
     82  750d		       a5 94		      lda	swnus
     83  750f		       85 04		      sta	NUSIZ0	; the width of the blade
     84  7511		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
     85  7514
     86  7514							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
     87  7514							; columns read through six pointers: {1} ... {1}+10 (dig:
     88  7514							; the digits of the score; txp: the name of the level, in
     89  7514							; this bank). Called on the line before the first one.
     90  7514							; Both players are delayed (VDELP0, VDELP1) and have three
     91  7514							; copies 16 pixels apart:
     92  7514							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
     93  7514							; A delayed player shows the value written before the last
     94  7514							; write to the other player, so the four writes at the end
     95  7514							; change the copies on the right while the beam is between
     96  7514							; them.
     97  7514					      MAC	hud48
     98  7514					      ldy	#7
     99  7514					      sty	zt2
    100  7514				   .loop      lda	({1}),y
    101  7514					      sta	GRP0	; column 1 (waits)
    102  7514					      sta	WSYNC
    103  7514					      lda	({1}+2),y
    104  7514					      sta	GRP1	;  7 col 2; col 1 shows
    105  7514					      lda	({1}+4),y
    106  7514					      sta	GRP0	; 15 col 3; col 2 shows
    107  7514					      lda	({1}+10),y
    108  7514					      sta	zt
    109  7514					      lda	({1}+8),y
    110  7514					      tax
    111  7514					      lda	({1}+6),y
    112  7514					      ldy	zt
    113  7514					      nop
    114  7514					      sta	GRP1	; 43 col 4; col 3 shows
    115  7514					      stx	GRP0	; 46 col 5; col 4 shows
    116  7514					      sty	GRP1	; 49 col 6; col 5 shows
    117  7514					      sta	GRP0	; 52 col 6 shows
    118  7514					      ldy	zt2
    119  7514					      dey
    120  7514					      sty	zt2
    121  7514					      bpl	.loop
    122  7514					      rts
    123  7514					      ENDM
    124  7514
    125  7514							; each routine in one page (as the blocks of the title: see
    126  7514							; title_kernel.asm); the padding comes after a jmp or an rts
    127  7514		       00 32	   HUD48_BYTES =	50
    128  7514
    129  7514				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    130  7514				  -	      ALIGN	256
    131  7514					      ENDIF
    132  7514				   hud_digits
      0  7514					      HUD48	dig
      1  7514		       a0 07		      ldy	#7
      2  7516		       84 c5		      sty	zt2
      3  7518		       b1 ad	   .loop      lda	(dig),y
      4  751a		       85 1b		      sta	GRP0
      5  751c		       85 02		      sta	WSYNC
      6  751e		       b1 af		      lda	(dig+2),y
      7  7520		       85 1c		      sta	GRP1
      8  7522		       b1 b1		      lda	(dig+4),y
      9  7524		       85 1b		      sta	GRP0
     10  7526		       b1 b7		      lda	(dig+10),y
     11  7528		       85 a7		      sta	zt
     12  752a		       b1 b5		      lda	(dig+8),y
     13  752c		       aa		      tax
     14  752d		       b1 b3		      lda	(dig+6),y
     15  752f		       a4 a7		      ldy	zt
     16  7531		       ea		      nop
     17  7532		       85 1c		      sta	GRP1
     18  7534		       86 1b		      stx	GRP0
     19  7536		       84 1c		      sty	GRP1
     20  7538		       85 1b		      sta	GRP0
     21  753a		       a4 c5		      ldy	zt2
     22  753c		       88		      dey
     23  753d		       84 c5		      sty	zt2
     24  753f		       10 d7		      bpl	.loop
     25  7541		       60		      rts
    134  7542				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    135  7542				  -	      ALIGN	256
    136  7542					      ENDIF
    137  7542				   hud_text
      0  7542					      HUD48	txp
