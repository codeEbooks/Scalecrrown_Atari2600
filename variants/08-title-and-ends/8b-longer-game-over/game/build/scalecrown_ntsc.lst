      0  7100					      include	"main.asm"
      1  7100							; main.asm - bank 7: start, the frame, and what is done
      2  7100							; in it besides the kernels:
      3  7100							; - the title, SELECT, the end screens (bank 6) and their
      4  7100							;   songs;
      5  7100							; - the buttons: RESET starts again;
      6  7100							; - GAME OVER, VICTORY;
      7  7100							; - setting a room up: its playfield comes from bank 3
      8  7100							;   into the Superchip RAM;
      9  7100							; - what the kernels need: Sir Roderick, the colours of
     10  7100							;   the room, the HUD, the bands of player 1, the King or
     11  7100							;   the crown on player 1, the venom on missile 1.
     12  7100							; In the overscan the things of the room, the guards and
     13  7100							; the Serpent King (bank 4, in a game) and the sound
     14  7100							; player (bank 5).
     15  7100
     16  7100				   start
     17  7100		       78		      sei
     18  7101		       d8		      cld
     19  7102		       a2 00		      ldx	#0
     20  7104		       8a		      txa
