------- FILE ends_kernel.asm LEVEL 2 PASS 2
      0  6100					      include	"ends_kernel.asm"
      1  6100							; ends_kernel.asm - bank 6: the end screens
      2  6100							;
      3  6100							; GAME OVER and VICTORY. Entered as the title kernel is
      4  6100							; (main.asm: jmp TO_ENDS right after the WSYNC that ends the
      5  6100							; VBLANK), and laid out like the title: 192 lines (PAL: 18
      6  6100							; black lines above and below), drawn with the two macros of
      7  6100							; title_kernel.asm on the tables of this bank (bank6.asm):
      8  6100							;   lines 0-3	 both players to the column of the blocks
      9  6100							;   decor	 the pillars and torches of the title in
     10  6100							;		 the colours of the screen: cold embers
     11  6100							;		 for GAME OVER, bright flames for VICTORY
     12  6100							;   blocks	 48 pixels wide: the crown (whole for GAME
     13  6100							;		 OVER, the curse goes on; broken for
     14  6100							;		 VICTORY), GAME and OVER or VICTORY, the
     15  6100							;		 score. Its six digits are columns of 9
     16  6100							;		 bytes in the Superchip RAM (main.asm:
     17  6100							;		 end_score): the block reads them as it
     18  6100							;		 reads its tables
     19  6100							;   the scene	 lines 128-131 place the players; GAME
     20  6100							;		 OVER: the Serpent King alone; VICTORY:
     21  6100							;		 Sir Roderick and the pieces of the crown
     22  6100							; won (not 0: VICTORY) chooses the screen. Leaves through
     23  6100							; TO_MAIN, as the title.
     24  6100
     25  6100							; SCENE: the players of the scene ({1}: GO or VI): columns
     26  6100							; {1}_P0X, {1}_P1X, NUSIZ1 {1}_NUS1, REFP1 {1}_REF1, then
     27  6100							; SCN_H lines of the tables {1}_SK, _SKC (player 0) and
     28  6100							; {1}_SO, _SOC (player 1), bottom first
     29  6100					      MAC	scene
     30  6100					      lda	#{1}_P0X
     31  6100					      ldx	#0
     32  6100					      jsr	e_place	; line 128
     33  6100					      lda	#{1}_P1X
     34  6100					      ldx	#1
     35  6100					      jsr	e_place	; line 129
     36  6100					      sta	WSYNC	; line 130
     37  6100					      sta	HMOVE
     38  6100					      lda	#0
     39  6100					      sta	NUSIZ0
     40  6100					      sta	VDELP0
     41  6100					      sta	VDELP1
     42  6100					      sta	REFP0
     43  6100					      lda	#{1}_NUS1
     44  6100					      sta	NUSIZ1
     45  6100					      lda	#{1}_REF1
     46  6100					      sta	REFP1
     47  6100					      sta	HMCLR	; 30: 27 cycles after HMOVE
     48  6100					      sta	WSYNC	; line 131
     49  6100					      ldy	#SCN_H-1
     50  6100				   .sc	      sta	WSYNC	; lines 132-172
     51  6100					      lda	{1}_SK,y
     52  6100					      sta	GRP0	;  6
     53  6100					      lda	{1}_SKC,y
     54  6100					      sta	COLUP0	; 13
     55  6100					      lda	{1}_SO,y
     56  6100					      sta	GRP1	; 20
     57  6100					      lda	{1}_SOC,y
     58  6100					      sta	COLUP1	; 27
     59  6100					      dey
     60  6100					      bpl	.sc
     61  6100					      ENDM
