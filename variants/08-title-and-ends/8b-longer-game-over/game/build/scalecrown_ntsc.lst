------- FILE scalecrown.asm LEVEL 1 PASS 2
      1  8000 ????						; scalecrown.asm - Scalecrown
      2  8000 ????						; Step 8 of the chain of the book: the title and the
      3  8000 ????						; end screens
      4  8000 ????						;
      5  8000 ????						; A 32K cartridge with the Superchip (F4SC): eight banks of
      6  8000 ????						; 4K and 128 bytes of RAM in the cartridge.
      7  8000 ????						; The title (bank 1) with three modes of sound: SELECT
      8  8000 ????						; chooses MUSIC, SOUND FX or SILENT; the button or RESET
      9  8000 ????						; starts a game.
     10  8000 ????						; Sir Roderick in the Crypt of Scales: 16 rooms in four
     11  8000 ????						; levels (dungeon.py).
     12  8000 ????						; The joystick moves him, the walls stop him, the button
     13  8000 ????						; thrusts the sword; RESET starts again.
     14  8000 ????						; The openings east and west lead to the rooms beside, the
     15  8000 ????						; stairs to the level below and back; the ball closes the
     16  8000 ????						; outer side of the rooms at the ends of a level. The HUD:
     17  8000 ????						; the score, the energy, the name of the level.
     18  8000 ????						; The things: a chest in each level gives the key of the
     19  8000 ????						; level's door (a grate on the stair down; the golden gate
     20  8000 ????						; before the throne room); spikes go up and down in eight
     21  8000 ????						; rooms; points for chests and doors.
     22  8000 ????						; The serpents: one or two in a room, crawling to and fro,
     23  8000 ????						; faster in the lower levels; a bite takes energy, and so
     24  8000 ????						; do the spikes; a wound makes him flash; energy 0: GAME
     25  8000 ????						; OVER.
     26  8000 ????						; A thrust of the sword kills a serpent (they are back
     27  8000 ????						; when he comes in again).
     28  8000 ????						; Player 1 shows two things: the kernel moves it in the
     29  8000 ????						; middle of the room (the seam) to the serpent of the band
     30  8000 ????						; below; two things in the same lines take turns.
     31  8000 ????						; The Serpent King: in the throne room, drawn by its own
     32  8000 ????						; kernel (bank 2), he goes up and down to meet Sir
     33  8000 ????						; Roderick and spits venom (missile 1) at him; the oak
     34  8000 ????						; shield parries what comes from the side Sir Roderick
     35  8000 ????						; faces. Ten blows beat the King; the crown appears on the
     36  8000 ????						; throne; struck, it breaks: VICTORY.
     37  8000 ????						; The sound (bank 5): the theme, and the effects of the
     38  8000 ????						; sword, the stairs, the things, the bites and the blows.
     39  8000 ????						; After GAME OVER or VICTORY the end screen (bank 6) with
     40  8000 ????						; the score; the button goes back to the title, RESET
     41  8000 ????						; starts a game. A lament for GAME OVER and a fanfare for
     42  8000 ????						; VICTORY play once (MUSIC); a new song, as a new mode,
     43  8000 ????						; first silences what played.
     44  8000 ????						;
     45  8000 ????						; Banks (the address of each one for the 6507):
     46  8000 ????						;   0 ($1000) the room: kernel, figures, colours
     47  8000 ????						;   1 ($3000) the title: kernel, letters
     48  8000 ????						;   2 ($5000) the throne room: its kernel, the King, the
     49  8000 ????						;	       crown, its colours
     50  8000 ????						;   3 ($7000) the rooms: their playfield, the copy
     51  8000 ????						;   4 ($9000) the things: chests, doors, spikes
     52  8000 ????						;	       the serpents, the Serpent King
     53  8000 ????						;   5 ($B000) sound: player, music, effects
     54  8000 ????						;   6 ($D000) the end screens: their kernel, the crown
     55  8000 ????						;	       whole and broken, the words, scenes
     56  8000 ????						;   7 ($F000) start, frame, logic, HUD, room tables
     57  8000 ????						; Every bank starts with the 256 bytes of the Superchip
     58  8000 ????						; window and ends with the same tail (trampolines, reset).
     59  8000 ????						; Banks 0 and 2 then start with the same bytes: Sir
     60  8000 ????						; Roderick's figures and colours (kfig0.asm, kfig2.asm), so
     61  8000 ????						; that the pointers to them work in both kernels.
     62  8000 ????						;
     63  8000 ????						;   dasm scalecrown.asm -f3 -S -I../assets/generated
     64  8000 ????						;	  [-DPAL=1]
     65  8000 ????
     66  8000 ????				      processor	6502
------- FILE hw.asm LEVEL 2 PASS 2
      0  8000 ????				      include	"hw.asm"
      1  8000 ????						; hw.asm - the registers Scalecrown uses, by name
      2  8000 ????						;
      3  8000 ????						; Written for the game: only the names it needs, with the
      4  8000 ????						; addresses of the TIA and of the RIOT (6532).
      5  8000 ????
      6  8000 ????						; TIA, write side
      7  8000 ????	       00 00	   VSYNC      =	$00	; bit 1: vertical sync
      8  8000 ????	       00 01	   VBLANK     =	$01	; bit 1: picture off
      9  8000 ????	       00 02	   WSYNC      =	$02	; any write: wait for the line end
     10  8000 ????	       00 04	   NUSIZ0     =	$04	; size and copies, player 0
     11  8000 ????	       00 05	   NUSIZ1     =	$05	; size and copies, player 1
     12  8000 ????	       00 06	   COLUP0     =	$06	; colour of player 0
     13  8000 ????	       00 07	   COLUP1     =	$07	; colour of player 1
     14  8000 ????	       00 08	   COLUPF     =	$08	; colour of the playfield
     15  8000 ????	       00 09	   COLUBK     =	$09	; colour of the background
     16  8000 ????	       00 0a	   CTRLPF     =	$0A	; bit 0: reflected playfield
     17  8000 ????	       00 0b	   REFP0      =	$0B	; bit 3: player 0 mirrored
     18  8000 ????	       00 0c	   REFP1      =	$0C	; bit 3: player 1 mirrored
     19  8000 ????	       00 0d	   PF0	      =	$0D	; playfield, bits 4-7
     20  8000 ????	       00 0e	   PF1	      =	$0E	; playfield, bits 7-0
     21  8000 ????	       00 0f	   PF2	      =	$0F	; playfield, bits 0-7
     22  8000 ????	       00 10	   RESP0      =	$10	; any write: player 0 starts here
     23  8000 ????	       00 11	   RESP1      =	$11	; any write: player 1 starts here
     24  8000 ????	       00 12	   RESM0      =	$12	; any write: missile 0 starts here
     25  8000 ????	       00 13	   RESM1      =	$13	; any write: missile 1 starts here
     26  8000 ????	       00 14	   RESBL      =	$14	; any write: the ball starts here
     27  8000 ????	       00 15	   AUDC0      =	$15	; sound, voice 0: waveform (0-15)
     28  8000 ????	       00 16	   AUDC1      =	$16	; voice 1
     29  8000 ????	       00 17	   AUDF0      =	$17	; voice 0: frequency divider (0-31)
     30  8000 ????	       00 18	   AUDF1      =	$18	; voice 1
     31  8000 ????	       00 19	   AUDV0      =	$19	; voice 0: volume (0-15)
     32  8000 ????	       00 1a	   AUDV1      =	$1A	; voice 1
     33  8000 ????	       00 1b	   GRP0       =	$1B	; graphics of player 0
     34  8000 ????	       00 1c	   GRP1       =	$1C	; graphics of player 1
     35  8000 ????	       00 1d	   ENAM0      =	$1D	; bit 1: missile 0 on
     36  8000 ????	       00 1e	   ENAM1      =	$1E	; bit 1: missile 1 on
     37  8000 ????	       00 1f	   ENABL      =	$1F	; bit 1: the ball on
     38  8000 ????	       00 20	   HMP0       =	$20	; fine move of player 0
     39  8000 ????	       00 21	   HMP1       =	$21	; fine move of player 1
     40  8000 ????	       00 22	   HMM0       =	$22	; fine move of missile 0
     41  8000 ????	       00 23	   HMM1       =	$23	; fine move of missile 1
     42  8000 ????	       00 24	   HMBL       =	$24	; fine move of the ball
     43  8000 ????	       00 25	   VDELP0     =	$25	; bit 0: player 0 delayed
     44  8000 ????	       00 26	   VDELP1     =	$26	; bit 0: player 1 delayed
     45  8000 ????	       00 28	   RESMP0     =	$28	; bit 1: missile 0 off, on player 0
     46  8000 ????	       00 29	   RESMP1     =	$29	; bit 1: missile 1 off, on player 1
     47  8000 ????	       00 2a	   HMOVE      =	$2A	; any write: apply the fine moves
     48  8000 ????	       00 2b	   HMCLR      =	$2B	; any write: clear the fine moves
     49  8000 ????
     50  8000 ????						; TIA, read side
     51  8000 ????	       00 0c	   INPT4      =	$0C	; bit 7: left fire button, 0 = down
     52  8000 ????
     53  8000 ????						; RIOT
     54  8000 ????	       02 80	   SWCHA      =	$0280	; joysticks, 0 = pressed
     55  8000 ????	       02 82	   SWCHB      =	$0282	; console switches, 0 = pressed
     56  8000 ????	       02 84	   INTIM      =	$0284	; the timer
     57  8000 ????	       02 96	   TIM64T     =	$0296	; start the timer, 64 cycles a step
------- FILE scalecrown.asm
     68  8000 ????
     69  8000 ????			  -	      IFNCONST	PAL
     70  8000 ????			  -PAL	      =	0
     71  8000 ????				      ENDIF
     72  8000 ????
     73  8000 ????			  -	      IF	PAL
     74  8000 ????			  -TOP_BLANK  =	18	; black lines above the HUD
     75  8000 ????			  -BOT_BLANK  =	18	; and below the room
     76  8000 ????			  -VBLANK_TIM =	54
     77  8000 ????			  -OVER_TIM   =	43
     78  8000 ????				      ELSE
     79  8000 ????	       00 00	   TOP_BLANK  =	0
     80  8000 ????	       00 00	   BOT_BLANK  =	0
     81  8000 ????	       00 2c	   VBLANK_TIM =	44
     82  8000 ????	       00 23	   OVER_TIM   =	35
     83  8000 ????				      ENDIF
     84  8000 ????
     85  8000 ????						; F4: an access to $1FF4 + n selects bank n
     86  8000 ????	       1f f4	   F4B0       =	$1FF4
     87  8000 ????	       1f f5	   F4B1       =	$1FF5
     88  8000 ????	       1f f6	   F4B2       =	$1FF6
     89  8000 ????	       1f f7	   F4B3       =	$1FF7
     90  8000 ????	       1f f8	   F4B4       =	$1FF8
     91  8000 ????	       1f f9	   F4B5       =	$1FF9
     92  8000 ????	       1f fa	   F4B6       =	$1FFA
     93  8000 ????	       1f fb	   F4B7       =	$1FFB
     94  8000 ????						; Superchip: written at $1000-$107F, read at $1080-$10FF
     95  8000 ????	       10 00	   SCW	      =	$1000
     96  8000 ????	       10 80	   SCR	      =	$1080
     97  8000 ????	       00 00	   SC_PF0     =	0	; the room: PF0 of the 20 courses,
     98  8000 ????	       00 14	   SC_PF1     =	20	; course c at index 19 - c
     99  8000 ????	       00 28	   SC_PF2     =	40
    100  8000 ????	       00 3c	   SC_SX      =	60	; the guards: columns (two),
    101  8000 ????	       00 3e	   SC_SD      =	62	; facing: 0 right, 8 left (two),
    102  8000 ????	       00 40	   SC_LIVE    =	64	; alive: bit 0 the first, bit 1 the
    103  8000 ????						; second;
    104  8000 ????	       00 41	   SC_ACC     =	65	; the fraction of their crawl (the
    105  8000 ????						; King's steps);
    106  8000 ????	       00 42	   SC_HM      =	66	; HMP1 for the seam (the fine move)
    107  8000 ????	       00 43	   SC_KT      =	67	; the Serpent King: top line,
    108  8000 ????	       00 44	   SC_KH      =	68	; blows he has had,
    109  8000 ????	       00 45	   SC_KF      =	69	; frames of his flash after a blow,
    110  8000 ????	       00 46	   SC_KS      =	70	; frames before he spits;
    111  8000 ????	       00 47	   SC_VP      =	71	; the venom: its first pixel,
    112  8000 ????	       00 48	   SC_VD      =	72	; 0 none, 1 flying right, 2 left,
    113  8000 ????	       00 49	   SC_VA      =	73	; the fraction of its flight;
    114  8000 ????	       00 4a	   SC_CROWN   =	74	; 0 the King, 1 the crown, 2 broken
    115  8000 ????						; (new_game: 0; it stays when he
    116  8000 ????						; leaves the throne room)
    117  8000 ????
    118  8000 ????						; trampolines, the same addresses in every bank
    119  8000 ????	       1f aa	   TO_ENDS    =	$1FAA	; -> bank 6, ends_kernel
    120  8000 ????	       1f b0	   TO_THRONE  =	$1FB0	; -> bank 2, throne_kernel
    121  8000 ????	       1f b6	   TO_THINGS  =	$1FB6	; jsr: bank 4, things, back to 7
    122  8000 ????	       1f c0	   TO_ROOM    =	$1FC0	; -> bank 0, room_kernel
    123  8000 ????	       1f c6	   TO_TITLE   =	$1FC6	; -> bank 1, title_kernel
    124  8000 ????	       1f cc	   TO_MAIN    =	$1FCC	; -> bank 7, kernel_done
    125  8000 ????	       1f d2	   TO_SOUND   =	$1FD2	; jsr: bank 5, sound, back to 7
    126  8000 ????	       1f e6	   TO_COPY    =	$1FE6	; jsr: bank 3, room_copy, back
    127  8000 ????
    128  8000 ????	       00 33	   SCORE_X    =	51	; the six digits of the HUD
    129  8000 ????	       00 03	   FIRST_PIXEL =	3	; a player: first pixel = column + 3
    130  8000 ????	       00 02	   M_OFFSET   =	2	; a missile: column + 2
    131  8000 ????	       00 08	   KNIGHT_W   =	8	; Sir Roderick: 8 x 24
    132  8000 ????	       00 18	   KNIGHT_H   =	24
    133  8000 ????
    134  8000 ????						; ---------------------------------------------------------
    135  8000 ????						; RAM: 128 bytes, $80-$FF, the stack at the top
    136  8000 ????						;
    137  8000 ????						; Every variable has one owner, the part of the program
    138  8000 ????						; that writes it (the others read it); the groups below say
    139  8000 ????						; which.
    140  8000 ????
    141 U00f4 ????				      SEG.U	ram
    142 U0080					      ORG	$80
    143 U0080							; == state (main.asm): frame, screens, buttons, the game
    144 U0080							; == (knight.asm changes room and screen on the way out)
    145 U0080		       00	   frames     ds	1	; frame counter
    146 U0081		       00	   screen     ds	1	; 0 title, 1-16 a room (room + 1)
    147 U0082		       00	   shown      ds	1	; the screen set up in the SC
    148 U0083		       00	   held       ds	1	; buttons down a frame ago
    149 U0084		       00	   pressed    ds	1	; pressed now: fire $80, SELECT $02,
    150 U0085							; RESET $01
    151 U0085		       00	   room       ds	1	; 0-15: level room / 4 + 1
    152 U0086		       00 00 00    score      ds	3	; BCD, six digits (things.asm
    153 U0089							; adds the points)
    154 U0089		       00	   energy     ds	1	; 0-12 (things.asm: the wounds)
    155 U008a							; == Sir Roderick (knight.asm)
    156 U008a		       00	   kx	      ds	1	; column, 0-149
    157 U008b		       00	   ky	      ds	1	; top line, odd, 1-135
    158 U008c		       00	   kdir       ds	1	; 0 right, 8 left (REFP0)
    159 U008d		       00	   kpose      ds	1	; 0 stand, 1-2 steps, 3 thrust
    160 U008e		       00	   kdist      ds	1	; units walked: pose of the walk
    161 U008f		       00	   hacc       ds	1	; fraction of a step: sideways,
    162 U0090		       00	   vacc       ds	1	; up and down
    163 U0091		       00	   thrust     ds	1	; frames of the thrust still to go
    164 U0092		       00	   parry      ds	1	; frames of the parry still to
    165 U0093							; go (things.asm starts it)
    166 U0093		       00	   moved      ds	1	; he moved in this frame
    167 U0094		       00	   swx	      ds	1	; the blade: column, NUSIZ0, RESMP0
    168 U0095		       00	   swnus      ds	1
    169 U0096		       00	   swres      ds	1
    170 U0097							; == player 1, the plug (main.asm: setup_room,
    171 U0097							; == p1_bands: the thing of band A)
    172 U0097		       00	   ox	      ds	1	; column
    173 U0098		       00	   oy	      ds	1	; top line (odd)
    174 U0099		       00	   odir       ds	1	; 0 right, 8 left (REFP1)
    175 U009a		       00	   okind      ds	1	; first frame in the OG tables
    176 U009b		       00	   onus       ds	1	; NUSIZ1 in the room
    177 U009c		       00	   plug       ds	1	; ENABL in the room: 2 the ball
    178 U009d							; == the things (things.asm; new_game and setup_room
    179 U009d							; == start them)
    180 U009d		       00	   key	      ds	1	; the key he has: its level, 0 none
    181 U009e		       00	   opened     ds	1	; open: chests bits 0-3, doors 4-7
    182 U009f		       00	   spk	      ds	1	; frames left before the plates turn
    183 U00a0		       00	   spup       ds	1	; the plates: 0 down, 1 up
    184 U00a1		       00	   hurt       ds	1	; frames before a wound can come
    185 U00a2							; again (the spikes, a bite)
    186 U00a2							; == the collision test (knight.asm: box_free, wall)
    187 U00a2		       00 00	   cmap       ds	2	; collision map of the room
    188 U00a4							; (main.asm: room_state)
    189 U00a4		       00	   nx	      ds	1	; the box tried: column, top line
    190 U00a5		       00	   ny	      ds	1
    191 U00a6		       00	   bc0	      ds	1	; its block columns, left, right
    192 U00a7		       00	   bc1	      ds	1
    193 U00a8		       00	   br	      ds	1	; 3 x the block row tested (its
    194 U00a9							; first byte in the map)
    195 U00a9							; == sound (sound.asm; mode: main.asm, SELECT on the title;
    196 U00a9							; == sfxreq: knight.asm asks, sound.asm clears; song:
    197 U00a9							; == main.asm and things.asm)
    198 U00a9		       00	   mode       ds	1	; 0 MUSIC, 1 SOUND FX, 2 SILENT
    199 U00aa		       00	   smode      ds	1	; the mode the player last saw ($FF:
    200 U00ab							; a song to start)
    201 U00ab		       00	   song       ds	1	; 2 x the song (main.asm,
    202 U00ac							; things.asm choose it)
    203 U00ac		       00	   sfxreq     ds	1	; effect asked for (0: none)
    204 U00ad		       00	   sfxi       ds	1	; effect playing: its frame, 0 none
    205 U00ae		       00	   mclock     ds	1	; frames left in this step
    206 U00af		       00	   mstep      ds	1	; index in STEPLEN
    207 U00b0		       00 00	   vpos       ds	2	; each voice: offset in its stream,
    208 U00b2		       00 00	   vleft      ds	2	; steps left of its note,
    209 U00b4		       00 00	   venv       ds	2	; frame of the note (envelope),
    210 U00b6		       00 00	   vins       ds	2	; instrument,
    211 U00b8		       00 00	   vnote      ds	2	; note (0: a rest)
    212 U00ba							; == the seam of player 1 (main.asm prepares;
    213 U00ba							; == room_kernel.asm)
    214 U00ba		       00	   zcnt       ds	1	; courses to the seam (0: none)
    215 U00bb		       00	   zcoarse    ds	1	; the delay before RESP1 there
    216 U00bc		       00	   zref       ds	1	; REFP1 below the seam
    217 U00bd		       00 00	   s2gfx      ds	2	; player 1 below the seam: graphics,
    218 U00bf		       00 00	   s2col      ds	2	; colours
    219 U00c1							; == GAME OVER, VICTORY (things.asm sets them, main.asm
    220 U00c1							; == counts)
    221 U00c1		       00	   over       ds	1	; 0 playing, else 1 + frames since
    222 U00c2							; it began, up to GO_FRAMES
    223 U00c2		       00	   won	      ds	1	; the same for VICTORY, up to
    224 U00c3							; VIC_FRAMES
    225 U00c3							; == the kernels (main.asm prepares; room_kernel.asm)
    226 U00c3		       00 00	   kgfx       ds	2	; Sir Roderick: graphics, colours
    227 U00c5		       00 00	   kcol       ds	2
    228 U00c7		       00 00	   sgfx       ds	2	; player 1: graphics, colours
    229 U00c9		       00 00	   scol       ds	2
    230 U00cb		       00 00	   cbk	      ds	2	; room colours: COLUBK, COLUPF
    231 U00cd		       00 00	   cpf	      ds	2
    232 U00cf		       00	   zbk	      ds	1	; COLUBK of the next line A
    233 U00d0		       00	   zt	      ds	1	; colour for Y at the end of a line
    234 U00d1		       00	   zc1	      ds	1	; COLUP1 of the next line B
    235 U00d2		       00	   idx	      ds	1	; index of the line being prepared
    236 U00d3		       00	   trow       ds	1	; Superchip index of the next course
    237 U00d4		       00	   znpf0      ds	1	; PF0, PF1, PF2 of the next course
    238 U00d5		       00	   znpf1      ds	1
    239 U00d6		       00	   znpf2      ds	1
    240 U00d7							; == the HUD (main.asm prepares; hud.asm)
    241 U00d7		       00 00 00 00*dig	      ds	12	; the six columns of digits
    242 U00e3		       00 00 00 00*txp	      ds	12	; and of the name of the level
    243 U00ef		       00	   zt2	      ds	1
    244 U00f0		       00	   bar1       ds	1	; energy bar: PF1, PF2
    245 U00f1		       00	   bar2       ds	1
    246 U00f2							; == scratch (anyone; never kept across a call; the room
    247 U00f2							; == kernel keeps a value of the seam in tmp)
    248 U00f2		       00 00	   tmp	      ds	2
    249 U00f4				   ram_end
    250 U00f4
    251 U00f4							; ---------------------------------------------------------
    252 U00f4							; the banks
    253 U00f4
    254 U00f4					      MAC	bank
    255 U00f4					      SEG	bank{1}
    256 U00f4					      ORG	{1}*$1000
    257 U00f4					      RORG	$1000+{1}*$2000
    258 U00f4					      ds	256, 0	; the Superchip window
    259 U00f4					      ENDM		; {1}: bank number
    260 U00f4
    261 U00f4					      MAC	tail
    262 U00f4					      ORG	{1}*$1000+$FAA
    263 U00f4					      RORG	$1FAA+{1}*$2000
    264 U00f4					      sta	F4B6	; $FAA: to the end screens
    265 U00f4					      jmp	ends_kernel
    266 U00f4					      sta	F4B2	; $FB0: to the throne kernel
    267 U00f4					      jmp	throne_kernel
    268 U00f4					      sta	F4B4	; $FB6: (jsr here) bank 4
    269 U00f4					      jsr	things	; $FB9: in bank 4
    270 U00f4					      sta	F4B7	; $FBC: bank 7 again
    271 U00f4					      rts		; $FBF: in bank 7
    272 U00f4					      sta	F4B0	; $FC0: to the room kernel
    273 U00f4					      jmp	room_kernel
    274 U00f4					      sta	F4B1	; $FC6: to the title kernel
    275 U00f4					      jmp	title_kernel
