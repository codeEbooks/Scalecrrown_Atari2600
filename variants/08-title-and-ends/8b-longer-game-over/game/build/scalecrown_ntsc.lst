------- FILE scalecrown.asm
------- FILE knight.asm LEVEL 2 PASS 2
      0  75de					      include	"knight.asm"
      1  75de							; knight.asm - bank 7: Sir Roderick
      2  75de							;
      3  75de							; One frame of his: while he parries the venom with his
      4  75de							; shield (things.asm starts it) he stands still and shows
      5  75de							; the parry;
      6  75de							; the button starts a thrust of the sword, during which he
      7  75de							; stands still; otherwise the joystick moves him, first
      8  75de							; left or right, then up or down, each direction tried on
      9  75de							; its own against the walls (so he slides along a wall
     10  75de							; when pushed diagonally into it). Past the edge of the
     11  75de							; screen he goes into the next room: east and west
     12  75de							; through the openings, down and up by the stairs.
     13  75de							; The speeds are in bank7.asm, one table for each
     14  75de							; television (rules.py).
     15  75de
     16  75de				  -	      IF	V_INT != 0
     17  75de				  -	      ERR		; one step at most per frame
     18  75de					      ENDIF
     19  75de				  -	      IF	STRIDE != 8
     20  75de				  -	      ERR		; the walk divides by 8
     21  75de					      ENDIF
     22  75de
