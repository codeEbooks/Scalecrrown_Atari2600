    197  76e5							; box_free: carry clear if Sir Roderick fits at column nx,
    198  76e5							; top line ny: no block under his 8 x 24 box is stone. The
    199  76e5							; box touches block columns (nx + 3) / 8 and (nx + 10) / 8,
    200  76e5							; block rows ny / 16, (ny + 12) / 16 and (ny + 23) / 16
    201  76e5							; (24 lines can touch three rows of 16, never four).
    202  76e5
    203  76e5				   box_free
    204  76e5		       a5 a4		      lda	nx
    205  76e7		       18		      clc
    206  76e8		       69 03		      adc	#FIRST_PIXEL
    207  76ea		       4a		      lsr
    208  76eb		       4a		      lsr
    209  76ec		       4a		      lsr
    210  76ed		       85 a6		      sta	bc0	; left edge
    211  76ef		       a5 a4		      lda	nx
    212  76f1		       18		      clc
    213  76f2		       69 0a		      adc	#FIRST_PIXEL+KNIGHT_W-1
    214  76f4		       4a		      lsr
    215  76f5		       4a		      lsr
    216  76f6		       4a		      lsr
    217  76f7		       85 a7		      sta	bc1	; right edge
    218  76f9		       a5 a5		      lda	ny
    219  76fb		       20 0f f7 	      jsr	bf_row	; top line
    220  76fe		       b0 2b		      bcs	bf_done
    221  7700		       a5 a5		      lda	ny
    222  7702		       18		      clc
    223  7703		       69 0c		      adc	#KNIGHT_H/2
    224  7705		       20 0f f7 	      jsr	bf_row	; middle
    225  7708		       b0 21		      bcs	bf_done
    226  770a		       a5 a5		      lda	ny
    227  770c		       18		      clc
    228  770d		       69 17		      adc	#KNIGHT_H-1	; bottom line, and back
    229  770f		       4a	   bf_row     lsr		; A: a line of the box
    230  7710		       4a		      lsr
    231  7711		       4a		      lsr
    232  7712		       4a		      lsr		; its block row (0-9)
    233  7713		       85 a8		      sta	br
    234  7715		       0a		      asl		; (clears the carry)
    235  7716		       65 a8		      adc	br
    236  7718		       85 a8		      sta	br	; 3 x the row: its byte 0
    237  771a		       a5 a6		      lda	bc0
    238  771c		       20 2c f7 	      jsr	wall
    239  771f		       d0 09		      bne	bf_stone
    240  7721		       a5 a7		      lda	bc1
    241  7723		       20 2c f7 	      jsr	wall
    242  7726		       d0 02		      bne	bf_stone
    243  7728		       18		      clc		; free
    244  7729		       60		      rts
    245  772a				   bf_stone
    246  772a		       38		      sec
    247  772b				   bf_done
    248  772b		       60		      rts
    249  772c
    250  772c							; wall: Z clear (bne) if block column A (0-19) is stone in
    251  772c							; the block row whose first byte is br. The collision map
    252  772c							; has three bytes a row, the whole width (the plug closes
    253  772c							; one side only): columns 0-7 in the first byte, 8-15 in
    254  772c							; the second, 16-19 in the third, the first column in
    255  772c							; bit 7.
    256  772c		       aa	   wall       tax		; the column
    257  772d		       4a		      lsr
    258  772e		       4a		      lsr
    259  772f		       4a		      lsr		; its byte in the row, 0-2
    260  7730		       18		      clc
    261  7731		       65 a8		      adc	br
    262  7733		       a8		      tay
    263  7734		       8a		      txa
    264  7735		       29 07		      and	#7	; its bit
    265  7737		       aa		      tax
    266  7738		       b1 a2		      lda	(cmap),y
    267  773a		       3d 3e f7 	      and	BITS,x
    268  773d		       60		      rts
    269  773e
    270  773e		       80 40 20 10*BITS       .byte.b	$80, $40, $20, $10, $08, $04, $02, $01
    271  7746
    272  7746							; ---------------------------------------------------------
    273  7746							; blade: where missile 0 goes. In the thrust it is 8 pixels
    274  7746							; beside the hand: right of the figure facing right, left
    275  7746							; of it facing left; near the edge of the screen 4, 2 or 1
    276  7746							; (NUSIZ0 bits 4-5). Otherwise it is hidden: RESMP0 = 2
    277  7746							; keeps it on player 0, switched off.
    278  7746
    279  7746				   blade
    280  7746		       a9 02		      lda	#2
    281  7748		       85 96		      sta	swres	; hidden
    282  774a		       a5 8d		      lda	kpose
    283  774c		       c9 03		      cmp	#THRUST_POSE
    284  774e		       d0 41		      bne	bl_done
    285  7750		       a2 03		      ldx	#3	; width: 8 pixels
    286  7752		       a5 8c		      lda	kdir
    287  7754		       d0 1a		      bne	bl_left
    288  7756		       a5 8a		      lda	kx	; first pixel right of him
    289  7758		       18		      clc
    290  7759		       69 0b		      adc	#FIRST_PIXEL+KNIGHT_W
    291  775b		       c9 a0		      cmp	#160
    292  775d		       b0 32		      bcs	bl_done	; no room at all: hidden
    293  775f		       c9 99		      cmp	#160-7
    294  7761		       90 1c		      bcc	bl_set	; 8 pixels
    295  7763		       ca		      dex
    296  7764		       c9 9d		      cmp	#160-3
    297  7766		       90 17		      bcc	bl_set	; 4
    298  7768		       ca		      dex
    299  7769		       c9 9f		      cmp	#160-1
    300  776b		       90 12		      bcc	bl_set	; 2
    301  776d		       ca		      dex		; 1
    302  776e		       b0 0f		      bcs	bl_set
    303  7770				   bl_left		; it ends at pixel kx + 2
    304  7770		       a5 8a		      lda	kx
    305  7772		       38		      sec
    306  7773		       e9 05		      sbc	#KNIGHT_W-FIRST_PIXEL
    307  7775		       b0 08		      bcs	bl_set	; 8 pixels from kx - 5
    308  7777		       ca		      dex
    309  7778		       69 04		      adc	#4	; kx - 1 (carry clear)
    310  777a		       b0 03		      bcs	bl_set	; 4 pixels, if kx >= 1
    311  777c		       ca		      dex
    312  777d		       a9 01		      lda	#1	; kx = 0: 2 pixels, 1 and 2
    313  777f				   bl_set		; A: first pixel, X: width
    314  777f		       38		      sec
    315  7780		       e9 02		      sbc	#M_OFFSET	; the column that puts it
    316  7782		       b0 02		      bcs	bl_col	; there
    317  7784		       69 a0		      adc	#160	; (round the screen)
    318  7786		       85 94	   bl_col     sta	swx
    319  7788		       bd 92 f7 	      lda	BLADE_NUS,x
    320  778b		       85 95		      sta	swnus
    321  778d		       a9 00		      lda	#0
    322  778f		       85 96		      sta	swres	; shown
    323  7791				   bl_done
    324  7791		       60		      rts
    325  7792
    326  7792		       00 10 20 30 BLADE_NUS  .byte.b	$00, $10, $20, $30	; 1, 2, 4, 8 pixels
------- FILE scalecrown.asm
------- FILE hud.asm LEVEL 2 PASS 2
      0  7796					      include	"hud.asm"
      1  7796							; hud.asm - bank 7: the HUD, 32 lines above the room
      2  7796							;
      3  7796							; Entered right after the WSYNC that ends the VBLANK, at
      4  7796							; cycle 3 of the first visible line. Draws TOP_BLANK black
      5  7796							; lines (PAL only), then the HUD:
      6  7796							;   lines 1-9	  the six digits of the score
      7  7796							;   lines 12-15  the energy bar
      8  7796							;   lines 17-25  LEVEL n
      9  7796							;   lines 26-28  Sir Roderick and player 1 to their columns
     10  7796							;		  (player 1: the thing of band A; the fine
     11  7796							;		  move of the seam waits in HMP1)
     12  7796							; and goes on to bank 0 (room_kernel.asm) in line 28, or to
     13  7796							; bank 2 (throne_kernel.asm) in the throne room.
     14  7796							;
     15  7796							; Cycle counts in the comments: the cycle at which a store
     16  7796							; writes, counted from 0 at the start of the line.
     17  7796
     18  7796				   hud
     19  7796		       a9 00		      lda	#0
     20  7798		       85 01		      sta	VBLANK	; the picture starts
     21  779a					      IF	TOP_BLANK
     22  779a		       a0 12		      ldy	#TOP_BLANK
     23  779c		       85 02	   hu_top     sta	WSYNC
     24  779e		       88		      dey
     25  779f		       d0 fb		      bne	hu_top
     26  77a1					      ENDIF
     27  77a1		       a9 2c		      lda	#SCORE_COL	; HUD line 0
     28  77a3		       85 06		      sta	COLUP0
     29  77a5		       85 07		      sta	COLUP1
     30  77a7		       85 02		      sta	WSYNC
     31  77a9		       20 3c f8 	      jsr	hud_digits	; lines 1-9: the six digits
     32  77ac		       85 02		      sta	WSYNC	; line 10
     33  77ae		       a9 00		      lda	#0
     34  77b0		       85 1b		      sta	GRP0
     35  77b2		       85 1c		      sta	GRP1
     36  77b4		       85 1b		      sta	GRP0	; empty the delayed copies
     37  77b6		       a0 03		      ldy	#3
     38  77b8		       85 02		      sta	WSYNC	; line 11
     39  77ba		       85 02		      sta	WSYNC	; line 12
     40  77bc				   hu_bar		; lines 12-15: energy
     41  77bc		       b9 d6 f9 	      lda	BAR_COL,y
     42  77bf		       85 08		      sta	COLUPF	;  6
     43  77c1		       a5 f0		      lda	bar1
     44  77c3		       85 0e		      sta	PF1	; 12
     45  77c5		       a5 f1		      lda	bar2
     46  77c7		       85 0f		      sta	PF2	; 18
     47  77c9		       85 02		      sta	WSYNC
     48  77cb		       88		      dey
     49  77cc		       10 ee		      bpl	hu_bar
     50  77ce		       a9 00		      lda	#0	; line 16
     51  77d0		       85 0e		      sta	PF1
     52  77d2		       85 0f		      sta	PF2
     53  77d4		       85 08		      sta	COLUPF	; the room's PF2 unseen
     54  77d6		       a9 0c		      lda	#TEXT_COL
     55  77d8		       85 06		      sta	COLUP0
     56  77da		       85 07		      sta	COLUP1
     57  77dc		       85 02		      sta	WSYNC
     58  77de		       20 6a f8 	      jsr	hud_text	; lines 17-25: LEVEL n
     59  77e1		       a5 8a		      lda	kx
     60  77e3		       85 02		      sta	WSYNC	; (the end of line 25)
     61  77e5							; line 26: Sir Roderick to column kx, as place does
     62  77e5							; it (the stores take 4 cycles, like sta HMP0,x)
     63  77e5		       38		      sec
     64  77e6		       e9 0f	   hu_p0      sbc	#15
     65  77e8		       b0 fc		      bcs	hu_p0	; (hu_p0)
     66  77ea		       49 07		      eor	#7
     67  77ec		       0a		      asl
     68  77ed		       0a		      asl
     69  77ee		       0a		      asl
     70  77ef		       0a		      asl
     71  77f0		       8d 20 00 	      sta.w	HMP0
     72  77f3		       8d 10 00 	      sta.w	RESP0	; 68 at most (kx <= 149)
     73  77f6		       a5 97		      lda	ox
     74  77f8		       85 02		      sta	WSYNC	; 73 at most
     75  77fa							; line 27: player 1 to column ox
     76  77fa		       38		      sec
     77  77fb		       e9 0f	   hu_p1      sbc	#15
     78  77fd		       b0 fc		      bcs	hu_p1	; (hu_p1)
     79  77ff		       49 07		      eor	#7
     80  7801		       0a		      asl
     81  7802		       0a		      asl
     82  7803		       0a		      asl
     83  7804		       0a		      asl
     84  7805		       8d 21 00 	      sta.w	HMP1
     85  7808		       8d 11 00 	      sta.w	RESP1
     86  780b		       85 02		      sta	WSYNC
     87  780d							; line 28: the fine moves, the room's settings
     88  780d		       85 2a		      sta	HMOVE	;  2
     89  780f		       a5 8c		      lda	kdir
     90  7811		       85 0b		      sta	REFP0
     91  7813		       a5 99		      lda	odir
     92  7815		       85 0c		      sta	REFP1
     93  7817		       a9 00		      lda	#0
     94  7819		       85 25		      sta	VDELP0
     95  781b		       85 26		      sta	VDELP1
     96  781d		       85 06		      sta	COLUP0
     97  781f		       85 07		      sta	COLUP1
     98  7821		       a5 95		      lda	swnus
     99  7823		       85 04		      sta	NUSIZ0	; the width of the blade
    100  7825		       a5 9b		      lda	onus
    101  7827		       85 05		      sta	NUSIZ1
    102  7829		       85 2b		      sta	HMCLR	; 43: 41 cycles after HMOVE
    103  782b		       ad c2 10 	      lda	SCR+SC_HM	; the fine move of the seam
    104  782e		       85 21		      sta	HMP1	; (its HMOVE uses it)
    105  7830		       a5 85		      lda	room	; the throne room has its
    106  7832		       c9 0f		      cmp	#THRONE_ROOM	; own kernel
    107  7834		       f0 03		      beq	hu_throne
    108  7836		       4c c0 1f 	      jmp	TO_ROOM	; bank 0
    109  7839				   hu_throne
    110  7839		       4c b0 1f 	      jmp	TO_THRONE	; bank 2
    111  783c
    112  783c							; HUD48: 8 lines of 48 pixels, Y = 7 down to 0, the six
    113  783c							; columns read through six pointers: {1} ... {1}+10 (dig:
    114  783c							; the digits of the score; txp: the name of the level, in
    115  783c							; this bank). Called on the line before the first one.
    116  783c							; Both players are delayed (VDELP0, VDELP1) and have three
    117  783c							; copies 16 pixels apart:
    118  783c							; player 0 shows columns 1, 3, 5, player 1 columns 2, 4, 6.
    119  783c							; A delayed player shows the value written before the last
    120  783c							; write to the other player, so the four writes at the end
    121  783c							; change the copies on the right while the beam is between
    122  783c							; them.
    123  783c					      MAC	hud48
    124  783c					      ldy	#7
    125  783c					      sty	zt2
    126  783c				   .loop      lda	({1}),y
    127  783c					      sta	GRP0	; column 1 (waits)
    128  783c					      sta	WSYNC
    129  783c					      lda	({1}+2),y
    130  783c					      sta	GRP1	;  7 col 2; col 1 shows
    131  783c					      lda	({1}+4),y
    132  783c					      sta	GRP0	; 15 col 3; col 2 shows
    133  783c					      lda	({1}+10),y
    134  783c					      sta	zt
    135  783c					      lda	({1}+8),y
    136  783c					      tax
    137  783c					      lda	({1}+6),y
    138  783c					      ldy	zt
    139  783c					      nop
    140  783c					      sta	GRP1	; 43 col 4; col 3 shows
    141  783c					      stx	GRP0	; 46 col 5; col 4 shows
    142  783c					      sty	GRP1	; 49 col 6; col 5 shows
    143  783c					      sta	GRP0	; 52 col 6 shows
    144  783c					      ldy	zt2
    145  783c					      dey
    146  783c					      sty	zt2
    147  783c					      bpl	.loop
    148  783c					      rts
    149  783c					      ENDM
    150  783c
    151  783c							; each routine in one page (as the blocks of the title: see
    152  783c							; title_kernel.asm); the padding comes after a jmp or an rts
    153  783c		       00 32	   HUD48_BYTES =	50
    154  783c
    155  783c				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    156  783c				  -	      ALIGN	256
    157  783c					      ENDIF
    158  783c				   hud_digits
      0  783c					      HUD48	dig
      1  783c		       a0 07		      ldy	#7
      2  783e		       84 ef		      sty	zt2
      3  7840		       b1 d7	   .loop      lda	(dig),y
      4  7842		       85 1b		      sta	GRP0
      5  7844		       85 02		      sta	WSYNC
      6  7846		       b1 d9		      lda	(dig+2),y
      7  7848		       85 1c		      sta	GRP1
      8  784a		       b1 db		      lda	(dig+4),y
      9  784c		       85 1b		      sta	GRP0
     10  784e		       b1 e1		      lda	(dig+10),y
     11  7850		       85 d0		      sta	zt
     12  7852		       b1 df		      lda	(dig+8),y
     13  7854		       aa		      tax
     14  7855		       b1 dd		      lda	(dig+6),y
     15  7857		       a4 d0		      ldy	zt
     16  7859		       ea		      nop
     17  785a		       85 1c		      sta	GRP1
     18  785c		       86 1b		      stx	GRP0
     19  785e		       84 1c		      sty	GRP1
     20  7860		       85 1b		      sta	GRP0
     21  7862		       a4 ef		      ldy	zt2
     22  7864		       88		      dey
     23  7865		       84 ef		      sty	zt2
     24  7867		       10 d7		      bpl	.loop
     25  7869		       60		      rts
    160  786a				  -	      IF	(* & $FF00) != ((*+HUD48_BYTES) & $FF00)
    161  786a				  -	      ALIGN	256
    162  786a					      ENDIF
    163  786a				   hud_text
      0  786a					      HUD48	txp
      1  786a		       a0 07		      ldy	#7
      2  786c		       84 ef		      sty	zt2
      3  786e		       b1 e3	   .loop      lda	(txp),y
      4  7870		       85 1b		      sta	GRP0
      5  7872		       85 02		      sta	WSYNC
      6  7874		       b1 e5		      lda	(txp+2),y
      7  7876		       85 1c		      sta	GRP1
      8  7878		       b1 e7		      lda	(txp+4),y
      9  787a		       85 1b		      sta	GRP0
     10  787c		       b1 ed		      lda	(txp+10),y
     11  787e		       85 d0		      sta	zt
     12  7880		       b1 eb		      lda	(txp+8),y
     13  7882		       aa		      tax
     14  7883		       b1 e9		      lda	(txp+6),y
     15  7885		       a4 d0		      ldy	zt
     16  7887		       ea		      nop
     17  7888		       85 1c		      sta	GRP1
     18  788a		       86 1b		      stx	GRP0
     19  788c		       84 1c		      sty	GRP1
     20  788e		       85 1b		      sta	GRP0
     21  7890		       a4 ef		      ldy	zt2
     22  7892		       88		      dey
     23  7893		       84 ef		      sty	zt2
     24  7895		       10 d7		      bpl	.loop
     25  7897		       60		      rts
