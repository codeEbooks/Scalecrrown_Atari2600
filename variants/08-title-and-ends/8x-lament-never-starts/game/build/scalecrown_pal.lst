     93  515e		       a5 ae		      lda	mclock
     94  5160		       d0 1e		      bne	mu_frame
     95  5162		       a6 af		      ldx	mstep	; a new step
     96  5164		       bd fe b3 	      lda	STEPLEN,x
     97  5167		       85 ae		      sta	mclock
     98  5169		       e8		      inx
     99  516a		       e0 02		      cpx	#STEPS_N
    100  516c		       90 02		      bcc	mu_step
    101  516e		       a2 00		      ldx	#0
    102  5170				   mu_step
    103  5170		       86 af		      stx	mstep
    104  5172		       a2 01		      ldx	#1
    105  5174				   mu_next
    106  5174		       b5 b2		      lda	vleft,x	; voice X: its note over,
    107  5176		       d0 03		      bne	mu_dec	; the next one
    108  5178		       20 b0 b1 	      jsr	fetch
    109  517b		       d6 b2	   mu_dec     dec	vleft,x	; steps left after this one
    110  517d		       ca		      dex
    111  517e		       10 f4		      bpl	mu_next
    112  5180				   mu_frame
    113  5180		       c6 ae		      dec	mclock	; 0: a step's last frame
    114  5182		       a2 01		      ldx	#1
    115  5184		       a9 00	   mu_vol     lda	#0
    116  5186		       b4 b8		      ldy	vnote,x
    117  5188		       f0 20		      beq	mu_set	; a rest
    118  518a		       b4 b2		      ldy	vleft,x
    119  518c		       d0 04		      bne	mu_on
    120  518e		       a4 ae		      ldy	mclock
    121  5190		       f0 18		      beq	mu_set	; the last frame of the note
    122  5192		       b4 b6	   mu_on      ldy	vins,x
    123  5194		       b5 b4		      lda	venv,x
    124  5196		       d9 02 b4 	      cmp	ENV_LAST,y	; the envelope goes on until
    125  5199		       b0 04		      bcs	mu_hold	; its last value
    126  519b		       f6 b4		      inc	venv,x
    127  519d		       90 03		      bcc	mu_read	; (inc leaves C clear)
    128  519f				   mu_hold
    129  519f		       b9 02 b4 	      lda	ENV_LAST,y
    130  51a2				   mu_read
    131  51a2		       18		      clc
    132  51a3		       79 00 b4 	      adc	ENV_START,y
    133  51a6		       a8		      tay
    134  51a7		       b9 04 b4 	      lda	ENV_DATA,y
    135  51aa		       95 19	   mu_set     sta	AUDV0,x
    136  51ac		       ca		      dex
    137  51ad		       10 d5		      bpl	mu_vol
    138  51af		       60		      rts
