     52  7898		       00 03	   THRUST_POSE =	3
     53  7898
     54  7898							; poses of the walk, a pose every STRIDE
     55  7898				   WALK
     56  7898		       01 00 02 00	      .byte.b	$01,$00,$02,$00
     57  789c							; player 1: the thing of band A closed and open, the
     58  789c							; bit that opens it, its top line and column; NUSIZ1
     59  789c				   OB_KIND0
     60  789c		       0a 00 00 00*	      .byte.b	$0A,$00,$00,$00,$0A,$00,$00,$00
     61  78a4		       00 00 00 0a*	      .byte.b	$00,$00,$00,$0A,$00,$0A,$0E,$00
     62  78ac				   OB_KIND1
     63  78ac		       0c 00 00 00*	      .byte.b	$0C,$00,$00,$00,$0C,$00,$00,$00
